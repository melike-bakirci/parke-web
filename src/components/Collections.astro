---
import productsRaw from "../data/products.json";

// Parke sayfasındaki sıralama ile aynı ilk 4 ürün
const products = [...productsRaw]
  .sort((a, b) => {
    const priceA = parseFloat(a.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    const priceB = parseFloat(b.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    return priceA - priceB;
  })
  .slice(0, 4);
---

<section class="collections" id="collections">
  <div class="container">
    <!-- Header Section -->
    <div class="collections-header">
      <div class="header-text">
        <h2>Parke Koleksiyonumuz</h2>
        <p>En çok tercih edilen parke modellerimiz</p>
      </div>
      <a href="/parke" class="btn-view-all">
        <span>Hepsini Göster</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- 4 Products Grid -->
    <div class="collections-grid">
      {
        products.map((product) => (
          <a href={`/parke/${product.id}`} class="product-card">
            <div class="product-img-wrapper">
              <img
                src={product.img}
                alt={product.name}
                class="primary-img"
                loading="lazy"
              />
              {product.images && product.images[1] && (
                <img
                  src={product.images[1]}
                  alt={`${product.name} - Ortam Görünümü`}
                  class="secondary-img"
                  loading="lazy"
                />
              )}
            </div>
            <div class="product-info">
              <h3>{product.name}</h3>
              <div class="product-desc">
                <span>{product.thickness}, {product.edge}, {product.color} Renk</span>
                <span>{product.surface}</span>
              </div>
              <div class="product-footer">
                <div class="price-box">
                  <span class="price-val">{product.price}</span>
                  <span class="price-unit">/ m²</span>
                </div>
                <span class="btn-review">
                  <span>İncele</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .collections {
    background-color: var(--color-light);
    padding: 90px 0 100px;
  }

  .collections-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-text {
    max-width: 680px;
  }

  .header-text h2 {
    font-size: 2.4rem;
    line-height: 1.25;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
  }

  .header-text p {
    color: #5a6872;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  /* Grid Layout for 4 items */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Product Card matching parke.astro */
  .product-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .product-card:hover {
    box-shadow: 0 8px 24px rgba(18, 52, 71, 0.09);
  }

  .product-img-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
    background-color: #eaeef1;
  }

  .product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease;
  }

  .product-img-wrapper .primary-img {
    position: relative;
    z-index: 1;
    opacity: 1;
  }

  .product-img-wrapper .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    opacity: 0;
  }

  .product-card:hover .secondary-img {
    opacity: 1;
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-info h3 {
    font-size: 1.15rem;
    font-family: var(--font-primary);
    color: var(--color-primary);
    margin-bottom: 0.6rem;
    line-height: 1.35;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }

  .product-desc {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.45;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-desc span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: inherit;
    font-size: inherit;
    font-weight: 400;
  }

  .product-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #edf2f7;
    gap: 0.75rem;
  }

  .price-box {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .price-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-primary);
  }

  .price-unit {
    font-size: 0.85rem;
    color: #718096;
    font-weight: 500;
  }

  .btn-review {
    background: transparent;
    color: var(--color-primary);
    padding: 4px 0;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    transition: color 0.25s ease;
  }

  .btn-review:hover {
    color: var(--color-secondary);
  }

  .btn-review svg {
    transition: transform 0.25s ease;
  }

  .btn-review:hover svg {
    transform: translateX(4px);
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 6px;
    background: #ffffff;
    border: 1.5px solid #d0dbe5;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .btn-view-all:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(18, 52, 71, 0.15);
  }

  .btn-view-all svg {
    transition: transform 0.25s ease;
  }

  .btn-view-all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .collections {
      padding: 60px 0 70px;
    }
    .header-text h2 {
      font-size: 1.85rem;
    }
    .product-img-wrapper {
      height: 200px;
    }
  }
</style>
