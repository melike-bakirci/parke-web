---
import productsRaw from "../data/products.json";
import ProductCard from "./ProductCard.astro";
import Icon from "./Icon.astro";

// Parke sayfasındaki sıralama ile aynı ilk 4 ürün
const products = [...productsRaw]
  .sort((a, b) => {
    const priceA = parseFloat(a.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    const priceB = parseFloat(b.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    return priceA - priceB;
  })
  .slice(0, 4);
---

<section class="collections" id="collections">
  <div class="container">
    <!-- Header Section -->
    <div class="collections-header">
      <div class="header-text">
        <h2>Parke Koleksiyonumuz</h2>
        <p>En çok tercih edilen parke modellerimiz</p>
      </div>
      <a href="/parke" class="btn-view-all">
        <span>Hepsini Göster</span>
        <Icon name="arrow-right" size={18} strokeWidth={2.2} />
      </a>
    </div>

    <!-- 4 Products Grid -->
    <div class="collections-grid">
      {
        products.map((product) => (
          <ProductCard product={product} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .collections {
    background-color: var(--color-light);
    padding: 90px 0 100px;
  }

  .collections-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-text {
    max-width: 680px;
  }

  .header-text h2 {
    font-size: 2.4rem;
    line-height: 1.25;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
  }

  .header-text p {
    color: #5a6872;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  /* Grid Layout for 4 items */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 6px;
    background: #ffffff;
    border: 1.5px solid #d0dbe5;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .btn-view-all:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(18, 52, 71, 0.15);
  }

  .btn-view-all svg {
    transition: transform 0.25s ease;
  }

  .btn-view-all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .collections {
      padding: 60px 0 70px;
    }
    .header-text h2 {
      font-size: 1.85rem;
    }
  }
</style>
