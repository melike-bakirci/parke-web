---
const products = [
  {
    id: 1,
    name: "Naturesville Meşe - Seri 110",
    category: "Masif Parke",
    price: "₺480",
    unit: "/ m²",
    desc: "Doğal açık meşe dokusu ve yüksek yüzey dayanımı ile evinizde ferah ve aydınlık bir atmosfer oluşturur.",
    img: "/images/collection-1.jpg",
    link: "/parke",
  },
  {
    id: 2,
    name: "Walnut Dark Koyu Ceviz - Seri 400",
    category: "Lamine Parke",
    price: "₺560",
    unit: "/ m²",
    desc: "Zengin ceviz tonları ve otantik ahşap damarlarıyla yaşam alanlarınıza asil ve sıcak bir dokunuş katar.",
    img: "/images/collection-2.jpg",
    link: "/parke",
  },
  {
    id: 3,
    name: "Nordic Ash Kül Grisi - Seri 220",
    category: "Masif Parke",
    price: "₺520",
    unit: "/ m²",
    desc: "Modern İskandinav tarzını yansıtan açık kül tonları, minimal ve modern iç mekanlar için idealdir.",
    img: "/images/about-1.jpg",
    link: "/parke",
  },
  {
    id: 4,
    name: "Vintage Rustic Çam - Seri 310",
    category: "Lamine Parke",
    price: "₺420",
    unit: "/ m²",
    desc: "Doğal budaklı rustik yapısı ve eskitme görünümü ile samimi ve sıcak yaşam alanları oluşturur.",
    img: "/images/about-2.jpg",
    link: "/parke",
  },
];
---

<section class="collections" id="collections">
  <div class="container">
    <!-- Header Section -->
    <div class="collections-header">
      <div class="header-text">
        <h2>Parke Koleksiyonumuz</h2>
        <p>En çok tercih edilen parke modellerimiz</p>
      </div>
    </div>

    <!-- 4 Products Grid -->
    <div class="collections-grid">
      {
        products.map((item) => (
          <div class="collection-card" data-id={item.id}>
            <div class="card-image-wrap">
              <img src={item.img} alt={item.name} loading="lazy" />
            </div>

            <div class="card-body">
              <h3 class="card-title" title={item.name}>
                {item.name}
              </h3>
              <p class="card-desc" title={item.desc}>
                {item.desc}
              </p>

              <div class="card-footer">
                <div class="price-box">
                  <span class="price-val">{item.price}</span>
                  <span class="price-unit">{item.unit}</span>
                </div>
                <a href={item.link} class="btn-review">
                  <span>İncele</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Hepsini Göster Button -->
    <div class="collections-action">
      <a href="/parke" class="btn-show-all">
        <span>Hepsini Göster</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .collections {
    background-color: var(--color-light);
    padding: 90px 0 100px;
  }

  .collections-header {
    margin-bottom: 2.5rem;
  }

  .header-text {
    max-width: 680px;
  }

  .header-text h2 {
    font-size: 2.4rem;
    line-height: 1.25;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
  }

  .header-text p {
    color: #5a6872;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  /* Grid Layout for 4 items */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Product Card */
  .collection-card {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .collection-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(18, 52, 71, 0.12);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background-color: #eaeef1;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .collection-card:hover .card-image-wrap img {
    transform: scale(1.06);
  }

  /* Card Body */
  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.1rem;
    font-family: var(--font-primary);
    color: var(--color-primary);
    margin-bottom: 0.6rem;
    line-height: 1.35;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-desc {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.45;
    margin-bottom: 1.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 2.9em;
  }

  /* Card Footer */
  .card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #edf2f7;
    gap: 0.75rem;
  }

  .price-box {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .price-val {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-primary);
  }

  .price-unit {
    font-size: 0.82rem;
    color: #718096;
    font-weight: 500;
  }

  .btn-review {
    background: transparent;
    color: var(--color-primary);
    padding: 4px 0;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    transition: color 0.25s ease;
  }

  .btn-review:hover {
    color: var(--color-secondary);
  }

  .btn-review svg {
    transition: transform 0.25s ease;
  }

  .btn-review:hover svg {
    transform: translateX(4px);
  }

  /* Bottom Action / Hepsini Göster Button */
  .collections-action {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .btn-show-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-primary);
    color: #ffffff;
    padding: 14px 34px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.98rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(18, 52, 71, 0.15);
  }

  .btn-show-all:hover {
    background: #0b2230;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(18, 52, 71, 0.25);
  }

  .btn-show-all svg {
    transition: transform 0.25s ease;
  }

  .btn-show-all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .collections {
      padding: 60px 0 70px;
    }
    .header-text h2 {
      font-size: 1.85rem;
    }
    .card-image-wrap {
      height: 200px;
    }
  }
</style>
