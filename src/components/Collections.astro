---
import productsRaw from "../data/products.json";
import ProductCard from "./ProductCard.astro";
import Icon from "./Icon.astro";

// Parke sayfasındaki sıralama ile aynı ilk 4 ürün
const products = [...productsRaw]
  .sort((a, b) => {
    const priceA =
      parseFloat(a.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    const priceB =
      parseFloat(b.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
    return priceA - priceB;
  })
  .slice(0, 4);
---

<section class="collections" id="collections">
  <div class="container">
    <!-- Header Section -->
    <div class="collections-header">
      <div class="header-text">
        <span class="section-tag">Koleksiyon</span>
        <h2>Çamsan Parke Koleksiyonumuz</h2>
        <p>En çok tercih edilen parke modelleri</p>
      </div>
      <a href="/parke" class="btn-view-all">
        <span>Tümü</span>
        <Icon name="arrow-right" size={18} strokeWidth={2.2} />
      </a>
    </div>

    <!-- 4 Products Grid -->
    <div class="collections-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>

<style>
  .collections {
    background-color: var(--color-light);
    padding: 90px 0 100px;
  }

  .collections-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-text {
    max-width: 680px;
  }

  .section-tag {
    display: inline-block;
    color: var(--color-primary);
    background: var(--color-secondary-light);
    border: 1px solid var(--color-border);
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .header-text h2 {
    font-size: 2.4rem;
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .header-text p {
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: 1.05rem;
  }

  /* Grid Layout for 4 items */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 400px) {
    .collections-grid {
      gap: 16px;
    }
  }

  @media (min-width: 640px) {
    .collections-grid {
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .btn-view-all:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-view-all svg {
    transition: transform 0.25s var(--ease-out);
  }

  .btn-view-all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .collections {
      padding: 60px 0 70px;
    }
    .collections-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .header-text h2 {
      font-size: 1.85rem;
    }
    .btn-view-all {
      width: 100%;
      justify-content: center;
    }
  }
</style>
