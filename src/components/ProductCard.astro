---
export interface Product {
  id: string;
  name: string;
  series?: string;
  color?: string;
  thickness?: string;
  edge?: string;
  width?: string;
  length?: string;
  surface?: string;
  package?: string;
  pallet?: string;
  price: string;
  img: string;
  images?: string[];
}

interface Props {
  product: Product;
  isInitiallyVisible?: boolean;
  class?: string;
}

const { product, isInitiallyVisible = true, class: className = "" } = Astro.props;

const numericPrice =
  parseFloat(product.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;

const secondaryImagePath = product.images && product.images[1] ? product.images[1] : null;
---

<a
  href={`/parke/${product.id}`}
  class={`product-card ${className}`.trim()}
  data-name={product.name}
  data-desc={product.surface}
  data-category={product.series}
  data-color={product.color}
  data-edge={product.edge}
  data-thickness={product.thickness}
  data-price={numericPrice}
  style={isInitiallyVisible ? "display: flex;" : "display: none;"}
>
  <div class="product-img-wrapper">
    <img
      src={product.img}
      alt={`${product.name} parke modeli`}
      class="primary-img"
      width={600}
      height={400}
      loading="lazy"
      decoding="async"
    />
    {secondaryImagePath && (
      <img
        src={secondaryImagePath}
        alt={`${product.name} - Ortam Görünümü`}
        class="secondary-img"
        width={600}
        height={400}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="product-info">
    <h3>{product.name}</h3>
    <div class="product-desc">
      <span>{product.thickness}, {product.edge}, {product.color} Renk</span>
      <span>{product.surface}</span>
    </div>
    <div class="product-footer">
      <div class="price-box">
        <span class="price-val">{product.price}</span>
        <span class="price-unit">/ m²</span>
      </div>
    </div>
  </div>
</a>

<style>
  .product-card {
    background: #fff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-secondary);
  }

  .product-img-wrapper {
    position: relative;
    height: 160px;
    overflow: hidden;
    background-color: var(--color-light);
  }

  @media (min-width: 400px) {
    .product-img-wrapper {
      height: 185px;
    }
  }

  @media (min-width: 640px) {
    .product-img-wrapper {
      height: 220px;
    }
  }

  .product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .product-img-wrapper .primary-img {
    position: relative;
    z-index: 1;
    opacity: 1;
    transform: scale(1);
  }

  .product-img-wrapper .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    opacity: 0;
    transform: scale(1.01);
  }

  .product-card:hover .secondary-img {
    opacity: 1;
    transform: scale(1.05);
  }

  .product-card:hover .primary-img {
    transform: scale(1.05);
  }

  .product-info {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 400px) {
    .product-info {
      padding: 1rem;
    }
  }

  @media (min-width: 640px) {
    .product-info {
      padding: 1.5rem;
    }
  }

  .product-info h3 {
    font-size: 0.9rem;
    font-family: var(--font-primary);
    color: var(--color-primary);
    margin-bottom: 0.3rem;
    line-height: 1.3;
    font-weight: 700;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (min-width: 400px) {
    .product-info h3 {
      font-size: 1rem;
      margin-bottom: 0.4rem;
    }
  }

  @media (min-width: 640px) {
    .product-info h3 {
      font-size: 1.15rem;
    }
  }

  .product-desc {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.4;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 640px) {
    .product-desc {
      font-size: 0.88rem;
      margin-bottom: 1.25rem;
    }
  }

  .product-desc span {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    color: inherit;
    font-size: inherit;
    font-weight: 400;
  }

  .product-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #edf2f7;
    gap: 0.75rem;
  }

  .price-box {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .price-val {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-primary);
  }

  @media (min-width: 400px) {
    .price-val {
      font-size: 1.1rem;
    }
  }

  @media (min-width: 640px) {
    .price-val {
      font-size: 1.25rem;
    }
  }

  .price-unit {
    font-size: 0.85rem;
    color: #718096;
    font-weight: 500;
  }

</style>
