---
import Icon from "./Icon.astro";

export interface Product {
  id: string;
  name: string;
  series?: string;
  color?: string;
  thickness?: string;
  edge?: string;
  width?: string;
  length?: string;
  surface?: string;
  package?: string;
  pallet?: string;
  price: string;
  img: string;
  images?: string[];
}

interface Props {
  product: Product;
  isInitiallyVisible?: boolean;
  class?: string;
}

const { product, isInitiallyVisible = true, class: className = "" } = Astro.props;

const numericPrice =
  parseFloat(product.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
---

<a
  href={`/parke/${product.id}`}
  class={`product-card ${className}`.trim()}
  data-name={product.name}
  data-desc={product.surface}
  data-category={product.series}
  data-color={product.color}
  data-edge={product.edge}
  data-thickness={product.thickness}
  data-price={numericPrice}
  style={isInitiallyVisible ? "display: flex;" : "display: none;"}
>
  <div class="product-img-wrapper">
    <img
      src={product.img}
      alt={product.name}
      class="primary-img"
      loading="lazy"
    />
    {
      product.images && product.images[1] && (
        <img
          src={product.images[1]}
          alt={`${product.name} - Ortam Görünümü`}
          class="secondary-img"
          loading="lazy"
        />
      )
    }
  </div>
  <div class="product-info">
    <h3>{product.name}</h3>
    <div class="product-desc">
      <span>{product.thickness}, {product.edge}, {product.color} Renk</span>
      <span>{product.surface}</span>
    </div>
    <div class="product-footer">
      <div class="price-box">
        <span class="price-val">{product.price}</span>
        <span class="price-unit">/ m²</span>
      </div>
      <span class="btn-review">
        <span>İncele</span>
        <Icon name="arrow-right" size={16} strokeWidth={2.5} />
      </span>
    </div>
  </div>
</a>

<style>
  .product-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .product-card:hover {
    box-shadow: 0 8px 24px rgba(18, 52, 71, 0.09);
  }

  .product-img-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
    background-color: #eaeef1;
  }

  .product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease;
  }

  .product-img-wrapper .primary-img {
    position: relative;
    z-index: 1;
    opacity: 1;
  }

  .product-img-wrapper .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    opacity: 0;
  }

  .product-card:hover .secondary-img {
    opacity: 1;
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-info h3 {
    font-size: 1.15rem;
    font-family: var(--font-primary);
    color: var(--color-primary);
    margin-bottom: 0.6rem;
    line-height: 1.35;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }

  .product-desc {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.45;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-desc span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: inherit;
    font-size: inherit;
    font-weight: 400;
  }

  .product-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #edf2f7;
    gap: 0.75rem;
  }

  .price-box {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .price-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-primary);
  }

  .price-unit {
    font-size: 0.85rem;
    color: #718096;
    font-weight: 500;
  }

  .btn-review {
    background: transparent;
    color: var(--color-primary);
    padding: 4px 0;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    transition: color 0.25s ease;
  }

  .btn-review:hover {
    color: var(--color-secondary);
  }

  .btn-review svg {
    transition: transform 0.25s ease;
  }

  .btn-review:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .product-img-wrapper {
      height: 200px;
    }
  }
</style>
