<section class="hero">
  <div class="hero-bg">
    <img src="/images/hero-bg.webp" alt="Evinize ve ofisinize değer katan en uygun fiyatlı laminat parke modelleri" fetchpriority="high" />
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-text">
      <span class="hero-eyebrow">Laminat Parke Uzmanı</span>
      <h1>Ev, Ofis ve Mekanlarınıza Değer Katan <br />Parke Modellerimiz</h1>
      <p class="hero-subtitle">20 yıllık tecrübemizle Türkiye'nin dört bir yanına kaliteli ve uygun fiyatlı zemin çözümleri sunuyoruz.</p>
      <div class="hero-actions">
        <a href="/parke" class="btn-outline-hero">
          <span>Ürünleri İncele</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/iletisim" class="btn-white cta-btn">Bize Ulaşın</a>
      </div>
    </div>
  </div>
  <a href="#about" class="scroll-indicator" aria-label="Aşağı kaydır">
    <span class="scroll-text">Keşfet</span>
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    animation: heroZoomIn 14s ease-out infinite alternate;
    transform-origin: center center;
    will-change: transform;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes heroZoomIn {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(30, 22, 18, 0.35) 0%, rgba(62, 46, 37, 0.72) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 0 auto;
    width: 100%;
  }
  .hero-text {
    text-align: center;
    color: #fff;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: heroFadeUp 0.8s var(--ease-out) both;
  }
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-secondary);
    background: rgba(200, 169, 110, 0.15);
    border: 1px solid rgba(200, 169, 110, 0.35);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(4px);
  }
  .hero-text h1 {
    color: #fff;
    font-size: 2.85rem;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
    font-family: var(--font-primary);
    text-align: center;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-outline-hero {
    padding: 13px 26px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-sm);
    backdrop-filter: blur(10px);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s var(--ease-out);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }
  .btn-outline-hero:hover {
    background: #ffffff;
    color: var(--color-primary);
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }
  .btn-outline-hero svg {
    transition: transform 0.3s var(--ease-out);
  }
  .btn-outline-hero:hover svg {
    transform: translateX(4px);
  }
  .cta-btn {
    padding: 13px 26px;
    font-size: 0.95rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    text-decoration: none;
    display: inline-flex;
    border-radius: var(--radius-sm);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  .scroll-indicator:hover {
    color: #fff;
  }
  .scroll-text {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, currentColor 0%, transparent 100%);
    position: relative;
    overflow: hidden;
  }
  .scroll-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: #fff;
    animation: scrollDown 1.8s ease-in-out infinite;
  }
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }

  @media (max-width: 768px) {
    .hero {
      height: 500px;
    }
    .hero-text h1 {
      font-size: 1.85rem;
      line-height: 1.3;
      margin-bottom: 1rem;
      padding: 0 10px;
    }
    .hero-subtitle {
      font-size: 1rem;
      padding: 0 10px;
    }
    .hero-actions {
      gap: 0.75rem;
      width: 100%;
      flex-direction: row;
      justify-content: center;
      padding: 0 10px;
    }
    .btn-outline-hero,
    .cta-btn {
      padding: 11px 20px;
      font-size: 0.9rem;
      width: auto;
      justify-content: center;
    }
    .scroll-indicator {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .hero-text h1 {
      font-size: 1.55rem;
    }
    .hero-eyebrow {
      font-size: 0.72rem;
      padding: 5px 12px;
    }
    .hero-actions {
      gap: 0.5rem;
    }
    .btn-outline-hero,
    .cta-btn {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
</style>
