---
---
<section class="hero">
  <div class="hero-bg">
    <img src="/images/hero-bg.webp" alt="Evinize ve ofisinize değer katan en uygun fiyatlı laminat parke modelleri" fetchpriority="high" />
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-text">
      <h1>Ev, Ofis ve Mekanlarınıza Değer Katan <br />Parke Modellerimiz</h1>
      <div class="hero-actions">
        <a href="/parke" class="btn-outline-hero">
          <span>Ürünleri İncele</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/iletisim" class="btn-white cta-btn">Bize Ulaşın</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    animation: heroZoomIn 12s ease-out infinite;
    transform-origin: center center;
    will-change: transform;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes heroZoomIn {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.12);
    }
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(30, 22, 18, 0.45) 0%, rgba(62, 46, 37, 0.65) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 0 auto;
    width: 100%;
  }
  .hero-text {
    text-align: center;
    color: #fff;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .hero-text h1 {
    color: #fff;
    font-size: 2.75rem;
    line-height: 1.25;
    margin-bottom: 1.75rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    font-family: var(--font-primary);
    text-align: center;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .btn-outline-hero {
    padding: 11px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: var(--radius-sm, 6px);
    backdrop-filter: blur(8px);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }
  .btn-outline-hero:hover {
    background: #ffffff;
    color: var(--color-primary);
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .btn-outline-hero svg {
    transition: transform 0.25s ease;
  }
  .btn-outline-hero:hover svg {
    transform: translateX(4px);
  }
  .cta-btn {
    padding: 11px 24px;
    font-size: 0.95rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    text-decoration: none;
    display: inline-flex;
    border-radius: var(--radius-sm, 6px);
  }
  @media (max-width: 768px) {
    .hero {
      height: 480px;
    }
    .hero-text h1 {
      font-size: 1.7rem;
      line-height: 1.3;
      margin-bottom: 1.25rem;
      padding: 0 10px;
    }
    .hero-actions {
      gap: 0.75rem;
      width: 100%;
      flex-direction: row;
      justify-content: center;
      padding: 0 10px;
    }
    .btn-outline-hero,
    .cta-btn {
      padding: 10px 18px;
      font-size: 0.9rem;
      width: auto;
      justify-content: center;
    }
  }
  @media (max-width: 420px) {
    .hero-text h1 {
      font-size: 1.45rem;
    }
    .hero-actions {
      gap: 0.5rem;
    }
    .btn-outline-hero,
    .cta-btn {
      padding: 9px 14px;
      font-size: 0.85rem;
    }
  }
</style>
