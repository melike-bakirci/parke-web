---
const blogs = [
  {
    id: 1,
    title: "Parke Bakımında Dikkat Edilmesi Gereken 5 Altın Kural",
    summary: "Ahşap ve laminat zeminlerinizin ömrünü uzatmak, ilk günkü parlaklığını ve dokusunu korumak için uygulayabileceğiniz uzman yöntemler.",
    date: "24 Ağustos 2026",
    category: "Bakım Rehberi",
    readTime: "4 dk okuma",
    image: "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80",
    link: "/blog"
  },
  {
    id: 2,
    title: "2026 Yılının En Popüler Zemin Kaplama Trendleri",
    summary: "Modern mimaride öne çıkan sıcak meşe tonları, doğal mat dokular ve suya dayanıklı hibrit parke çözümleri hakkında her şey.",
    date: "18 Ağustos 2026",
    category: "Trendler & Tasarım",
    readTime: "6 dk okuma",
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80",
    link: "/blog"
  },
  {
    id: 3,
    title: "Laminat mı Lamine mi? Eviniz İçin Doğru Parke Seçimi",
    summary: "Yaşam alanınızın kullanım yoğunluğuna, bütçenize ve dekorasyon tarzınıza en uygun parke türünü seçerken bilmeniz gereken temel farklar.",
    date: "05 Ağustos 2026",
    category: "Satın Alma Rehberi",
    readTime: "5 dk okuma",
    image: "https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?auto=format&fit=crop&w=800&q=80",
    link: "/blog"
  }
];
---

<section class="blog-section" id="blog">
  <div class="container">
    <div class="blog-header">
      <h2>Parke Dünyasından En Son Yazılar</h2>
      <p>
        Zemin dekorasyonu, doğru parke seçimi ve uzun ömürlü kullanım için hazırladığımız rehber içeriklere göz atın.
      </p>
    </div>

    <div class="blog-grid">
      {blogs.map((post) => (
        <article class="blog-card">
          <a href={post.link} class="blog-img-wrapper" aria-label={post.title}>
            <img src={post.image} alt={post.title} loading="lazy" />
          </a>
          <div class="blog-content">
            <div class="blog-meta">
              <span class="meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {post.date}
              </span>
              <span class="meta-dot">•</span>
              <span class="meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {post.readTime}
              </span>
            </div>

            <h3 class="blog-title">
              <a href={post.link}>{post.title}</a>
            </h3>

            <p class="blog-desc">
              {post.summary}
            </p>

            <a href={post.link} class="blog-link">
              <span>Oku</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="blog-cta">
      <a href="/blog" class="btn-all-blogs">
        Tüm Blog Yazılarını İncele
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .blog-section {
    padding: 100px 0;
    background: #f8fafc;
    position: relative;
  }

  .blog-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-tag {
    display: inline-block;
    color: var(--color-secondary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .blog-header h2 {
    font-size: 2.4rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .blog-header p {
    font-size: 1.05rem;
    color: #5a6872;
    line-height: 1.65;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-card {
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(18, 52, 71, 0.06);
    border: 1px solid rgba(18, 52, 71, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .blog-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 16px 36px rgba(18, 52, 71, 0.12);
    border-color: rgba(227, 100, 20, 0.3);
  }

  .blog-img-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    display: block;
    background: #e2e8f0;
  }

  .blog-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .blog-card:hover .blog-img-wrapper img {
    transform: scale(1.08);
  }

  .blog-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(18, 52, 71, 0.9);
    color: #ffffff;
    backdrop-filter: blur(4px);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .blog-content {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #718096;
    margin-bottom: 0.85rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-item svg {
    color: var(--color-secondary);
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .blog-title {
    font-size: 1.18rem;
    line-height: 1.45;
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .blog-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .blog-title a:hover {
    color: var(--color-secondary);
  }

  .blog-desc {
    color: #5a6872;
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-top: auto;
  }

  .blog-link svg {
    transition: transform 0.25s ease;
  }

  .blog-link:hover {
    color: var(--color-secondary);
  }

  .blog-link:hover svg {
    transform: translateX(4px);
  }

  .blog-cta {
    text-align: center;
  }

  .btn-all-blogs {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 14px 28px;
    background: #ffffff;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .btn-all-blogs:hover {
    background: var(--color-primary);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(18, 52, 71, 0.15);
  }

  .btn-all-blogs svg {
    transition: transform 0.3s ease;
  }

  .btn-all-blogs:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-section {
      padding: 60px 0;
    }
    .blog-header h2 {
      font-size: 1.85rem;
    }
    .blog-content {
      padding: 1.4rem 1.2rem;
    }
  }
</style>
