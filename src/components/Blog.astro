---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";
import Icon from "./Icon.astro";

const blogEntries = await getCollection("blog");
const blogs = blogEntries.map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
---

<section class="blog-section" id="blog">
  <div class="container">
    <div class="blog-header">
      <div class="header-text">
        <span class="section-tag">Blog</span>
        <h2>Parke ve Zemin Hakkında Her Şey</h2>
        <p>Zemin kaplama rehberi, parke, trendler ve daha fazlası</p>
      </div>
      <a href="/blog" class="btn-view-all">
        <span>Tümü</span>
        <Icon name="arrow-right" size={18} strokeWidth={2.2} />
      </a>
    </div>

    <div class="blog-grid">
      {
        blogs.map((post) => (
          <BlogCard post={post} titleTag="h3" readMoreText="Oku" />
        ))
      }
    </div>
  </div>
</section>

<style>
  .blog-section {
    padding: 100px 0;
    background: #f8fafc;
    position: relative;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-text {
    max-width: 680px;
  }

  .section-tag {
    display: inline-block;
    color: var(--color-primary);
    background: var(--color-secondary-light);
    border: 1px solid var(--color-border);
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .blog-header h2 {
    font-size: 2.4rem;
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .blog-header p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .btn-view-all:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-view-all svg {
    transition: transform 0.25s var(--ease-out);
  }

  .btn-view-all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-section {
      padding: 60px 0;
    }
    .blog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .blog-header h2 {
      font-size: 1.85rem;
    }
    .btn-view-all {
      width: 100%;
      justify-content: center;
    }
  }
</style>
