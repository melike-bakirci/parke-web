---
import CtaBanner from './CtaBanner.astro';
import { siteInfo } from '../data/siteInfo';
import Icon from './Icon.astro';

interface Props {
  showCta?: boolean;
  ctaTitle?: string;
  ctaDescription?: string;
  ctaWhatsappMsg?: string;
  ctaPhoneText?: string;
}

const { showCta = true, ctaTitle, ctaDescription, ctaWhatsappMsg, ctaPhoneText } = Astro.props;
---
{showCta && (
  <CtaBanner 
    title={ctaTitle} 
    description={ctaDescription} 
    whatsappMessage={ctaWhatsappMsg} 
    phoneText={ctaPhoneText} 
  />
)}
<footer class="footer">
  <div class="container footer-container">
    <div class="footer-col brand-col">
      <div class="logo">
        <a href="/" class="footer-logo-link">
          <div class="logo-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="1" y="1" width="13" height="13" fill="var(--color-secondary, #C8A96E)" opacity="0.95"/>
              <rect x="18" y="1" width="13" height="13" fill="var(--color-secondary, #C8A96E)" opacity="0.5"/>
              <rect x="1" y="18" width="13" height="13" fill="var(--color-secondary, #C8A96E)" opacity="0.5"/>
              <rect x="18" y="18" width="13" height="13" fill="var(--color-secondary, #C8A96E)" opacity="0.95"/>
            </svg>
          </div>
          <div class="logo-text">
            <span class="footer-logo-title">{siteInfo.name}</span>
            <span class="footer-logo-sub">Parke Çözümleri</span>
          </div>
        </a>
      </div>
      <p>{siteInfo.description}</p>
      <div class="social-links">
        <a href={siteInfo.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
          <Icon name="instagram" size={18} />
        </a>
        <a href={siteInfo.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <Icon name="linkedin" size={18} />
        </a>
        <a href={siteInfo.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
          <Icon name="facebook" size={18} />
        </a>
        <a href={siteInfo.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube">
          <Icon name="youtube" size={18} />
        </a>
        <a href={siteInfo.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok">
          <Icon name="tiktok" size={18} />
        </a>
        <a href={siteInfo.social.sahibinden} target="_blank" rel="noopener noreferrer" aria-label="Sahibinden" title="Sahibinden">
          <Icon name="sahibinden" size={18} />
        </a>
      </div>
    </div>
    
    <div class="footer-col">
      <h3 class="footer-title">Hızlı Bağlantılar</h3>
      <ul class="footer-links">
        <li><a href="/">Ana Sayfa</a></li>
        <li><a href="/hakkimizda">Biz Kimiz?</a></li>
        <li><a href="/parke">Parke</a></li>
        <li><a href="/galeri">Galeri</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/iletisim">İletişim</a></li>
      </ul>
    </div>
    
    <div class="footer-col">
      <h3 class="footer-title">BİZE ULAŞIN</h3>
      <ul class="footer-contact-list">
        <li>
          <Icon name="location" size={18} />
          <a href={siteInfo.contact.address.mapsUrl} target="_blank" rel="noopener noreferrer">{siteInfo.contact.address.full}</a>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <a href={siteInfo.contact.phone.tel}>{siteInfo.contact.phone.formatted}</a>
        </li>
        <li>
          <Icon name="email" size={18} />
          <a href={siteInfo.contact.email.mailto}>{siteInfo.contact.email.address}</a>
        </li>
        <li>
          <Icon name="clock" size={18} />
          <span>{siteInfo.contact.workingHours.summary}</span>
        </li>
      </ul>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} {siteInfo.title}. Tüm hakları saklıdır.</p>
      <div class="footer-legal-links">
        <a href="/gizlilik-politikasi">Gizlilik Politikası</a>
        <a href="/kullanim-kosullari">Kullanım Koşulları</a>
        <a href="/kvkk">KVKK Aydınlatma Metni</a>
        <a href="/cerez-politikasi">Çerez Politikası</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: #fff;
    padding-top: 80px;
  }
  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-bottom: 60px;
  }
  @media (min-width: 640px) {
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer-container {
      grid-template-columns: 1.5fr 1fr 1.2fr;
    }
  }
  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    margin-bottom: 1.2rem;
  }
  .logo-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .footer-logo-title {
    font-family: var(--font-primary);
    font-weight: 800;
    font-size: 1.35rem;
    color: #fff;
    letter-spacing: 0.5px;
    display: block;
    line-height: 1.2;
  }
  .footer-logo-sub {
    font-size: 0.8rem;
    color: #aaa;
    letter-spacing: 2px;
    display: block;
  }
  .mt-4 {
    margin-top: 1.5rem;
  }
  .footer-title {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
  }
  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }
  .footer-col p {
    color: var(--color-text-light-muted, #DDD1C8);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transition: all 0.3s ease;
  }
  .social-links a:hover {
    background: var(--color-secondary);
    color: var(--color-dark);
    transform: translateY(-3px);
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-links a {
    color: var(--color-text-light-muted, #DDD1C8);
    font-size: 0.95rem;
    transition: color 0.25s ease, transform 0.2s ease;
    display: inline-block;
  }
  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
    transform: translateX(3px);
  }
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-text-light-muted, #DDD1C8);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .footer-contact-list svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-secondary);
  }
  .footer-contact-list a {
    color: var(--color-text-light-muted, #DDD1C8);
    transition: color 0.3s;
    text-decoration: none;
  }
  .footer-contact-list a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 25px 0;
  }
  .footer-bottom-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .footer-bottom-container {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .footer-bottom p {
    color: #777;
    font-size: 0.9rem;
    margin: 0;
  }
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
  }
  .footer-legal-links a {
    color: #777;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-legal-links a:hover {
    color: #fff;
  }
</style>
