---
import CtaBanner from './CtaBanner.astro';

interface Props {
  ctaTitle?: string;
  ctaDescription?: string;
  ctaWhatsappMsg?: string;
  ctaPhoneText?: string;
}

const { ctaTitle, ctaDescription, ctaWhatsappMsg, ctaPhoneText } = Astro.props;
---
<CtaBanner 
  title={ctaTitle} 
  description={ctaDescription} 
  whatsappMessage={ctaWhatsappMsg} 
  phoneText={ctaPhoneText} 
/>
