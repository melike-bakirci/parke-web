---
// src/components/About.astro
---

<section class="about" id="about">
  <div class="container about-container">
    <div class="about-images">
      <div class="image-grid">
        <img
          src="/images/about-1.webp"
          alt="Açık Meşe Parke Uygulaması"
          class="img-1"
          width="400"
          height="300"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/about-2.webp"
          alt="Koyu Ceviz Parke Uygulaması"
          class="img-2"
          width="400"
          height="300"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/about-3.webp"
          alt="Doğal Ahşap Parke Zemin"
          class="img-3"
          width="500"
          height="400"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="about-text">
      <span class="section-tag">ZenFlor Hakkında</span>
      <h2>20 Yıllık Deneyimle<br />Profesyonel Zemin Kaplama Çözümleri</h2>
      <p>
        İstanbul Sancaktepe merkezli ZenFlor olarak 2006'dan bu yana ofis, otel,
        plaza ve konut projelerinde kaliteli ve estetik <a
          href="/parke"
          class="text-link">parke çözümleri</a
        > sunuyoruz. Uzman ekibimiz, geniş ürün yelpazemiz ve en uygun fiyat garantimizle
        mekanlarınıza değer katıyoruz. Binlerce başarılı <a
          href="/galeri"
          class="text-link">zemin uygulaması</a
        > ve binlerce memnun müşterimiz ile tüm Türkiye'de sektörün en güvenilir markası
        olmaya devam ediyoruz.
      </p>
      <a href="/hakkimizda" class="btn-primary">Bizi Tanıyın</a>
    </div>
  </div>
</section>

<style>
  .text-link {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .text-link:hover {
    color: var(--color-dark);
  }
  .about {
    padding: 100px 0;
    background: #fff;
  }
  .about-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  @media (min-width: 1024px) {
    .about-container {
      flex-direction: row;
      align-items: center;
      gap: 6rem;
    }
  }
  .about-images {
    flex: 1;
    position: relative;
  }
  .image-grid {
    position: relative;
    width: 100%;
    height: 480px;
  }
  .img-1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 45%;
    height: 60%;
    object-fit: cover;
    border-radius: var(--radius-md);
    z-index: 1;
    box-shadow: var(--shadow-lg);
  }
  .img-2 {
    position: absolute;
    bottom: 0;
    left: 15%;
    width: 45%;
    height: 50%;
    object-fit: cover;
    border-radius: var(--radius-md);
    z-index: 2;
    box-shadow: var(--shadow-lg);
  }
  .img-3 {
    position: absolute;
    top: 10%;
    right: 0;
    width: 50%;
    height: 70%;
    object-fit: cover;
    border-radius: var(--radius-md);
    z-index: 0;
    box-shadow: var(--shadow-lg);
  }
  .about-text {
    flex: 1;
    max-width: 520px;
  }
  .section-tag {
    display: inline-block;
    color: var(--color-primary);
    background: var(--color-secondary-light);
    border: 1px solid var(--color-border);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }
  .about-text h2 {
    font-size: 2.4rem;
    line-height: 1.25;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    font-family: var(--font-primary);
  }
  .about-text p {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .about {
      padding: 60px 0;
    }
    .about-text h2 {
      font-size: 1.85rem;
    }
    .image-grid {
      height: 380px;
    }
  }
</style>
