      <div class="label">Müşteri</div>
    </div>
  </div>
</section>

<style>
  .stats {
    background-color: var(--color-dark);
    padding: 48px 0;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .stats::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(200, 169, 110, 0.4) 50%, transparent 100%);
  }
  .stats-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align: center;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .stats-container {
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 480px) {
    .stats-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .number {
      font-size: 1.6rem;
    }
    .label {
      font-size: 0.75rem;
    }
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(200, 169, 110, 0.12);
    border: 1px solid rgba(200, 169, 110, 0.2);
    color: var(--color-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    transition: all 0.3s var(--ease-out);
  }
  .stat-item:hover .icon {
    background: rgba(200, 169, 110, 0.2);
    border-color: rgba(200, 169, 110, 0.4);
    transform: translateY(-3px);
  }
  .number {
    font-family: var(--font-primary);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    opacity: 0.7;
    text-transform: uppercase;
  }
  .stat-divider {
    display: none;
  }
  @media (min-width: 1024px) {
    .stat-divider {
      display: block;
      width: 1px;
      height: 56px;
      background: linear-gradient(180deg, transparent 0%, rgba(200, 169, 110, 0.25) 50%, transparent 100%);
    }
  }
</style>
