---
import Icon from "./Icon.astro";

export interface BlogPost {
  slug: string;
  title: string;
  summary: string;
  image: string;
  date: string;
  readTime: string;
  category?: string;
  content?: string;
}

interface Props {
  post: BlogPost;
  titleTag?: "h2" | "h3";
  readMoreText?: string;
  class?: string;
}

const {
  post,
  titleTag = "h3",
  readMoreText = "Oku",
  class: className = "",
} = Astro.props;

const TitleTag = titleTag;
---

<article class={`blog-card ${className}`.trim()}>
  <a
    href={`/blog/${post.slug}`}
    class="blog-img-wrapper"
    aria-label={post.title}
  >
    <img src={post.image} alt={post.title} width="600" height="400" loading="lazy" decoding="async" />
  </a>
  <div class="blog-content">
    <div class="blog-meta">
      <span class="meta-item">
        <Icon name="calendar" size={14} />
        {post.date}
      </span>
      <span class="meta-dot">•</span>
      <span class="meta-item">
        <Icon name="clock" size={14} />
        {post.readTime}
      </span>
    </div>

    <TitleTag class="blog-title">
      <a href={`/blog/${post.slug}`}>{post.title}</a>
    </TitleTag>

    <p class="blog-desc">{post.summary}</p>

    <a href={`/blog/${post.slug}`} class="blog-link">
      <span>{readMoreText}</span>
      <Icon name="arrow-right" size={16} strokeWidth={2.5} />
    </a>
  </div>
</article>

<style>
  .blog-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-secondary);
  }

  .blog-img-wrapper {
    position: relative;
    width: 100%;
    height: 230px;
    overflow: hidden;
    display: block;
    background: var(--color-light);
  }

  .blog-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-img-wrapper img {
    transform: scale(1.06);
  }

  .blog-content {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-item svg {
    color: var(--color-primary);
  }

  .meta-dot {
    color: var(--color-border);
  }

  .blog-title {
    font-size: 1.18rem;
    line-height: 1.45;
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .blog-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .blog-title a:hover {
    color: var(--color-primary-dark);
  }

  .blog-desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-top: auto;
  }

  .blog-link svg {
    transition: transform 0.25s ease;
  }

  .blog-link:hover {
    color: var(--color-secondary);
  }

  .blog-link:hover svg {
    transform: translateX(4px);
  }

  /* Tablet */
  @media (max-width: 768px) {
    .blog-img-wrapper {
      height: 200px;
    }
    .blog-content {
      padding: 1.4rem 1.2rem;
    }
    .blog-title {
      font-size: 1.05rem;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .blog-img-wrapper {
      height: 180px;
    }
    .blog-content {
      padding: 1.1rem 1rem;
    }
    .blog-title {
      font-size: 1rem;
    }
    .blog-desc {
      font-size: 0.87rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
