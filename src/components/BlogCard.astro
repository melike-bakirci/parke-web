---
export interface BlogPost {
  slug: string;
  title: string;
  summary: string;
  image: string;
  date: string;
  readTime: string;
  category?: string;
  content?: string;
}

interface Props {
  post: BlogPost;
  titleTag?: "h2" | "h3";
  readMoreText?: string;
  class?: string;
}

const {
  post,
  titleTag = "h3",
  readMoreText = "Oku",
  class: className = "",
} = Astro.props;

const TitleTag = titleTag;
---

<article class={`blog-card ${className}`.trim()}>
  <a
    href={`/blog/${post.slug}`}
    class="blog-img-wrapper"
    aria-label={post.title}
  >
    <img src={post.image} alt={post.title} loading="lazy" />
  </a>
  <div class="blog-content">
    <div class="blog-meta">
      <span class="meta-item">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        {post.date}
      </span>
      <span class="meta-dot">•</span>
      <span class="meta-item">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {post.readTime}
      </span>
    </div>

    <TitleTag class="blog-title">
      <a href={`/blog/${post.slug}`}>{post.title}</a>
    </TitleTag>

    <p class="blog-desc">{post.summary}</p>

    <a href={`/blog/${post.slug}`} class="blog-link">
      <span>{readMoreText}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(18, 52, 71, 0.06);
    border: 1px solid rgba(18, 52, 71, 0.08);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .blog-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 16px 36px rgba(18, 52, 71, 0.12);
    border-color: rgba(200, 169, 110, 0.4);
  }

  .blog-img-wrapper {
    position: relative;
    width: 100%;
    height: 230px;
    overflow: hidden;
    display: block;
    background: #e2e8f0;
  }

  .blog-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .blog-card:hover .blog-img-wrapper img {
    transform: scale(1.08);
  }

  .blog-content {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #718096;
    margin-bottom: 0.85rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-item svg {
    color: var(--color-secondary);
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .blog-title {
    font-size: 1.18rem;
    line-height: 1.45;
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .blog-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .blog-title a:hover {
    color: var(--color-secondary);
  }

  .blog-desc {
    color: #5a6872;
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-top: auto;
  }

  .blog-link svg {
    transition: transform 0.25s ease;
  }

  .blog-link:hover {
    color: var(--color-secondary);
  }

  .blog-link:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-content {
      padding: 1.4rem 1.2rem;
    }
  }
</style>
