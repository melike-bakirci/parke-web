---
import { siteInfo } from "../data/siteInfo";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
---

<header class="header">
  <div class="header-top">
    <div class="container top-container">
      <div class="logo">
        <a href="/" class="logo-link">
          <div class="logo-icon">
            <svg
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect x="1" y="1" width="13" height="13" fill="#C8A96E" opacity="0.95"></rect>
              <rect x="18" y="1" width="13" height="13" fill="#C8A96E" opacity="0.5"></rect>
              <rect x="1" y="18" width="13" height="13" fill="#C8A96E" opacity="0.5"></rect>
              <rect x="18" y="18" width="13" height="13" fill="#C8A96E" opacity="0.95"></rect>
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-title">{siteInfo.name}</span>
            <span class="logo-sub">Parke Çözümleri</span>
          </div>
        </a>
      </div>
      <div class="contact-info">
        <a
          href={siteInfo.contact.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title={siteInfo.contact.address.full}
        >
          <Icon name="home" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.address.short}</span>
        </a>
        <a href={siteInfo.contact.phone.tel} class="contact-item" title={siteInfo.contact.phone.formatted}>
          <Icon name="phone" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.phone.formatted}</span>
        </a>
        <a
          href={siteInfo.contact.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="WhatsApp İletişim Hattı"
        >
          <Icon name="whatsapp" size={15} />
          <span>WhatsApp</span>
        </a>
        <a
          href={siteInfo.social.sahibinden}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="Sahibinden Mağazamız"
        >
          <Icon name="sahibinden" size={15} />
          <span>Sahibinden Mağazamız</span>
        </a>
      </div>
    </div>
  </div>
  <nav class="header-nav">
    <div class="container nav-container">
      <ul class="nav-links">
        <li><a href="/" class={pathname === "/" ? "active" : ""}>Ana Sayfa</a></li>
        <li><a href="/hakkimizda" class={pathname.startsWith("/hakkimizda") ? "active" : ""}>Biz Kimiz?</a></li>
        <li><a href="/parke" class={pathname.startsWith("/parke") ? "active" : ""}>Parke</a></li>
        <li><a href="/referanslar" class={pathname.startsWith("/referanslar") ? "active" : ""}>Neler Yaptık?</a></li>
        <li><a href="/blog" class={pathname.startsWith("/blog") ? "active" : ""}>Blog</a></li>
        <li><a href="/iletisim" class={pathname.startsWith("/iletisim") ? "active" : ""}>İletişim</a></li>
      </ul>
      <a href={siteInfo.contact.phone.tel} class="btn-white quote-nav-btn">
        <Icon name="phone" size={16} strokeWidth={2.2} class="quote-phone-icon" />
        <span>Teklif Alın</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    width: 100%;
    background: #fff;
  }
  .header-top {
    padding: 0.9rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .top-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }
  .logo-icon {
    width: 40px;
    height: 40px;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .logo-title {
    font-family: var(--font-primary);
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }
  .logo-sub {
    font-size: 0.8rem;
    color: #666;
    letter-spacing: 2px;
  }
  .contact-info {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #444;
    text-decoration: none;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-secondary);
  }
  .contact-item:hover {
    color: var(--color-primary);
  }
  .header-nav {
    background: var(--color-primary);
    padding: 0.6rem 0;
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.3s;
    position: relative;
    padding-bottom: 0.2rem;
  }
  .nav-links a:hover {
    color: #fff;
  }
  .nav-links a.active {
    color: #fff;
    font-weight: 700;
  }
  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }
  .quote-nav-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .quote-phone-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .quote-nav-btn:hover .quote-phone-icon {
    transform: rotate(15deg) scale(1.1);
  }
</style>
