---
const pathname = Astro.url.pathname;
---

<header class="header">
  <div class="header-top">
    <div class="container top-container">
      <div class="logo">
        <a href="/" class="logo-link">
          <div class="logo-icon">
            <svg
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect x="1" y="1" width="13" height="13" fill="#C8A96E" opacity="0.95"></rect>
              <rect x="18" y="1" width="13" height="13" fill="#C8A96E" opacity="0.5"></rect>
              <rect x="1" y="18" width="13" height="13" fill="#C8A96E" opacity="0.5"></rect>
              <rect x="18" y="18" width="13" height="13" fill="#C8A96E" opacity="0.95"></rect>
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-title">ZenFlor</span>
            <span class="logo-sub">Parke Çözümleri</span>
          </div>
        </a>
      </div>
      <div class="contact-info">
        <a
          href="https://maps.app.goo.gl/cyQwTaXrGfFNJmyTA"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="Leman Sk. No:4, Sancaktepe/İstanbul"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
            ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
          >
          <span>Leman Sk. No:4, Sancaktepe</span>
        </a>
        <a href="tel:+905302708487" class="contact-item" title="+90 (530) 270 84 87">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
          <span>+90 (530) 270 84 87</span>
        </a>
        <a
          href="https://wa.me/905302708487"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="WhatsApp İletişim Hattı"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M19.05 4.91A10.87 10.87 0 0 0 11.4 1.75C5.46 1.75.64 6.57.64 12.5c0 1.9.49 3.75 1.43 5.38L.5 23.5l5.77-1.51a10.86 10.86 0 0 0 5.13 1.28h.01c5.93 0 10.75-4.82 10.75-10.76 0-2.87-1.12-5.58-3.11-7.6zM11.4 21.36h-.01a9.04 9.04 0 0 1-4.61-1.26l-.33-.2-3.43.9.92-3.34-.22-.35a9.07 9.07 0 0 1-1.39-4.87c0-5.01 4.08-9.08 9.09-9.08 2.43 0 4.71.94 6.42 2.66a9.04 9.04 0 0 1 2.67 6.43c0 5.01-4.08 9.08-9.08 9.08zm4.98-6.8c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47-.16-.01-.35-.01-.53-.01s-.49.07-.75.35c-.25.27-.98.96-.98 2.34s1 2.72 1.14 2.91c.14.18 1.97 3.01 4.77 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.77.11.54-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.11-.25-.18-.52-.32z"
            ></path>
          </svg>
          <span>WhatsApp</span>
        </a>
        <a
          href="https://zenflor.sahibinden.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="Sahibinden Mağazamız"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><path
              d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-4.2 6.2c-.4-.4-1.1-.7-2-.7-.9 0-1.6.3-1.6.9 0 .6.5.7 1.5 1 1.7.5 3.3 1.1 3.3 3 0 1.9-1.6 3.1-3.8 3.1-1.7 0-2.9-.6-3.7-1.4l1.3-1.5c.6.6 1.4 1 2.3 1 1 0 1.7-.4 1.7-1 0-.6-.5-.8-1.5-1.1-1.8-.5-3.3-1.1-3.3-2.9 0-1.8 1.5-3 3.5-3 1.4 0 2.5.4 3.3 1.1l-1.3 1.6z"
            ></path></svg
          >
          <span>Sahibinden Mağazamız</span>
        </a>
      </div>
    </div>
  </div>
  <nav class="header-nav">
    <div class="container nav-container">
      <ul class="nav-links">
        <li><a href="/" class={pathname === "/" ? "active" : ""}>Ana Sayfa</a></li>
        <li><a href="/hakkimizda" class={pathname.startsWith("/hakkimizda") ? "active" : ""}>Biz Kimiz?</a></li>
        <li><a href="/parke" class={pathname.startsWith("/parke") ? "active" : ""}>Parke</a></li>
        <li><a href="/referanslar" class={pathname.startsWith("/referanslar") ? "active" : ""}>Neler Yaptık?</a></li>
        <li><a href="/blog" class={pathname.startsWith("/blog") ? "active" : ""}>Blog</a></li>
        <li><a href="/iletisim" class={pathname.startsWith("/iletisim") ? "active" : ""}>İletişim</a></li>
      </ul>
      <a href="tel:+905302708487" class="btn-white quote-nav-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="quote-phone-icon">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Teklif Alın</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    width: 100%;
    background: #fff;
  }
  .header-top {
    padding: 0.9rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .top-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }
  .logo-icon {
    width: 40px;
    height: 40px;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .logo-title {
    font-family: var(--font-primary);
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }
  .logo-sub {
    font-size: 0.8rem;
    color: #666;
    letter-spacing: 2px;
  }
  .contact-info {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #444;
    text-decoration: none;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-secondary);
  }
  .contact-item:hover {
    color: var(--color-primary);
    background: #f4f6f8;
  }
  .header-nav {
    background: var(--color-primary);
    padding: 0.6rem 0;
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.3s;
    position: relative;
    padding-bottom: 0.2rem;
  }
  .nav-links a:hover {
    color: #fff;
  }
  .nav-links a.active {
    color: #fff;
    font-weight: 700;
  }
  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }
  .quote-nav-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .quote-phone-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .quote-nav-btn:hover .quote-phone-icon {
    transform: rotate(15deg) scale(1.1);
  }
</style>
