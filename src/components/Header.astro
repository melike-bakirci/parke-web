---
import { siteInfo } from "../data/siteInfo";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
---

<header class="header">
  <!-- Header Top Bar (Desktop & Tablet) -->
  <div class="header-top">
    <div class="container top-container">
      <div class="logo">
        <a href="/" class="logo-link" aria-label="Ana Sayfa - ZenFlor Parke">
          <div class="logo-icon">
            <svg
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect
                x="1"
                y="1"
                width="13"
                height="13"
                fill="var(--color-secondary, #C8A96E)"
                opacity="0.95"></rect>
              <rect
                x="18"
                y="1"
                width="13"
                height="13"
                fill="var(--color-secondary, #C8A96E)"
                opacity="0.5"></rect>
              <rect
                x="1"
                y="18"
                width="13"
                height="13"
                fill="var(--color-secondary, #C8A96E)"
                opacity="0.5"></rect>
              <rect
                x="18"
                y="18"
                width="13"
                height="13"
                fill="var(--color-secondary, #C8A96E)"
                opacity="0.95"></rect>
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-title">{siteInfo.name}</span>
            <span class="logo-sub">Parke Çözümleri</span>
          </div>
        </a>
      </div>
      <div class="contact-info">
        <a
          href={siteInfo.contact.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title={siteInfo.contact.address.full}
          aria-label={siteInfo.contact.address.short}
        >
          <Icon name="home" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.address.short}</span>
        </a>
        <a
          href={siteInfo.contact.phone.tel}
          class="contact-item"
          title={siteInfo.contact.phone.formatted}
          aria-label={siteInfo.contact.phone.formatted}
        >
          <Icon name="phone" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.phone.formatted}</span>
        </a>
        <a
          href={siteInfo.contact.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="WhatsApp İletişim Hattı"
          aria-label="WhatsApp İletişim Hattı"
        >
          <Icon name="whatsapp" size={15} />
          <span>WhatsApp</span>
        </a>
        <a
          href={siteInfo.social.sahibinden}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
          title="Sahibinden Mağazamız"
          aria-label="Sahibinden Mağazamız"
        >
          <Icon name="sahibinden" size={15} />
          <span>Sahibinden</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="header-nav" aria-label="Ana Gezinme Menüsü">
    <div class="container nav-container">
      <!-- Mobile Logo (shown inside nav bar on mobile) -->
      <a href="/" class="mobile-logo" aria-label="Ana Sayfa - ZenFlor Parke">
        <div class="mobile-logo-icon">
          <svg
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              x="1"
              y="1"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.95"></rect>
            <rect
              x="18"
              y="1"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.5"></rect>
            <rect
              x="1"
              y="18"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.5"></rect>
            <rect
              x="18"
              y="18"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.95"></rect>
          </svg>
        </div>
        <span class="mobile-logo-title">{siteInfo.name}</span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="nav-links">
        <li>
          <a href="/" class={pathname === "/" ? "active" : ""}>Ana Sayfa</a>
        </li>
        <li>
          <a
            href="/hakkimizda"
            class={pathname.startsWith("/hakkimizda") ? "active" : ""}
            >Hakkımızda</a
          >
        </li>
        <li>
          <a href="/parke" class={pathname.startsWith("/parke") ? "active" : ""}
            >Parke</a
          >
        </li>
        <li>
          <a
            href="/galeri"
            class={pathname.startsWith("/galeri") ? "active" : ""}>Galeri</a
          >
        </li>
        <li>
          <a href="/blog" class={pathname.startsWith("/blog") ? "active" : ""}
            >Blog</a
          >
        </li>
        <li>
          <a
            href="/iletisim"
            class={pathname.startsWith("/iletisim") ? "active" : ""}>İletişim</a
          >
        </li>
      </ul>

      <!-- Desktop Quote Button -->
      <a
        href={siteInfo.contact.phone.tel}
        class="btn-white quote-nav-btn desktop-quote"
        aria-label="Telefonla Teklif Alın"
      >
        <Icon
          name="phone"
          size={16}
          strokeWidth={2.2}
          class="quote-phone-icon"
        />
        <span>Teklif Alın</span>
      </a>

      <!-- Mobile Right Controls (Quick Call + Hamburger Button - NO BG) -->
      <div class="mobile-nav-actions">
        <a
          href={siteInfo.contact.phone.tel}
          class="mobile-quick-call"
          aria-label="Hemen Arayın"
          title="Hemen Arayın"
        >
          <Icon name="phone" size={20} strokeWidth={2.2} />
        </a>
        <button
          type="button"
          class="hamburger-btn"
          id="mobileMenuToggle"
          aria-label="Menüyü Aç"
          aria-expanded="false"
          aria-controls="mobileDrawer"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer Backdrop -->
  <div class="drawer-backdrop" id="drawerBackdrop" aria-hidden="true"></div>

  <!-- Mobile Drawer Menu -->
  <div
    class="mobile-drawer"
    id="mobileDrawer"
    role="dialog"
    aria-modal="true"
    aria-label="Mobil Menü"
  >
    <div class="drawer-header">
      <div class="drawer-logo">
        <div class="logo-icon">
          <svg
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              x="1"
              y="1"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.95"></rect>
            <rect
              x="18"
              y="1"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.5"></rect>
            <rect
              x="1"
              y="18"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.5"></rect>
            <rect
              x="18"
              y="18"
              width="13"
              height="13"
              fill="var(--color-secondary, #C8A96E)"
              opacity="0.95"></rect>
          </svg>
        </div>
        <div class="logo-text">
          <span class="logo-title">{siteInfo.name}</span>
          <span class="logo-sub">Parke Çözümleri</span>
        </div>
      </div>
      <button
        type="button"
        class="drawer-close-btn"
        id="drawerCloseBtn"
        aria-label="Menüyü Kapat"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
      <ul class="drawer-links">
        <li>
          <a href="/" class={`drawer-link ${pathname === "/" ? "active" : ""}`}>
            <span>Ana Sayfa</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
        <li>
          <a
            href="/hakkimizda"
            class={`drawer-link ${pathname.startsWith("/hakkimizda") ? "active" : ""}`}
          >
            <span>Hakkımızda</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
        <li>
          <a
            href="/parke"
            class={`drawer-link ${pathname.startsWith("/parke") ? "active" : ""}`}
          >
            <span>Parke</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
        <li>
          <a
            href="/galeri"
            class={`drawer-link ${pathname.startsWith("/galeri") ? "active" : ""}`}
          >
            <span>Galeri</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class={`drawer-link ${pathname.startsWith("/blog") ? "active" : ""}`}
          >
            <span>Blog</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
        <li>
          <a
            href="/iletisim"
            class={`drawer-link ${pathname.startsWith("/iletisim") ? "active" : ""}`}
          >
            <span>İletişim</span>
            <Icon
              name="arrow-right"
              size={16}
              strokeWidth={2}
              class="drawer-arrow"
            />
          </a>
        </li>
      </ul>

      <!-- Drawer Contact & Info (TopHeader Items + Working Hours) -->
      <div class="drawer-footer">
        <a
          href={siteInfo.contact.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="drawer-info-item"
          title={siteInfo.contact.address.full}
        >
          <Icon name="home" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.address.short}</span>
        </a>
        <a
          href={siteInfo.contact.phone.tel}
          class="drawer-info-item"
          title={siteInfo.contact.phone.formatted}
        >
          <Icon name="phone" size={15} strokeWidth={2} />
          <span>{siteInfo.contact.phone.formatted}</span>
        </a>
        <a
          href={siteInfo.contact.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="drawer-info-item"
          title="WhatsApp İletişim Hattı"
        >
          <Icon name="whatsapp" size={15} />
          <span>WhatsApp</span>
        </a>
        <a
          href={siteInfo.social.sahibinden}
          target="_blank"
          rel="noopener noreferrer"
          class="drawer-info-item"
          title="Sahibinden Mağazamız"
        >
          <Icon name="sahibinden" size={15} />
          <span>Sahibinden</span>
        </a>
        <div class="drawer-info-item">
          <Icon name="clock" size={15} />
          <span>{siteInfo.contact.workingHours.summary}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById("mobileMenuToggle");
    const closeBtn = document.getElementById("drawerCloseBtn");
    const drawer = document.getElementById("mobileDrawer");
    const backdrop = document.getElementById("drawerBackdrop");
    const drawerLinks = document.querySelectorAll(".drawer-link");

    if (!toggleBtn || !drawer || !backdrop) return;

    function openMenu() {
      drawer?.classList.add("open");
      backdrop?.classList.add("open");
      toggleBtn?.classList.add("active");
      toggleBtn?.setAttribute("aria-expanded", "true");
      toggleBtn?.setAttribute("aria-label", "Menüyü Kapat");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      drawer?.classList.remove("open");
      backdrop?.classList.remove("open");
      toggleBtn?.classList.remove("active");
      toggleBtn?.setAttribute("aria-expanded", "false");
      toggleBtn?.setAttribute("aria-label", "Menüyü Aç");
      document.body.style.overflow = "";
    }

    toggleBtn.addEventListener("click", () => {
      const isOpen = drawer.classList.contains("open");
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    drawerLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("open")) {
        closeMenu();
      }
    });
  }

  // Initial load and Astro Page Transitions support
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>

<style>
  .header {
    width: 100%;
    background: #fff;
    position: relative;
    z-index: 1000;
  }

  /* =========================================
     TOP BAR
     ========================================= */
  .header-top {
    padding: 0.7rem 0;
    border-bottom: 1px solid #f3f1ee;
  }
  .top-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .logo-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .logo-title {
    font-family: var(--font-primary);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }
  .logo-sub {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-weight: 500;
  }
  .contact-info {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s var(--ease-smooth);
  }
  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-primary);
    opacity: 0.85;
    transition: all 0.2s var(--ease-smooth);
  }
  .contact-item:hover {
    color: var(--color-primary);
  }
  .contact-item:hover svg {
    opacity: 1;
    transform: scale(1.08);
  }

  /* =========================================
     NAV BAR
     ========================================= */
  .header-nav {
    background: var(--color-primary);
    padding: 0.65rem 0;
    position: relative;
  }
  .header-nav::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(200, 169, 110, 0.3) 50%, transparent 100%);
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mobile-logo {
    display: none;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #ffffff;
  }
  .mobile-logo-icon {
    width: 26px;
    height: 26px;
  }
  .mobile-logo-title {
    font-family: var(--font-primary);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .nav-links {
    display: flex;
    gap: 2.2rem;
  }
  .nav-links a {
    color: rgba(255, 255, 255, 0.82);
    font-weight: 500;
    font-size: 0.93rem;
    text-decoration: none;
    transition: color 0.25s var(--ease-smooth);
    position: relative;
    padding-bottom: 0.15rem;
  }
  .nav-links a:hover {
    color: #fff;
  }
  .nav-links a.active {
    color: #fff;
    font-weight: 600;
  }
  .nav-links a.active::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 2px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }
  .quote-nav-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 9px 20px;
    border-radius: var(--radius-sm);
    transition: all 0.3s var(--ease-out);
  }
  .quote-phone-icon {
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out);
  }
  .quote-nav-btn:hover .quote-phone-icon {
    transform: rotate(15deg) scale(1.1);
  }

  /* =========================================
     MOBILE ACTIONS & HAMBURGER
     ========================================= */
  .mobile-nav-actions {
    display: none;
    align-items: center;
    gap: 4px;
  }
  .mobile-quick-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    color: #ffffff;
    text-decoration: none;
    transition: transform 0.2s var(--ease-smooth), opacity 0.2s var(--ease-smooth);
    cursor: pointer;
  }
  .mobile-quick-call:hover {
    transform: scale(1.08);
    opacity: 0.9;
  }
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 6px;
    transition: transform 0.2s var(--ease-smooth);
  }
  .hamburger-btn:hover {
    transform: scale(1.05);
  }
  .hamburger-bar {
    width: 22px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
    transform-origin: center;
  }
  .hamburger-btn.active .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger-btn.active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger-btn.active .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* =========================================
     MOBILE DRAWER BACKDROP
     ========================================= */
  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-smooth), visibility 0.3s var(--ease-smooth);
  }
  .drawer-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  /* =========================================
     MOBILE DRAWER
     ========================================= */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 86%;
    max-width: 360px;
    height: 100vh;
    background: #ffffff;
    z-index: 10001;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-out);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.12);
    overflow-y: auto;
  }
  .mobile-drawer.open {
    transform: translateX(0);
  }

  /* Drawer Header */
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f3f1ee;
  }
  .drawer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .drawer-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s var(--ease-smooth);
  }
  .drawer-close-btn:hover {
    color: #ef4444;
    transform: scale(1.1);
  }

  /* Drawer Body */
  .drawer-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 1.75rem;
  }
  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 14px;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-dark);
    text-decoration: none;
    transition: all 0.2s var(--ease-smooth);
  }
  .drawer-link:hover {
    background: var(--color-secondary-light);
    color: var(--color-primary);
  }
  .drawer-link.active {
    background: rgba(140, 106, 83, 0.08);
    color: var(--color-primary);
    font-weight: 600;
  }
  .drawer-arrow {
    color: #94a3b8;
    transition: transform 0.2s var(--ease-smooth);
  }
  .drawer-link:hover .drawer-arrow,
  .drawer-link.active .drawer-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  /* Drawer Footer */
  .drawer-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid #f3f1ee;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .drawer-info-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.87rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    line-height: 1.4;
