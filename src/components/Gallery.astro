---
import { galleryImages } from "../data/gallery";
---

<section class="home-gallery" id="galeri">
  <div class="container">
    <div class="gallery-header">
      <div class="header-text">
        <span class="section-tag">Galeri</span>
        <h2>Uygulama Galerisi</h2>
        <p>Ev, ofis ve ticari mekanlar için parke zemin uygulamalarımız</p>
      </div>
      <a href="/galeri" class="btn-view-all">
        <span>Tümü</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Uygulama Galerisi Grid (4 Adet Örnek Görsel) -->
    <div class="gallery-grid">
      {
        galleryImages.slice(0, 4).map((item) => (
          <a
            href="/galeri"
            class="gallery-card"
            aria-label="Uygulama Galerisini Gör"
          >
            <img
              src={item.img}
              alt={item.alt}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
            />
            <div class="gallery-card-overlay">
              <span class="zoom-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  <line x1="11" y1="8" x2="11" y2="14" />
                  <line x1="8" y1="11" x2="14" y2="11" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-gallery {
    padding: 80px 0;
    background: #ffffff;
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-text {
    max-width: 680px;
  }

  .section-tag {
    display: inline-block;
    color: var(--color-primary);
    background: var(--color-secondary-light);
    border: 1px solid var(--color-border);
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
  }

  .header-text h2 {
    font-size: 2.4rem;
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-primary);
    font-weight: 700;
  }

  .header-text p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-secondary);
    text-decoration: none;
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .btn-view-all:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-view-all svg {
    transition: transform 0.25s var(--ease-out);
  }

  .btn-view-all:hover svg {
    transform: translateX(4px);
  }

  /* Galeri Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .gallery-card {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #edf2f7;
    border: 1px solid var(--color-border);
    aspect-ratio: 4/3;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-secondary);
  }

  .gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  .gallery-card:hover img {
    transform: scale(1.08);
  }

  .gallery-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 25, 34, 0) 0%, rgba(15, 25, 34, 0.5) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    padding: 16px;
  }

  .gallery-card:hover .gallery-card-overlay {
    opacity: 1;
  }

  .zoom-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: scale(0.85);
    transition: transform 0.3s var(--ease-out);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  .gallery-card:hover .zoom-icon {
    transform: scale(1);
  }

  @media (max-width: 768px) {
    .home-gallery {
      padding: 50px 0;
    }
    .gallery-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .gallery-header h2 {
      font-size: 1.85rem;
    }
    .btn-view-all {
      width: 100%;
      justify-content: center;
    }
    .zoom-icon {
      width: 38px;
      height: 38px;
    }
  }
</style>
