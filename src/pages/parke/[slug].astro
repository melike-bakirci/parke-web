---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCard from "../../components/ProductCard.astro";
import products from "../../data/products.json";
import { siteInfo } from "../../data/siteInfo";

export async function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;
const images =
	product.images && product.images.length > 0
		? product.images
		: [product.img];

// Sayısal fiyat hesaplama
const rawPrice =
	parseFloat(product.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;

// Diğer / İlgili Ürünler (Öncelikle aynı seriden, toplam 4 ürün)
const otherProducts = products
	.filter((p) => p.id !== product.id)
	.sort((a, b) => {
		if (a.series === product.series && b.series !== product.series) return -1;
		if (a.series !== product.series && b.series === product.series) return 1;
		return 0;
	})
	.slice(0, 4);

const productSchema = {
	"@context": "https://schema.org/",
	"@type": "Product",
	"name": product.name,
	"image": new URL(images[0], Astro.site ? Astro.site.origin : siteInfo.url).href,
	"description": `${product.series} serisi, ${product.thickness} kalınlığında, ${product.color} renginde ${product.name} laminat parke.`,
	"offers": {
		"@type": "Offer",
		"priceCurrency": "TRY",
		"price": rawPrice,
		"availability": "https://schema.org/InStock",
		"url": new URL(Astro.url.pathname, Astro.site ? Astro.site.origin : siteInfo.url).href
	}
};
---

<Layout 
	title={product.name}
	description={`${product.series} serisi, ${product.thickness} kalınlığında, ${product.color} renginde ${product.name} laminat parke modeli. ZenFlor kalitesiyle.`}
	image={images[0]}
	schema={productSchema}
>

	<section class="product-detail">
		<div class="container">
			<div class="product-breadcrumb-wrapper">
				<Breadcrumb
					items={[
						{ label: "Parke Koleksiyonu", href: "/parke" },
						{ label: product.name },
					]}
				/>
			</div>

			<div class="detail-layout">
				<!-- SOL SÜTUN: FOTOĞRAF SLIDER VE HEMEN ALTINDA TEKNİK ÖZELLİKLER -->
				<div class="detail-left">
					<div
						class="product-slider"
						id="productSlider"
						data-slide-count={images.length}
						data-product-name={product.name}
						data-product-id={product.id}
					>
						<div class="slider-viewport" id="sliderViewport">
							<!-- Görsel Sağ Alt Aksiyon Butonları (İncele & İndir) -->
							<div class="slider-actions">
								<button
									type="button"
									class="slider-action-btn"
									id="quickZoomBtn"
									title="Görseli Yakından İncele"
									aria-label="Görseli Yakından İncele"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="18"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<circle cx="11" cy="11" r="8"></circle>
										<line
											x1="21"
											y1="21"
											x2="16.65"
											y2="16.65"></line>
										<line x1="11" y1="8" x2="11" y2="14"
										></line>
										<line x1="8" y1="11" x2="14" y2="11"
										></line>
									</svg>
									<span class="action-tooltip"
										>Yakından İncele</span
									>
								</button>
								<button
									type="button"
									class="slider-action-btn"
									id="quickDownloadBtn"
									title="Görseli İndir"
									aria-label="Görseli İndir"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="18"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path
											d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
										></path>
										<polyline points="7 10 12 15 17 10"
										></polyline>
										<line x1="12" y1="15" x2="12" y2="3"
										></line>
									</svg>
									<span class="action-tooltip"
										>Görseli İndir</span
									>
								</button>
							</div>

							<div class="slider-track" id="sliderTrack">
								{
									images.map((imgSrc, index) => (
										<div
											class="slide-item"
											data-index={index}
											title="Görseli büyütmek için tıklayın"
										>
											<img
												src={imgSrc}
												alt={`${product.series} Serisi ${product.color} Renk ${product.thickness} ${product.edge} ${product.name} Laminat Parke - Görsel ${index + 1}`}
												loading={index === 0 ? "eager" : "lazy"}
												decoding="async"
												data-index={index}
											/>
										</div>
									))
								}
							</div>

							{
								images.length > 1 && (
									<>
										<button
											class="slider-btn prev-btn"
											id="prevBtn"
											type="button"
											aria-label="Önceki Görsel"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="22"
												height="22"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<polyline points="15 18 9 12 15 6" />
											</svg>
										</button>
										<button
											class="slider-btn next-btn"
											id="nextBtn"
											type="button"
											aria-label="Sonraki Görsel"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="22"
												height="22"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<polyline points="9 18 15 12 9 6" />
											</svg>
										</button>
									</>
								)
							}
						</div>

						{
							images.length > 1 && (
								<div class="slider-dots" id="sliderDots">
									{images.map((_, index) => (
										<button
											class={`dot-btn ${index === 0 ? "active" : ""}`}
											type="button"
											data-dot-index={index}
											aria-label={`Görsel ${index + 1}'e git`}
										/>
									))}
								</div>
							)
						}
					</div>

					<!-- Fotonun hemen altındaki Teknik Özellikler Bölümü -->
					<div class="specs-section">
						<h3 class="specs-title">Teknik Özellikler</h3>
						<ul class="specs-list">
							<li>
								<span class="spec-name">Renk Tonu</span>
								<span class="spec-value">{product.color}</span>
							</li>
							<li>
								<span class="spec-name">Kalınlık</span>
								<span class="spec-value"
									>{product.thickness}</span
								>
							</li>
							<li>
								<span class="spec-name">Kenar Tipi</span>
								<span class="spec-value">{product.edge}</span>
							</li>
							<li>
								<span class="spec-name">Boyut (En x Boy)</span>
								<span class="spec-value"
									>{product.width} x {product.length}</span
								>
							</li>
							<li>
								<span class="spec-name">Yüzey Dayanımı</span>
								<span class="spec-value">{product.surface}</span
								>
							</li>
							<li>
								<span class="spec-name">Paket İçeriği</span>
								<span class="spec-value">{product.package}</span
								>
							</li>
							<li>
								<span class="spec-name">Palet İçeriği</span>
								<span class="spec-value">{product.pallet}</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- SAĞ SÜTUN: BAŞLIK, FİYAT VE MALİYETİNİZİ HEMEN HESAPLAYIN -->
				<div class="detail-right">
					<div class="product-header-block">
						<div class="detail-header">
							<span class="series-tag">{product.series} Serisi</span>
							<h1 class="product-title">{product.name}</h1>
						</div>

						<div class="price-block">
							<div class="price-display">
								<span class="price-value">{product.price}</span>
								<span class="price-unit">/ m²</span>
							</div>
						</div>
					</div>

					<!-- MALİYETİNİZİ HEMEN HESAPLAYIN BÖLÜMÜ -->
					<div class="calculator-card">
						<div class="calc-header">
							<div class="calc-icon">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect
										x="4"
										y="2"
										width="16"
										height="20"
										rx="2"></rect>
									<line x1="8" y1="6" x2="16" y2="6"></line>
									<line x1="16" y1="14" x2="16" y2="18"
									></line>
									<path d="M16 10h.01"></path>
									<path d="M12 10h.01"></path>
									<path d="M8 10h.01"></path>
									<path d="M12 14h.01"></path>
									<path d="M8 14h.01"></path>
									<path d="M12 18h.01"></path>
									<path d="M8 18h.01"></path>
								</svg>
							</div>
							<div>
								<h3 class="calc-title">
									Maliyetinizi Hemen Hesaplayın
								</h3>
								<p class="calc-subtitle">
									Uygulanacak alanı girin, tahmini toplam
									maliyetinizi anında görün.
								</p>
							</div>
						</div>

						<div class="calc-body">
							<div class="input-group">
								<label for="calcArea" class="input-label"
									>Uygulanacak Alan (m²)</label
								>
								<div class="input-wrapper">
									<input
										type="number"
										id="calcArea"
										class="area-input"
										value=""
										placeholder="Örn: 25"
										min="1"
										max="2000"
										step="1"
										data-price={rawPrice}
										data-product-name={product.name}
									/>
									<span class="input-unit">m²</span>
								</div>
							</div>

							<!-- Sadece girdi girilince görünen sonuç ve buton alanı -->
							<div
								class="calc-output-wrapper"
								id="calcOutputWrapper"
								style="display: none;"
							>
								<div class="calc-results">
									<div class="result-row total-row">
										<span class="total-label"
											>Tahmini Toplam Maliyet:</span
										>
										<span
											class="total-price"
											id="calcTotalPrice">0,00 ₺</span
										>
									</div>
								</div>

								<div class="calc-actions">
									<a
										href="#"
										id="calcWhatsappBtn"
										data-phone={siteInfo.contact.whatsapp.number}
										target="_blank"
										rel="noopener noreferrer"
										class="btn-whatsapp-outline"
									>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="20"
											height="20"
											viewBox="0 0 24 24"
											fill="currentColor"
										>
											<path
												d="M19.05 4.91A10.87 10.87 0 0 0 11.4 1.75C5.46 1.75.64 6.57.64 12.5c0 1.9.49 3.75 1.43 5.38L.5 23.5l5.77-1.51a10.86 10.86 0 0 0 5.13 1.28h.01c5.93 0 10.75-4.82 10.75-10.76 0-2.87-1.12-5.58-3.11-7.6zM11.4 21.36h-.01a9.04 9.04 0 0 1-4.61-1.26l-.33-.2-3.43.9.92-3.34-.22-.35a9.07 9.07 0 0 1-1.39-4.87c0-5.01 4.08-9.08 9.09-9.08 2.43 0 4.71.94 6.42 2.66a9.04 9.04 0 0 1 2.67 6.43c0 5.01-4.08 9.08-9.08 9.08zm4.98-6.8c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47-.16-.01-.35-.01-.53-.01s-.49.07-.75.35c-.25.27-.98.96-.98 2.34s1 2.72 1.14 2.91c.14.18 1.97 3.01 4.77 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.77.11.54-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.11-.25-.18-.52-.32z"
											></path>
										</svg>
										<span
											>Bu Ölçü İçin WhatsApp Teklifi Al</span
										>
									</a>
								</div>
							</div>
						</div>
					</div>

					<!-- HESAPLAYICI ALTINDA NUMUNE TALEBİ VE TÜM ÜRÜNLER BUTONLARI -->
					<div class="bottom-actions">
						<a
							href={siteInfo.contact.phone.tel}
							class="btn-bottom btn-sample"
							title="Numune Talebi İçin Arayın"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
								></path>
							</svg>
							<span>Numune Talebi</span>
						</a>
						<a href="/parke" class="btn-bottom btn-all-products">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="3" y="3" width="7" height="7"></rect>
								<rect x="14" y="3" width="7" height="7"></rect>
								<rect x="14" y="14" width="7" height="7"></rect>
								<rect x="3" y="14" width="7" height="7"></rect>
							</svg>
							<span>Tüm Ürünler</span>
						</a>
					</div>

					<!-- PAYLAŞ BUTONLARI -->
					<div class="share-container">
						<span class="share-label">Ürünü Paylaş:</span>
						<div class="share-buttons">
							<!-- WhatsApp Paylaş -->
							<a
								href="#"
								id="shareWhatsapp"
								target="_blank"
								rel="noopener noreferrer"
								class="share-btn"
								title="WhatsApp'ta Paylaş"
								aria-label="WhatsApp'ta Paylaş"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M19.05 4.91A10.87 10.87 0 0 0 11.4 1.75C5.46 1.75.64 6.57.64 12.5c0 1.9.49 3.75 1.43 5.38L.5 23.5l5.77-1.51a10.86 10.86 0 0 0 5.13 1.28h.01c5.93 0 10.75-4.82 10.75-10.76 0-2.87-1.12-5.58-3.11-7.6zM11.4 21.36h-.01a9.04 9.04 0 0 1-4.61-1.26l-.33-.2-3.43.9.92-3.34-.22-.35a9.07 9.07 0 0 1-1.39-4.87c0-5.01 4.08-9.08 9.09-9.08 2.43 0 4.71.94 6.42 2.66a9.04 9.04 0 0 1 2.67 6.43c0 5.01-4.08 9.08-9.08 9.08zm4.98-6.8c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47-.16-.01-.35-.01-.53-.01s-.49.07-.75.35c-.25.27-.98.96-.98 2.34s1 2.72 1.14 2.91c.14.18 1.97 3.01 4.77 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.77.11.54-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.11-.25-.18-.52-.32z"
									></path>
								</svg>
							</a>

							<!-- Bağlantıyı Kopyala -->
							<button
								type="button"
								id="shareCopyBtn"
								class="share-btn"
								title="Bağlantıyı Kopyala"
								aria-label="Bağlantıyı Kopyala"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect
										x="9"
										y="9"
										width="13"
										height="13"
										rx="2"
										ry="2"></rect>
									<path
										d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
									></path>
								</svg>
								<span class="copy-tooltip" id="copyTooltip"
									>Kopyalandı!</span
								>
							</button>

							<!-- LinkedIn Paylaş -->
							<a
								href="#"
								id="shareLinkedin"
								target="_blank"
								rel="noopener noreferrer"
								class="share-btn"
								title="LinkedIn'de Paylaş"
								aria-label="LinkedIn'de Paylaş"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
									></path>
								</svg>
							</a>

							<!-- Genel Paylaşma Butonu -->
							<button
								type="button"
								id="shareNativeBtn"
								class="share-btn"
								title="Paylaş"
								aria-label="Genel Paylaşım"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="18" cy="5" r="3"></circle>
									<circle cx="6" cy="12" r="3"></circle>
									<circle cx="18" cy="19" r="3"></circle>
									<line
										x1="8.59"
										y1="13.51"
										x2="15.42"
										y2="17.49"></line>
									<line
										x1="15.41"
										y1="6.51"
										x2="8.59"
										y2="10.49"></line>
								</svg>
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FOTOĞRAF YAKINDAN İNCELEME VE İNDİRME MODAL LIGHTBOX -->
	<div
		class="photo-modal"
		id="photoModal"
		aria-hidden="true"
		role="dialog"
		aria-label="Görsel İnceleme Modalı"
	>
		<div class="photo-modal-backdrop" id="photoModalBackdrop"></div>
		<div class="photo-modal-container">
			<!-- Minimalist Üst Çubuk (Floating) -->
			<div class="photo-modal-header">
				<div class="modal-product-info">
					<span class="modal-product-title">{product.name}</span>
					{
						images.length > 1 && (
							<span class="modal-counter" id="modalCounter">
								1 / {images.length}
							</span>
						)
					}
				</div>

				<div class="modal-actions">
					<!-- İndir Butonu (Minimal Icon) -->
					<button
						type="button"
						class="modal-btn modal-download-btn"
						id="modalDownloadBtn"
						title="Görseli İndir"
						aria-label="Görseli İndir"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
					</button>

					<!-- Kapat Butonu -->
					<button
						type="button"
						class="modal-btn modal-close-btn"
						id="modalCloseBtn"
						title="Kapat (Esc)"
						aria-label="Kapat"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>

			<!-- Modal Görsel Alanı (Pan & Zoom Özellikli) -->
			<div class="photo-modal-body" id="modalBody">
				<div class="modal-canvas" id="modalCanvas">
					<img
						src={images[0]}
						alt={`${product.series} Serisi ${product.color} Renk ${product.thickness} ${product.edge} ${product.name} Laminat Parke Yüksek Çözünürlüklü Görsel`}
						id="modalImage"
						draggable="false"
					/>
				</div>

				<!-- Gezinme Okları -->
				{
					images.length > 1 && (
						<>
							<button
								type="button"
								class="modal-nav-btn modal-prev-btn"
								id="modalPrevBtn"
								aria-label="Önceki Görsel"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polyline points="15 18 9 12 15 6" />
								</svg>
							</button>
							<button
								type="button"
								class="modal-nav-btn modal-next-btn"
								id="modalNextBtn"
								aria-label="Sonraki Görsel"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polyline points="9 18 15 12 9 6" />
								</svg>
							</button>
						</>
					)
				}
			</div>

			<!-- Alt Küçük Önizleme Şeridi (Birden Fazla Görsel Varsa) -->
			{
				images.length > 1 && (
					<div class="modal-thumbnails" id="modalThumbnails">
						{images.map((imgSrc, index) => (
							<button
								type="button"
								class={`modal-thumb-btn ${index === 0 ? "active" : ""}`}
								data-thumb-index={index}
								aria-label={`Görsel ${index + 1}`}
							>
								<img
									src={imgSrc}
									alt={`${product.name} parke küçük görsel ${index + 1}`}
									loading="lazy"
									decoding="async"
								/>
							</button>
						))}
					</div>
				)
			}
		</div>
	</div>

	<!-- İndirme Bildirimi Toast -->
	<div class="download-toast" id="downloadToast" aria-live="polite">
		<div class="toast-icon">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
				<polyline points="22 4 12 14.01 9 11.01"></polyline>
			</svg>
		</div>
		<div class="toast-content">
			<span class="toast-title" id="toastTitle">Görsel İndirildi</span>
			<span class="toast-desc" id="toastDesc"
				>Yüksek çözünürlüklü görsel cihazınıza kaydedildi.</span
			>
		</div>
	</div>

	<!-- DİĞER ÜRÜNLERE GÖZ ATIN BÖLÜMÜ -->
	<section class="related-products-section">
		<div class="container">
			<div class="related-header-wrap">
				<h2 class="related-main-title">Diğer Ürünlere Göz Atın</h2>
			</div>

			<div class="product-grid-related">
				{
					otherProducts.map((item) => (
						<ProductCard product={item} />
					))
				}
			</div>
		</div>
	</section>

</Layout>

<script is:inline>
	// Toast Bildirim Sistemi
	function showDownloadToast(title, desc) {
		const toast = document.getElementById("downloadToast");
		const toastTitle = document.getElementById("toastTitle");
		const toastDesc = document.getElementById("toastDesc");
		if (!toast) return;

		if (toastTitle && title) toastTitle.textContent = title;
		if (toastDesc && desc) toastDesc.textContent = desc;

		toast.classList.add("show");
		if (window._downloadToastTimer)
			clearTimeout(window._downloadToastTimer);
		window._downloadToastTimer = setTimeout(() => {
			toast.classList.remove("show");
		}, 3500);
	}

	// Yüksek Kalitede Görsel İndirme Fonksiyonu
	async function downloadImageFile(imgUrl, fileName) {
		showDownloadToast(
			"Görsel İndiriliyor...",
			"Yüksek çözünürlüklü dosya hazırlanıyor.",
		);
		try {
			const response = await fetch(imgUrl);
			if (!response.ok) throw new Error("Dosya indirilemedi");
			const blob = await response.blob();
			const blobUrl = URL.createObjectURL(blob);
			const link = document.createElement("a");
			link.href = blobUrl;
			link.download = fileName;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
			setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
			showDownloadToast(
				"Görsel İndirildi",
				"Görsel başarıyla cihazınıza kaydedildi.",
			);
		} catch (err) {
			console.warn("Doğrudan indirme alternatifi çalıştırılıyor:", err);
			const link = document.createElement("a");
			link.href = imgUrl;
			link.download = fileName;
			link.target = "_blank";
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
			showDownloadToast(
				"Görsel Açıldı / İndirildi",
				"Görsel indirme işlemi başlatıldı.",
			);
		}
	}

	function setupProductGalleryAndModal() {
		const slider = document.getElementById("productSlider");
		if (!slider) return;

		const track = document.getElementById("sliderTrack");
		const prevBtn = document.getElementById("prevBtn");
		const nextBtn = document.getElementById("nextBtn");
		const dots = slider.querySelectorAll(".dot-btn");
		const slides = slider.querySelectorAll(".slide-item");
		const quickZoomBtn = document.getElementById("quickZoomBtn");
		const quickDownloadBtn = document.getElementById("quickDownloadBtn");

		const productName =
			slider.getAttribute("data-product-name") || "ZenFlor Parke";
		const totalSlides = slides.length;

		// Modal Elemanları
		const modal = document.getElementById("photoModal");
		const modalBackdrop = document.getElementById("photoModalBackdrop");
		const modalCloseBtn = document.getElementById("modalCloseBtn");
		const modalImage = document.getElementById("modalImage");
		const modalCanvas = document.getElementById("modalCanvas");
		const modalCounter = document.getElementById("modalCounter");
		const modalZoomInBtn = document.getElementById("modalZoomInBtn");
		const modalZoomOutBtn = document.getElementById("modalZoomOutBtn");
		const modalZoomResetBtn = document.getElementById("modalZoomResetBtn");
		const modalZoomLevel = document.getElementById("modalZoomLevel");
		const modalDownloadBtn = document.getElementById("modalDownloadBtn");
		const modalPrevBtn = document.getElementById("modalPrevBtn");
		const modalNextBtn = document.getElementById("modalNextBtn");
		const modalThumbBtns = document.querySelectorAll(".modal-thumb-btn");

		// Tüm görsel URL'lerini topla
		const imageList = [];
		slides.forEach((s) => {
			const img = s.querySelector("img");
			if (img && img.src) imageList.push(img.src);
		});

		let currentIndex = 0;

		function getOriginalFilename(url) {
			try {
				const pathname = new URL(url, window.location.origin).pathname;
				const rawName = pathname.substring(pathname.lastIndexOf("/") + 1);
				return decodeURIComponent(rawName) || "gorsel.webp";
			} catch (_) {
				const cleanUrl = url.split("?")[0].split("#")[0];
				return cleanUrl.substring(cleanUrl.lastIndexOf("/") + 1) || "gorsel.webp";
			}
		}

		// --- SLIDER FONKSİYONLARI ---
		function goToSlide(index) {
			if (index < 0) {
				currentIndex = totalSlides - 1;
			} else if (index >= totalSlides) {
				currentIndex = 0;
			} else {
				currentIndex = index;
			}

			if (track) {
				track.style.transform = `translateX(-${currentIndex * 100}%)`;
			}

			dots.forEach((dot, i) => {
				if (i === currentIndex) {
					dot.classList.add("active");
				} else {
					dot.classList.remove("active");
				}
			});
		}

		if (prevBtn) {
			prevBtn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				goToSlide(currentIndex - 1);
			});
		}

		if (nextBtn) {
			nextBtn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				goToSlide(currentIndex + 1);
			});
		}

		dots.forEach((dot) => {
			dot.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				const idx = parseInt(
					dot.getAttribute("data-dot-index") || "0",
					10,
				);
				goToSlide(idx);
			});
		});

		// Slider Üstü Hızlı Butonlar
		if (quickZoomBtn) {
			quickZoomBtn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				openModal(currentIndex);
			});
		}

		if (quickDownloadBtn) {
			quickDownloadBtn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				const currentUrl = imageList[currentIndex] || "";
				if (currentUrl) {
					const fileName = getOriginalFilename(currentUrl);
					downloadImageFile(currentUrl, fileName);
				}
			});
		}

		// Slider'a veya Görsele Tıklayınca Modalı Aç
		slides.forEach((slide) => {
			slide.addEventListener("click", (e) => {
				// Butonlara tıklanmadıysa modalı aç
				if (
					!e.target.closest(".slider-btn") &&
					!e.target.closest(".slider-action-btn")
				) {
					const idx = parseInt(
						slide.getAttribute("data-index") || "0",
						10,
					);
					openModal(idx);
				}
			});
		});

		// Touch swipe slider
		let touchStartX = 0;
		let touchEndX = 0;

		if (track) {
			track.addEventListener(
				"touchstart",
				(e) => {
					touchStartX = e.touches[0].clientX;
				},
				{ passive: true },
			);

			track.addEventListener(
				"touchend",
				(e) => {
					touchEndX = e.changedTouches[0].clientX;
					const diff = touchStartX - touchEndX;
					if (Math.abs(diff) > 45) {
						if (diff > 0) {
							goToSlide(currentIndex + 1);
						} else {
							goToSlide(currentIndex - 1);
						}
					}
				},
				{ passive: true },
			);
		}

		// --- MODAL & ZOOM / PAN FONKSİYONLARI ---
		if (!modal || !modalImage) return;

		let modalIndex = 0;
		let scale = 1;
		let panX = 0;
		let panY = 0;
		let isDragging = false;
		let dragStartX = 0;
		let dragStartY = 0;
		let initialPanX = 0;
		let initialPanY = 0;

		function updateTransform(withTransition = true) {
			if (!modalImage) return;
			modalImage.style.transition = withTransition
				? "transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)"
				: "none";

			// Pan limitlerini sınırla
			if (scale > 1 && modalCanvas) {
				const maxPanX = Math.max(
					0,
					(modalImage.offsetWidth * scale - modalCanvas.clientWidth) /
						2 +
						80,
				);
				const maxPanY = Math.max(
					0,
					(modalImage.offsetHeight * scale -
						modalCanvas.clientHeight) /
						2 +
						80,
				);
				panX = Math.max(-maxPanX, Math.min(maxPanX, panX));
				panY = Math.max(-maxPanY, Math.min(maxPanY, panY));
			} else {
				panX = 0;
				panY = 0;
			}

			modalImage.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;

			if (modalZoomLevel) {
				modalZoomLevel.textContent = `${Math.round(scale * 100)}%`;
			}

			if (modalCanvas) {
				if (scale > 1) {
					modalCanvas.style.cursor = isDragging ? "grabbing" : "grab";
					if (modalImage) modalImage.style.cursor = isDragging ? "grabbing" : "grab";
				} else {
					modalCanvas.style.cursor = "default";
					if (modalImage) modalImage.style.cursor = "zoom-in";
				}
			}
		}

		function setZoom(newScale, withTransition = true) {
			const clamped = Math.max(1, Math.min(4, newScale));
			scale = Math.round(clamped * 100) / 100;
			if (scale === 1) {
				panX = 0;
				panY = 0;
			}
			updateTransform(withTransition);
		}

		function setModalSlide(index) {
			if (index < 0) {
				modalIndex = imageList.length - 1;
			} else if (index >= imageList.length) {
				modalIndex = 0;
			} else {
				modalIndex = index;
			}

			if (imageList[modalIndex]) {
				modalImage.src = imageList[modalIndex];
			}

			if (modalCounter) {
				modalCounter.textContent = `${modalIndex + 1} / ${imageList.length}`;
			}

			modalThumbBtns.forEach((thumb, i) => {
				if (i === modalIndex) {
					thumb.classList.add("active");
					thumb.scrollIntoView({
						behavior: "smooth",
						block: "nearest",
						inline: "center",
					});
				} else {
					thumb.classList.remove("active");
				}
			});

			// Zoom sıfırla
			setZoom(1, false);
		}

		function openModal(index) {
			modalIndex = index >= 0 && index < imageList.length ? index : 0;
			modal.classList.add("open");
			modal.setAttribute("aria-hidden", "false");
			document.body.classList.add("modal-open");
			setModalSlide(modalIndex);
			window.addEventListener("keydown", handleModalKeydown);
		}

		function closeModal() {
			modal.classList.remove("open");
			modal.setAttribute("aria-hidden", "true");
			document.body.classList.remove("modal-open");
			window.removeEventListener("keydown", handleModalKeydown);
			// Slider'ı modalın son görseliyle eşitle
			goToSlide(modalIndex);
		}

		function handleModalKeydown(e) {
			if (e.key === "Escape") {
				closeModal();
			} else if (e.key === "ArrowLeft") {
				setModalSlide(modalIndex - 1);
			} else if (e.key === "ArrowRight") {
				setModalSlide(modalIndex + 1);
			} else if (e.key === "+" || e.key === "=") {
				setZoom(scale + 0.3);
			} else if (e.key === "-") {
				setZoom(scale - 0.3);
			} else if (e.key === "0") {
				setZoom(1);
			}
		}

		// Modal Kapatma
		if (modalCloseBtn) modalCloseBtn.addEventListener("click", closeModal);
		if (modalBackdrop) modalBackdrop.addEventListener("click", closeModal);

		// Arka plana veya boşluğa tıklanınca kapat (Görsel ve kontroller haricindeki her yer)
		let hasDragged = false;
		if (modal) {
			modal.addEventListener("click", (e) => {
				if (hasDragged) {
					hasDragged = false;
					return;
				}

				const isInsideInteractive = e.target.closest(
					"#modalImage, .modal-actions, .modal-nav-btn, .modal-thumbnails"
				);

				if (!isInsideInteractive) {
					closeModal();
				}
			});
		}

		// Modal Önceki / Sonraki
		if (modalPrevBtn) {
			modalPrevBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				setModalSlide(modalIndex - 1);
			});
		}

		if (modalNextBtn) {
			modalNextBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				setModalSlide(modalIndex + 1);
			});
		}

		// Modal Thumbnails
		modalThumbBtns.forEach((thumb) => {
			thumb.addEventListener("click", (e) => {
				e.stopPropagation();
				const idx = parseInt(
					thumb.getAttribute("data-thumb-index") || "0",
					10,
				);
				setModalSlide(idx);
			});
		});

		// Modal Zoom Butonları
		if (modalZoomInBtn) {
			modalZoomInBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				setZoom(scale + 0.4);
			});
		}

		if (modalZoomOutBtn) {
			modalZoomOutBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				setZoom(scale - 0.4);
			});
		}

		if (modalZoomResetBtn) {
			modalZoomResetBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				setZoom(1);
			});
		}

		// Modal İndirme Butonu
		if (modalDownloadBtn) {
			modalDownloadBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				const currentUrl = imageList[modalIndex] || "";
				if (currentUrl) {
					const fileName = getOriginalFilename(currentUrl);
					downloadImageFile(currentUrl, fileName);
				}
			});
		}

		// Modal Fare Tekerleği İle Yakınlaştırma (Smooth Wheel Zoom)
		if (modalCanvas) {
			modalCanvas.addEventListener(
				"wheel",
				(e) => {
					e.preventDefault();
					const delta = e.deltaY < 0 ? 0.25 : -0.25;
					setZoom(scale + delta);
				},
				{ passive: false },
			);

			// Çift Tıklama İle Hızlı Büyüt / Sıfırla
			modalCanvas.addEventListener("dblclick", (e) => {
				e.preventDefault();
				if (scale > 1) {
					setZoom(1);
				} else {
					setZoom(2.5);
				}
			});

			// Sürükleme / Pan Mekanizması (Mouse)
			modalCanvas.addEventListener("mousedown", (e) => {
				// Sadece sol tık
				if (e.button !== 0) return;
				hasDragged = false;
				dragStartX = e.clientX;
				dragStartY = e.clientY;
				if (scale > 1) {
					isDragging = true;
					initialPanX = panX;
					initialPanY = panY;
					updateTransform(false);
				}
			});

			window.addEventListener("mousemove", (e) => {
				if (Math.hypot(e.clientX - dragStartX, e.clientY - dragStartY) > 6) {
					hasDragged = true;
				}
				if (!isDragging || scale <= 1) return;
				const deltaX = e.clientX - dragStartX;
				const deltaY = e.clientY - dragStartY;
				panX = initialPanX + deltaX;
				panY = initialPanY + deltaY;
				updateTransform(false);
			});

			window.addEventListener("mouseup", () => {
				if (isDragging) {
					isDragging = false;
					updateTransform(true);
				}
			});

			// Dokunmatik Cihazlar (Touch Drag & Pinch Zoom)
			let touchStartDistance = 0;
			let initialScale = 1;

			modalCanvas.addEventListener(
				"touchstart",
				(e) => {
					if (e.touches.length === 1 && scale > 1) {
						isDragging = true;
						dragStartX = e.touches[0].clientX;
						dragStartY = e.touches[0].clientY;
						initialPanX = panX;
						initialPanY = panY;
					} else if (e.touches.length === 2) {
						isDragging = false;
						touchStartDistance = Math.hypot(
							e.touches[0].clientX - e.touches[1].clientX,
							e.touches[0].clientY - e.touches[1].clientY,
						);
						initialScale = scale;
					}
				},
				{ passive: true },
			);

			modalCanvas.addEventListener(
				"touchmove",
				(e) => {
					if (e.touches.length === 1 && isDragging && scale > 1) {
						const deltaX = e.touches[0].clientX - dragStartX;
						const deltaY = e.touches[0].clientY - dragStartY;
						panX = initialPanX + deltaX;
						panY = initialPanY + deltaY;
						updateTransform(false);
					} else if (
						e.touches.length === 2 &&
						touchStartDistance > 0
					) {
						const dist = Math.hypot(
							e.touches[0].clientX - e.touches[1].clientX,
							e.touches[0].clientY - e.touches[1].clientY,
						);
						const factor = dist / touchStartDistance;
						setZoom(initialScale * factor, false);
					}
				},
				{ passive: true },
			);

			modalCanvas.addEventListener(
				"touchend",
				() => {
					isDragging = false;
					touchStartDistance = 0;
					updateTransform(true);
				},
				{ passive: true },
			);
		}
	}

	function setupCalculator() {
		const areaInput = document.getElementById("calcArea");
		const outputWrapper = document.getElementById("calcOutputWrapper");
		const totalPriceEl = document.getElementById("calcTotalPrice");
		const whatsappBtn = document.getElementById("calcWhatsappBtn");

		if (!areaInput || !totalPriceEl || !outputWrapper) return;

		const unitPrice = parseFloat(
			areaInput.getAttribute("data-price") || "0",
		);
		const productName = areaInput.getAttribute("data-product-name") || "";

		function calculate() {
			const val = areaInput.value.trim();
			const area = parseFloat(val);

			if (!val || isNaN(area) || area <= 0) {
				outputWrapper.style.display = "none";
				return;
			}

			const totalCost = area * unitPrice;
			totalPriceEl.textContent =
				totalCost.toLocaleString("tr-TR", {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2,
				}) + " ₺";

			if (whatsappBtn) {
				const text = `Merhaba, ${productName} parke modeli için ${area} m² alan hesapladım. Fiyat ve montaj teklifi almak istiyorum.`;
				const waNum = whatsappBtn.getAttribute("data-phone") || "905302708487";
				whatsappBtn.href = `https://wa.me/${waNum}?text=${encodeURIComponent(text)}`;
			}

			outputWrapper.style.display = "flex";
		}

		areaInput.addEventListener("input", calculate);
		calculate();
	}

	function setupShareButtons() {
		const currentUrl = window.location.href;
		const productName =
			document.querySelector(".product-title")?.textContent ||
			"ZenFlor Parke";

		const shareWhatsapp = document.getElementById("shareWhatsapp");
		const shareLinkedin = document.getElementById("shareLinkedin");
		const shareCopyBtn = document.getElementById("shareCopyBtn");
		const copyTooltip = document.getElementById("copyTooltip");
		const shareNativeBtn = document.getElementById("shareNativeBtn");

		if (shareWhatsapp) {
			shareWhatsapp.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${productName} | ZenFlor Parke: ${currentUrl}`)}`;
		}

		if (shareLinkedin) {
			shareLinkedin.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
		}

		if (shareCopyBtn) {
			shareCopyBtn.addEventListener("click", async (e) => {
				e.preventDefault();
				try {
					await navigator.clipboard.writeText(currentUrl);
					if (copyTooltip) {
						copyTooltip.classList.add("show");
						setTimeout(
							() => copyTooltip.classList.remove("show"),
							2000,
						);
					}
				} catch (err) {
					console.error("Kopyalama hatası:", err);
				}
			});
		}

		if (shareNativeBtn) {
			shareNativeBtn.addEventListener("click", async (e) => {
				e.preventDefault();
				if (navigator.share) {
					try {
						await navigator.share({
							title: `${productName} | ZenFlor Parke`,
							text: `${productName} modelini inceleyin:`,
							url: currentUrl,
						});
					} catch (err) {
						// User cancelled
					}
				} else if (shareCopyBtn) {
					shareCopyBtn.click();
				}
			});
		}
	}

	function initAll() {
		setupProductGalleryAndModal();
		setupCalculator();
		setupShareButtons();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAll);
	} else {
		initAll();
	}
	document.addEventListener("astro:page-load", initAll);
</script>

