	<!-- DİĞER ÜRÜNLERE GÖZ ATIN BÖLÜMÜ -->
	<section class="related-products-section">
		<div class="container">
			<div class="related-header-wrap">
				<div class="section-tag">Koleksiyonu Keşfedin</div>
				<h2 class="related-main-title">Diğer Ürünlere Göz Atın</h2>
				<p class="related-sub-text">Mekanınıza en uygun rengi ve dokuyu bulabileceğiniz diğer parke modellerimiz</p>
			</div>

			<div class="product-grid-related">
				{
					otherProducts.map((item) => (
						<a href={`/parke/${item.id}`} class="product-card">
							<div class="product-img-wrapper">
								<img
									src={item.img}
									alt={item.name}
									class="primary-img"
									loading="lazy"
								/>
								{item.images && item.images[1] && (
									<img
										src={item.images[1]}
										alt={`${item.name} - Ortam Görünümü`}
										class="secondary-img"
										loading="lazy"
									/>
								)}
							</div>
							<div class="product-info">
								<h3>{item.name}</h3>
								<div class="product-desc">
									<span>{item.thickness}, {item.edge}, {item.color} Renk</span>
									<span>{item.surface}</span>
								</div>
								<div class="product-footer">
									<div class="price-box">
										<span class="price-val">
											{item.price}
										</span>
										<span class="price-unit">
											/ m²
										</span>
									</div>
									<span class="btn-review">
										<span>İncele</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<line x1="5" y1="12" x2="19" y2="12" />
											<polyline points="12 5 19 12 12 19" />
										</svg>
									</span>
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
