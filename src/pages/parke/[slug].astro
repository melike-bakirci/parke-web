								title="WhatsApp'ta Paylaş"
								aria-label="WhatsApp'ta Paylaş"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
									<path d="M19.05 4.91A10.87 10.87 0 0 0 11.4 1.75C5.46 1.75.64 6.57.64 12.5c0 1.9.49 3.75 1.43 5.38L.5 23.5l5.77-1.51a10.86 10.86 0 0 0 5.13 1.28h.01c5.93 0 10.75-4.82 10.75-10.76 0-2.87-1.12-5.58-3.11-7.6zM11.4 21.36h-.01a9.04 9.04 0 0 1-4.61-1.26l-.33-.2-3.43.9.92-3.34-.22-.35a9.07 9.07 0 0 1-1.39-4.87c0-5.01 4.08-9.08 9.09-9.08 2.43 0 4.71.94 6.42 2.66a9.04 9.04 0 0 1 2.67 6.43c0 5.01-4.08 9.08-9.08 9.08zm4.98-6.8c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47-.16-.01-.35-.01-.53-.01s-.49.07-.75.35c-.25.27-.98.96-.98 2.34s1 2.72 1.14 2.91c.14.18 1.97 3.01 4.77 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.77.11.54-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.11-.25-.18-.52-.32z"/>
								</svg>
							</a>

							<!-- Bağlantıyı Kopyala -->
							<button
								type="button"
								id="shareCopyBtn"
								class="share-btn"
								title="Bağlantıyı Kopyala"
								aria-label="Bağlantıyı Kopyala"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
