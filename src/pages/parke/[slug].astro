---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import products from "../../data/products.json";

export async function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;
const images = product.images && product.images.length > 0 ? product.images : [product.img];

// Sayısal fiyat ve paket m² hesaplama
const rawPrice = parseFloat(product.price.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
let rawPackageM2 = 1.84;
const m2Match = product.package?.match(/(\d+[.,]\d+)\s*m²/);
if (m2Match) {
	rawPackageM2 = parseFloat(m2Match[1].replace(',', '.')) || 1.84;
}

// Diğer / İlgili Ürünler (Öncelikle aynı seriden, toplam 4 ürün)
const otherProducts = products
	.filter((p) => p.id !== product.id)
	.sort((a, b) => (a.series === product.series ? -1 : 1))
	.slice(0, 4);
---

<Layout title={`${product.name} | ZenFlor Parke`}>
	<Header />

	<section class="product-detail">
		<div class="container">
			<nav class="breadcrumb" aria-label="Ekmek kırıntısı navigasyonu">
				<a href="/">Ana Sayfa</a>
				<span class="sep">/</span>
				<a href="/parke">Parke Koleksiyonu</a>
				<span class="sep">/</span>
				<span class="current">{product.name}</span>
			</nav>

			<div class="detail-layout">
				<!-- SOL SÜTUN: FOTOĞRAF SLIDER VE HEMEN ALTINDA TEKNİK ÖZELLİKLER -->
				<div class="detail-left">
					<div class="product-slider" id="productSlider" data-slide-count={images.length}>
						<div class="slider-viewport">
							<div class="slider-track" id="sliderTrack">
								{images.map((imgSrc, index) => (
									<div class="slide-item" data-index={index}>
										<img
											src={imgSrc}
											alt={`${product.name} - Görsel ${index + 1}`}
											loading={index === 0 ? "eager" : "lazy"}
										/>
									</div>
								))}
							</div>

							{images.length > 1 && (
								<>
									<button class="slider-btn prev-btn" id="prevBtn" type="button" aria-label="Önceki Görsel">
										<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="15 18 9 12 15 6"></polyline>
										</svg>
									</button>
									<button class="slider-btn next-btn" id="nextBtn" type="button" aria-label="Sonraki Görsel">
										<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="9 18 15 12 9 6"></polyline>
										</svg>
									</button>
								</>
							)}
						</div>

						{images.length > 1 && (
							<div class="slider-dots" id="sliderDots">
								{images.map((_, index) => (
									<button
										class={`dot-btn ${index === 0 ? 'active' : ''}`}
										type="button"
										data-dot-index={index}
										aria-label={`Görsel ${index + 1}'e git`}
									></button>
								))}
							</div>
						)}
					</div>

					<!-- Fotonun hemen altındaki Teknik Özellikler Bölümü -->
					<div class="specs-section">
						<h3 class="specs-title">Teknik Özellikler</h3>
						<ul class="specs-list">
							<li>
								<span class="spec-name">Renk Tonu</span>
								<span class="spec-value">{product.color}</span>
							</li>
							<li>
								<span class="spec-name">Kalınlık</span>
								<span class="spec-value">{product.thickness}</span>
							</li>
							<li>
								<span class="spec-name">Kenar Tipi</span>
								<span class="spec-value">{product.edge}</span>
							</li>
							<li>
								<span class="spec-name">Boyut (En x Boy)</span>
								<span class="spec-value">{product.width} x {product.length}</span>
							</li>
							<li>
								<span class="spec-name">Yüzey Dayanımı</span>
								<span class="spec-value">{product.surface}</span>
							</li>
							<li>
								<span class="spec-name">Paket İçeriği</span>
								<span class="spec-value">{product.package}</span>
							</li>
							<li>
								<span class="spec-name">Palet İçeriği</span>
								<span class="spec-value">{product.pallet}</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- SAĞ SÜTUN: BAŞLIK, FİYAT VE MALİYETİNİZİ HEMEN HESAPLAYIN -->
				<div class="detail-right">
					<div class="detail-header">
						<span class="series-tag">{product.series} Serisi</span>
						<h1 class="product-title">{product.name}</h1>
					</div>

					<div class="price-block">
						<div class="price-display">
							<span class="price-value">{product.price}</span>
							<span class="price-unit">/ m²</span>
						</div>
						<p class="price-disclaimer">* Belirtilen fiyatlar KDV hariç birim satış fiyatıdır.</p>
					</div>

					<!-- MALİYETİNİZİ HEMEN HESAPLAYIN BÖLÜMÜ -->
					<div class="calculator-card">
						<div class="calc-header">
							<div class="calc-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="4" y="2" width="16" height="20" rx="2"></rect>
									<line x1="8" y1="6" x2="16" y2="6"></line>
									<line x1="16" y1="14" x2="16" y2="18"></line>
									<path d="M16 10h.01"></path>
									<path d="M12 10h.01"></path>
									<path d="M8 10h.01"></path>
									<path d="M12 14h.01"></path>
									<path d="M8 14h.01"></path>
									<path d="M12 18h.01"></path>
									<path d="M8 18h.01"></path>
								</svg>
							</div>
							<div>
								<h3 class="calc-title">Maliyetinizi Hemen Hesaplayın</h3>
								<p class="calc-subtitle">Uygulanacak alanı girin, tahmini toplam maliyetinizi anında görün.</p>
							</div>
						</div>

						<div class="calc-body">
							<div class="input-group">
								<label for="calcArea" class="input-label">Uygulanacak Alan (m²)</label>
								<div class="input-wrapper">
									<input
										type="number"
										id="calcArea"
										class="area-input"
										value=""
										placeholder="Örn: 25"
										min="1"
										max="2000"
										step="1"
										data-price={rawPrice}
										data-product-name={product.name}
									/>
									<span class="input-unit">m²</span>
								</div>
							</div>

							<!-- Sadece girdi girilince görünen sonuç ve buton alanı -->
							<div class="calc-output-wrapper" id="calcOutputWrapper" style="display: none;">
								<div class="calc-results">
									<div class="result-row total-row">
										<span class="total-label">Tahmini Toplam Maliyet:</span>
										<span class="total-price" id="calcTotalPrice">0,00 ₺</span>
									</div>
								</div>

								<div class="calc-actions">
									<a
										href="#"
										id="calcWhatsappBtn"
										target="_blank"
										rel="noopener noreferrer"
										class="btn-whatsapp-outline"
									>
										<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
											<path d="M19.05 4.91A10.87 10.87 0 0 0 11.4 1.75C5.46 1.75.64 6.57.64 12.5c0 1.9.49 3.75 1.43 5.38L.5 23.5l5.77-1.51a10.86 10.86 0 0 0 5.13 1.28h.01c5.93 0 10.75-4.82 10.75-10.76 0-2.87-1.12-5.58-3.11-7.6zM11.4 21.36h-.01a9.04 9.04 0 0 1-4.61-1.26l-.33-.2-3.43.9.92-3.34-.22-.35a9.07 9.07 0 0 1-1.39-4.87c0-5.01 4.08-9.08 9.09-9.08 2.43 0 4.71.94 6.42 2.66a9.04 9.04 0 0 1 2.67 6.43c0 5.01-4.08 9.08-9.08 9.08zm4.98-6.8c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.46-.62-.47-.16-.01-.35-.01-.53-.01s-.49.07-.75.35c-.25.27-.98.96-.98 2.34s1 2.72 1.14 2.91c.14.18 1.97 3.01 4.77 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.77.11.54-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.11-.25-.18-.52-.32z"/>
										</svg>
										<span>Bu Ölçü İçin WhatsApp Teklifi Al</span>
									</a>
								</div>
							</div>
						</div>
					</div>

					<!-- HESAPLAYICI ALTINDA NUMUNE TALEBİ VE TÜM ÜRÜNLER BUTONLARI -->
					<div class="bottom-actions">
						<a href="tel:+905302708487" class="btn-bottom btn-sample" title="Numune Talebi İçin Arayın">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<span>Numune Talebi</span>
						</a>
						<a href="/parke" class="btn-bottom btn-all-products">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="3" width="7" height="7"></rect>
								<rect x="14" y="3" width="7" height="7"></rect>
								<rect x="14" y="14" width="7" height="7"></rect>
								<rect x="3" y="14" width="7" height="7"></rect>
