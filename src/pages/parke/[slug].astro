	<Footer />
</Layout>

<script is:inline>
	function setupProductSlider() {
		const slider = document.getElementById('productSlider');
		if (!slider) return;

		const track = document.getElementById('sliderTrack');
		const prevBtn = document.getElementById('prevBtn');
		const nextBtn = document.getElementById('nextBtn');
		const dots = slider.querySelectorAll('.dot-btn');
		const slides = slider.querySelectorAll('.slide-item');
		const totalSlides = slides.length;

		if (totalSlides <= 1 || !track) return;

		let currentIndex = 0;

		function goToSlide(index) {
			if (index < 0) {
				currentIndex = totalSlides - 1;
			} else if (index >= totalSlides) {
				currentIndex = 0;
			} else {
				currentIndex = index;
			}

			track.style.transform = `translateX(-${currentIndex * 100}%)`;

			dots.forEach((dot, i) => {
				if (i === currentIndex) {
					dot.classList.add('active');
				} else {
					dot.classList.remove('active');
				}
			});
		}

		prevBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			goToSlide(currentIndex - 1);
		});

		nextBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			goToSlide(currentIndex + 1);
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', (e) => {
				e.preventDefault();
				const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
				goToSlide(idx);
			});
		});

		// Touch swipe
		let startX = 0;
		let endX = 0;

		track.addEventListener('touchstart', (e) => {
			startX = e.touches[0].clientX;
		}, { passive: true });

		track.addEventListener('touchend', (e) => {
			endX = e.changedTouches[0].clientX;
			const diff = startX - endX;
			if (Math.abs(diff) > 40) {
				if (diff > 0) {
					goToSlide(currentIndex + 1);
				} else {
					goToSlide(currentIndex - 1);
				}
			}
		}, { passive: true });
	}

	function setupCalculator() {
		const areaInput = document.getElementById('calcArea');
		const outputWrapper = document.getElementById('calcOutputWrapper');
		const totalPriceEl = document.getElementById('calcTotalPrice');
		const whatsappBtn = document.getElementById('calcWhatsappBtn');

		if (!areaInput || !totalPriceEl || !outputWrapper) return;

		const unitPrice = parseFloat(areaInput.getAttribute('data-price') || '0');
		const productName = areaInput.getAttribute('data-product-name') || '';

		function calculate() {
			const val = areaInput.value.trim();
			const area = parseFloat(val);

			if (!val || isNaN(area) || area <= 0) {
				outputWrapper.style.display = 'none';
				return;
			}

			const totalCost = area * unitPrice;
			totalPriceEl.textContent = totalCost.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

			if (whatsappBtn) {
				const text = `Merhaba, ${productName} parke modeli için ${area} m² alan hesapladım. Fiyat ve montaj teklifi almak istiyorum.`;
				whatsappBtn.href = `https://wa.me/905302708487?text=${encodeURIComponent(text)}`;
			}

			outputWrapper.style.display = 'flex';
		}

		areaInput.addEventListener('input', calculate);
		calculate();
	}

	function setupShareButtons() {
		const currentUrl = window.location.href;
		const productName = document.querySelector('.product-title')?.textContent || 'ZenFlor Parke';

		const shareWhatsapp = document.getElementById('shareWhatsapp');
		const shareLinkedin = document.getElementById('shareLinkedin');
		const shareCopyBtn = document.getElementById('shareCopyBtn');
		const copyTooltip = document.getElementById('copyTooltip');
		const shareNativeBtn = document.getElementById('shareNativeBtn');

		if (shareWhatsapp) {
			shareWhatsapp.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${productName} | ZenFlor Parke: ${currentUrl}`)}`;
		}

		if (shareLinkedin) {
			shareLinkedin.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
		}

		if (shareCopyBtn) {
			shareCopyBtn.addEventListener('click', async (e) => {
				e.preventDefault();
				try {
					await navigator.clipboard.writeText(currentUrl);
					if (copyTooltip) {
						copyTooltip.classList.add('show');
						setTimeout(() => copyTooltip.classList.remove('show'), 2000);
					}
				} catch (err) {
					console.error('Kopyalama hatası:', err);
				}
			});
		}

		if (shareNativeBtn) {
			shareNativeBtn.addEventListener('click', async (e) => {
				e.preventDefault();
				if (navigator.share) {
					try {
						await navigator.share({
							title: `${productName} | ZenFlor Parke`,
							text: `${productName} modelini inceleyin:`,
							url: currentUrl,
						});
					} catch (err) {
						// User cancelled
					}
				} else if (shareCopyBtn) {
					shareCopyBtn.click();
				}
			});
		}
	}

	function initAll() {
		setupProductSlider();
		setupCalculator();
		setupShareButtons();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAll);
	} else {
		initAll();
	}
	document.addEventListener('astro:page-load', initAll);
</script>

