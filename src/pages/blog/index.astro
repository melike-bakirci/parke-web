---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const blogEntries = await getCollection("blog");
const blogs = blogEntries.map((entry) => ({
	slug: entry.id,
	title: entry.data.title,
	summary: entry.data.summary,
	image: entry.data.image,
	date: entry.data.date,
	readTime: entry.data.readTime,
}));
---

<Layout title="Parke Rehberi, Zemin Trendleri & Bakım İpuçları | ZenFlor">
	<PageHero
		title="Blog: Parke ve Zemin Hakkında Her Şey"
		subtitle="Zemin kaplama rehberi, parke, trendler ve daha fazlası."
	/>

	<section class="blog-section">
		<div class="container blog-container">
			<div class="blog-grid">
				{
					blogs.map((post) => (
						<BlogCard
							post={post}
							titleTag="h2"
							readMoreText="Oku"
						/>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.blog-section {
		padding: 90px 0;
		background: #f8fafc;
	}
	/* Default: 3 columns on desktop */
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	/* Tablet: 2 columns */
	@media (max-width: 1023px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 24px;
		}
	}
	/* Mobile: 1 column, less padding */
	@media (max-width: 639px) {
		.blog-section {
			padding: 40px 0;
		}
		.blog-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}
</style>
