---
import Layout from "../../layouts/Layout.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => {
    const otherBlogs = blogEntries.filter((b) => b.id !== entry.id).slice(0, 4).map(e => ({slug: e.id, ...e.data}));
    const allBlogs = blogEntries.map(e => ({slug: e.id, ...e.data, content: e.body}));
    return {
      params: { slug: entry.id },
      props: { entry, otherBlogs, allBlogs },
    };
  });
}

const { entry, otherBlogs = [], allBlogs = [] } = Astro.props;
const { Content } = await render(entry);
const blog = { slug: entry.id, ...entry.data };

import { siteInfo } from "../../data/siteInfo";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": blog.title,
  "image": new URL(blog.image, Astro.site ? Astro.site.origin : siteInfo.url).href,
  "description": blog.summary || blog.title,
  "author": {
    "@type": "Organization",
    "name": "ZenFlor"
  }
};
---

<Layout 
  title={blog.title}
  description={blog.summary || blog.title}
  image={blog.image}
  schema={articleSchema}
>
  <section class="blog-detail-section">
    <div class="container">
      <!-- Mini Clean Breadcrumbs (No banner, mobile-friendly) -->
      <nav class="blog-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Ana Sayfa</a>
        <span class="crumb-sep">/</span>
        <a href="/blog" class="crumb-link">Blog</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current" title={blog.title}>{blog.title}</span>
      </nav>
      
      <div class="blog-header">
        <span class="blog-date">{blog.date}</span>
        <h1 class="blog-title">{blog.title}</h1>
      </div>

      <div class="blog-layout">
        <div class="blog-main">
          <div class="blog-content-flex">
          <aside class="blog-toolbar-wrapper no-print">
            <div class="blog-toolbar">
              <button class="tool-btn" id="btn-zoom-in" title="Yazıyı Büyüt" aria-label="Yazıyı Büyüt">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
              <button class="tool-btn" id="btn-zoom-out" title="Yazıyı Küçült" aria-label="Yazıyı Küçült">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
              <button class="tool-btn" id="btn-speak" title="Sesli Dinle" aria-label="Sesli Dinle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
              </button>
              <button class="tool-btn" id="btn-print" title="Yazdır" aria-label="Yazdır">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
              </button>
              <button class="tool-btn" id="btn-share" title="Paylaş" aria-label="Paylaş">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
              </button>
            </div>
          </aside>
          
          <div class="blog-content-body">
            <img
              src={blog.image}
              alt={blog.title}
              class="blog-featured-image"
              width={1200}
              height={600}
              loading="eager"
              decoding="async"
            />
            <div class="blog-content" id="blog-content"><Content /></div>
          </div>
        </div>
      </div>

        <!-- Sidebar -->
        <aside class="blog-sidebar no-print">
          <!-- 1. Arama Kutusu Widget'ı -->
          <div class="sidebar-widget search-widget">
            <h3 class="widget-title">Yazılarda Ara</h3>
            <div class="search-form">
              <div class="search-input-wrapper">
                <input
                  type="text"
                  id="sidebarSearchInput"
                  placeholder="Yazı veya konu ara..."
                  class="search-input"
                  autocomplete="off"
                  aria-label="Yazılarda Ara"
                />
                <button
                  type="button"
                  id="sidebarClearBtn"
                  class="search-clear-btn"
                  aria-label="Aramayı Temizle"
                  style="display: none;"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </div>
              <button type="button" id="sidebarSearchBtn" class="search-btn" aria-label="Ara">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
            </div>

            <!-- Arama Yapıldığında Açılan Özel Sonuç Alanı -->
            <div class="search-results-area" id="searchResultsArea" style="display: none;">
              <div class="search-results-header">
                <span class="search-results-title">Arama Sonuçları</span>
                <span class="search-result-badge" id="searchResultBadge"></span>
              </div>

              <div class="search-results-list" id="searchResultsList">
                {allBlogs.map((b) => (
                  <a
                    href={`/blog/${b.slug}`}
                    class="search-result-item"
                    data-slug={b.slug}
                    data-title={b.title}
                    data-summary={b.summary}
                    data-content={(b.content || "").replace(/<[^>]+>/g, " ")}
                  >
                    <div class="search-item-img-wrap">
                      <img src={b.image} alt={b.title} class="search-item-img" width={150} height={150} loading="lazy" decoding="async" />
                    </div>
                    <div class="search-item-info">
                      <h4>{b.title}</h4>
                      <div class="search-item-meta">
                        <span class="search-item-date">{b.date}</span>
                        {b.slug === blog.slug && <span class="current-badge">Şu Anki Yazı</span>}
                      </div>
                    </div>
                  </a>
                ))}
              </div>

              <div class="no-search-results" id="noSearchResults" style="display: none;">
                <p>Aradığınız kritere uygun yazı bulunamadı.</p>
              </div>
            </div>
          </div>

          <!-- 2. Diğer Yazılarımız Widget'ı (Her zaman sabit kalır) -->
          <div class="sidebar-widget other-widget">
            <h3 class="widget-title">Diğer Yazılarımız</h3>
            <div class="other-blogs-list">
              {otherBlogs.map((ob) => (
                <a href={`/blog/${ob.slug}`} class="other-blog-item">
                  <div class="other-blog-img-wrap">
                    <img src={ob.image} alt={ob.title} class="other-blog-img" width={150} height={150} loading="lazy" decoding="async" />
                  </div>
                  <div class="other-blog-info">
                    <h4>{ob.title}</h4>
                    <span class="other-blog-date">{ob.date}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

</Layout>

<style is:global>
  /* =========================================
     BLOG DETAIL SECTION & BREADCRUMBS
     ========================================= */
  .blog-detail-section {
    padding: 40px 0 80px;
    background: #ffffff;
  }

  .blog-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 8px;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
  }
  .crumb-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .crumb-link:hover {
    color: var(--color-primary);
  }
  .crumb-sep {
    color: #cbd5e1;
    user-select: none;
  }
  .crumb-current {
    color: var(--color-primary);
    font-weight: 600;
    max-width: 420px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1200px;
  }
  @media (min-width: 992px) {
    .blog-layout {
      grid-template-columns: 2fr 1fr;
    }
  }
  .blog-main {
    width: 100%;
  }
  .blog-sidebar {
    width: 100%;
    position: sticky;
    top: 100px;
    height: fit-content;
  }
  .blog-header {
    text-align: left;
    margin-bottom: 2rem;
    max-width: 1200px;
  }
  .blog-date {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.75rem;
  }
  .blog-title {
    font-size: 2.35rem;
    color: var(--color-dark);
    line-height: 1.25;
    font-family: var(--font-secondary);
  }
  
  .blog-content-flex {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .blog-content-body {
    flex: 1;
    min-width: 0;
  }
  
  @media (min-width: 768px) {
    .blog-content-flex {
      flex-direction: row;
      align-items: flex-start;
      gap: 25px;
    }
    .blog-toolbar-wrapper {
      position: sticky;
      top: 100px;
      flex-shrink: 0;
    }
    .blog-toolbar {
      flex-direction: column !important;
      padding: 10px 6px !important;
      border-radius: 40px !important;
      align-items: center;
      gap: 8px;
    }
  }

  .blog-toolbar {
    display: flex;
    flex-direction: row;
    gap: 8px;
    margin-bottom: 2rem;
    background: white;
    padding: 8px 14px;
    border-radius: 40px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    width: fit-content;
  }
  
  .tool-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: #555;
    cursor: pointer;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    transition: all 0.25s ease;
    padding: 0;
  }
  
  .tool-btn:hover {
    background: rgba(42, 90, 117, 0.1);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .tool-btn.active {
    background: var(--color-primary);
    color: white;
  }
  
  .blog-featured-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 3rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    object-fit: cover;
    max-height: 500px;
  }
  
  .blog-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #444;
    transition: font-size 0.3s ease;
  }

  .blog-content a {
    text-decoration: none;
    color: var(--color-secondary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .blog-content a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }
  
  .blog-content p {
    margin-bottom: 1.5rem;
  }
  
  .blog-content h2 {
    font-family: var(--font-secondary);
    font-size: 1.8rem;
    color: var(--color-dark);
    margin: 2.5rem 0 1rem;
  }

  .feature-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--color-primary);
    border-radius: 8px;
    padding: 24px;
    margin: 2rem 0;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }

  .feature-box h4 {
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    color: var(--color-dark);
    margin-top: 0;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .feature-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-box li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 12px;
    line-height: 1.6;
    color: #475569;
  }

  .feature-box li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-primary);
    font-weight: 900;
    font-size: 1.1rem;
  }

  .feature-box li strong {
    color: var(--color-dark);
  }

  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 1.05rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-radius: 8px;
    overflow: hidden;
  }
  
  .blog-content th, .blog-content td {
    padding: 14px 18px;
    border: 1px solid #e1e8ed;
    text-align: left;
  }
  
  .blog-content th {
    background-color: var(--color-primary);
    color: white;
    font-weight: 600;
    font-family: var(--font-secondary);
  }
  
  .blog-content tr:nth-child(even) {
    background-color: #f8fafc;
  }
  
  .blog-content tr:hover {
    background-color: #f1f5f9;
  }

  /* Sidebar Styles */
  .sidebar-widget {
    background: white;
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    margin-bottom: 24px;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .widget-title {
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    color: var(--color-dark);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee;
    font-weight: 700;
  }

  .search-form {
    display: flex;
    align-items: center;
    position: relative;
    gap: 8px;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
  }

  .search-input {
    width: 100%;
    padding: 11px 34px 11px 14px;
    border: 1.5px solid #e1e8ed;
    border-radius: 8px;
    font-size: 0.92rem;
    font-family: var(--font-secondary);
    outline: none;
    transition: all 0.25s ease;
    background-color: #fcfdfe;
    color: var(--color-dark);
  }

  .search-input:focus {
    border-color: var(--color-primary);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(140, 106, 83, 0.12);
  }

  .search-clear-btn {
    position: absolute;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #e2e8f0;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .search-clear-btn:hover {
    background: #cbd5e1;
    color: var(--color-dark);
  }

  .search-btn {
    background: var(--color-primary);
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 10px 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .search-btn:hover {
    background: var(--color-dark);
    transform: translateY(-1px);
  }

  /* Arama Sonuçları Alanı (Search Widget İçinde) */
  .search-results-area {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed #e2e8f0;
  }

  .search-results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .search-results-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .search-result-badge {
    font-size: 0.76rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 2px 7px;
    border-radius: 10px;
  }

  .search-results-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 280px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .search-results-list::-webkit-scrollbar {
    width: 4px;
  }

  .search-results-list::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 4px;
  }

  .search-result-item {
    display: flex;
    gap: 10px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 6px 8px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #edf2f7;
    transition: all 0.2s ease;
  }

  .search-result-item:hover {
    background: #ffffff;
    border-color: var(--color-secondary);
    transform: translateX(3px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .search-item-img-wrap {
    width: 54px;
    height: 54px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: #edf2f7;
  }

  .search-item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-item-info {
    flex: 1;
    min-width: 0;
  }

  .search-item-info h4 {
    font-family: var(--font-secondary);
    font-size: 0.86rem;
    margin-bottom: 3px;
    line-height: 1.3;
    color: var(--color-dark);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 600;
  }

  .search-result-item:hover .search-item-info h4 {
    color: var(--color-primary);
  }

  .search-item-meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search-item-date {
    font-size: 0.74rem;
    color: var(--color-secondary);
    font-weight: 600;
  }

  .current-badge {
    font-size: 0.68rem;
    color: #64748b;
    background: #e2e8f0;
    padding: 1px 5px;
    border-radius: 4px;
    font-weight: 500;
  }

  .no-search-results {
    padding: 16px 8px;
    text-align: center;
    color: #64748b;
    font-size: 0.86rem;
  }

  /* Diğer Yazılarımız Listesi */
  .other-blogs-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .other-blog-item {
    display: flex;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 8px;
    border-radius: 8px;
    transition: all 0.25s ease;
    background: transparent;
  }

  .other-blog-item:hover {
    background: #f8fafc;
    transform: translateX(4px);
  }

  .other-blog-img-wrap {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: #edf2f7;
  }

  .other-blog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .other-blog-item:hover .other-blog-img {
    transform: scale(1.08);
  }

  .other-blog-info {
    flex: 1;
    min-width: 0;
  }

  .other-blog-info h4 {
    font-family: var(--font-secondary);
    font-size: 0.92rem;
    margin-bottom: 4px;
    line-height: 1.35;
    color: var(--color-dark);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 600;
  }

  .other-blog-item:hover h4 {
    color: var(--color-primary);
  }

  .other-blog-date {
    font-size: 0.78rem;
    color: var(--color-secondary);
    font-weight: 600;
  }

  /* Print Styles */
  @media print {
    body * {
      visibility: hidden;
    }
    .no-print {
      display: none !important;
    }
    .blog-detail-section, .blog-detail-section * {
      visibility: visible;
    }
    .blog-detail-section {
      position: absolute;
      left: 0;
      top: 0;
      padding: 0;
      background: white;
    }
    .blog-container {
      max-width: 100%;
    }
    .blog-featured-image {
      box-shadow: none;
      border-radius: 0;
      max-height: 400px;
    }
  }

  /* =========================================
     TABLET (≤ 1024px) — sidebar goes below
     ========================================= */
  @media (max-width: 1024px) {
    .blog-detail-section {
      padding: 56px 0;
    }
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .blog-sidebar {
      position: static;
    }
  }

  /* =========================================
     MOBILE (≤ 768px)
     ========================================= */
  @media (max-width: 768px) {
    .blog-detail-section {
      padding: 24px 0 48px;
    }
    .blog-breadcrumb {
      font-size: 0.82rem;
      margin-bottom: 18px;
      padding-bottom: 12px;
    }
    .crumb-current {
      max-width: 180px;
    }
    .blog-header {
      margin-bottom: 1.25rem;
    }
    .blog-title {
      font-size: 1.6rem;
      line-height: 1.3;
    }
    .blog-date {
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
    }

    /* Toolbar — horizontal pill, full width */
    .blog-toolbar-wrapper {
      width: 100%;
    }
    .blog-toolbar {
      border-radius: 12px;
      padding: 8px 12px;
      width: 100%;
      justify-content: space-around;
      box-sizing: border-box;
      flex-direction: row !important;
    }
    .tool-btn {
      width: 38px;
      height: 38px;
      padding: 0;
    }

    .blog-featured-image {
      border-radius: 8px;
      margin-bottom: 1.5rem;
      max-height: 260px;
    }

    /* Content */
    .blog-content {
      font-size: 1rem;
      line-height: 1.75;
    }
    .blog-content h2 {
      font-size: 1.35rem;
      margin: 1.75rem 0 0.75rem;
    }
    .blog-content p {
      margin-bottom: 1.1rem;
    }

    /* Tables: horizontal scroll */
    .blog-content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      font-size: 0.88rem;
      white-space: nowrap;
    }
    .blog-content th,
    .blog-content td {
      padding: 10px 12px;
    }

    /* Feature boxes */
    .feature-box {
      padding: 16px;
    }
    .feature-box h4 {
      font-size: 1.05rem;
    }

    /* Sidebar */
    .blog-sidebar {
      position: static;
    }
    .sidebar-widget {
      padding: 16px;
    }
    .widget-title {
      font-size: 1.05rem;
    }
    .other-blog-img-wrap {
      width: 60px;
      height: 60px;
    }
  }

  /* =========================================
     SMALL MOBILE (≤ 480px)
     ========================================= */
  @media (max-width: 480px) {
    .blog-detail-section {
      padding: 20px 0 40px;
    }
    .blog-breadcrumb {
      font-size: 0.78rem;
      gap: 4px 6px;
    }
    .crumb-current {
      max-width: 130px;
    }
    .blog-title {
      font-size: 1.3rem;
    }
    .blog-featured-image {
      max-height: 200px;
    }
    .blog-content {
      font-size: 0.95rem;
    }
    .blog-content h2 {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Zoom Functionality
    const content = document.getElementById('blog-content');
    const btnZoomIn = document.getElementById('btn-zoom-in');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    let currentFontSize = 1.1; // Base rem

    btnZoomIn?.addEventListener('click', () => {
      if (content && currentFontSize < 1.6) {
        currentFontSize += 0.1;
        content.style.fontSize = `${currentFontSize}rem`;
      }
    });

    btnZoomOut?.addEventListener('click', () => {
      if (content && currentFontSize > 0.9) {
        currentFontSize -= 0.1;
        content.style.fontSize = `${currentFontSize}rem`;
      }
    });

    // Print Functionality
    const btnPrint = document.getElementById('btn-print');
    btnPrint?.addEventListener('click', () => {
      window.print();
    });

    // Share Functionality
    const btnShare = document.getElementById('btn-share');
    btnShare?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href
          });
        } catch (err) {
          console.error('Share failed:', err);
        }
      } else {
        // Fallback: Copy to clipboard
        navigator.clipboard.writeText(window.location.href).then(() => {
          alert('Bağlantı kopyalandı!');
        });
      }
    });

    // Text to Speech Functionality
    const btnSpeak = document.getElementById('btn-speak');
    let isSpeaking = false;
    let utterance = null;

    btnSpeak?.addEventListener('click', () => {
      if (!('speechSynthesis' in window)) {
        alert('Tarayıcınız sesli okumayı desteklemiyor.');
        return;
      }

      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        btnSpeak.setAttribute('title', 'Sesli Dinle');
        btnSpeak.classList.remove('active');
      } else {
        const textToRead = content?.innerText || '';
        if (textToRead) {
          utterance = new SpeechSynthesisUtterance(textToRead);
          utterance.lang = 'tr-TR';
          utterance.rate = 1;
          
          utterance.onend = () => {
            isSpeaking = false;
            btnSpeak.setAttribute('title', 'Sesli Dinle');
            btnSpeak.classList.remove('active');
          };

          window.speechSynthesis.speak(utterance);
          isSpeaking = true;
          btnSpeak.setAttribute('title', 'Durdur');
          btnSpeak.classList.add('active');
        }
      }
    });

    // Stop speaking when leaving page
    window.addEventListener('beforeunload', () => {
      if (window.speechSynthesis) {
        window.speechSynthesis.cancel();
      }
    });

    // Sidebar Arama Alanı (Sidebar Dedicated Search Area)
    const sidebarSearchInput = document.getElementById('sidebarSearchInput') as HTMLInputElement | null;
    const sidebarClearBtn = document.getElementById('sidebarClearBtn') as HTMLButtonElement | null;
    const sidebarSearchBtn = document.getElementById('sidebarSearchBtn') as HTMLButtonElement | null;
    const searchResultsArea = document.getElementById('searchResultsArea') as HTMLElement | null;
    const searchResultBadge = document.getElementById('searchResultBadge') as HTMLElement | null;
    const noSearchResults = document.getElementById('noSearchResults') as HTMLElement | null;
    const searchResultsList = document.getElementById('searchResultsList') as HTMLElement | null;
    
    const searchItems = searchResultsList ? Array.from(searchResultsList.querySelectorAll<HTMLElement>('.search-result-item')) : [];

    function normalizeText(str: string): string {
      if (!str) return "";
      return str
        .trim()
        .replace(/İ/g, "i")
        .replace(/I/g, "i")
        .replace(/ı/g, "i")
        .toLocaleLowerCase("tr-TR")
        .replace(/ı/g, "i")
        .replace(/ğ/g, "g")
        .replace(/ü/g, "u")
        .replace(/ş/g, "s")
        .replace(/ö/g, "o")
        .replace(/ç/g, "c");
    }

    function performSidebarSearch() {
      const query = normalizeText(sidebarSearchInput?.value || "");

      if (sidebarClearBtn) {
        sidebarClearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
      }

      if (!query) {
        if (searchResultsArea) searchResultsArea.style.display = 'none';
        return;
      }

      if (searchResultsArea) searchResultsArea.style.display = 'block';

      let matchCount = 0;
      searchItems.forEach(item => {
        const title = normalizeText(item.getAttribute('data-title') || '');
        const summary = normalizeText(item.getAttribute('data-summary') || '');
        const itemContent = normalizeText(item.getAttribute('data-content') || '');

        const isMatch = title.includes(query) || summary.includes(query) || itemContent.includes(query);

        if (isMatch) {
          item.style.display = 'flex';
          matchCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (searchResultBadge) {
        searchResultBadge.textContent = `${matchCount} yazı`;
      }

      if (noSearchResults && searchResultsList) {
        if (matchCount === 0) {
          noSearchResults.style.display = 'block';
          searchResultsList.style.display = 'none';
        } else {
          noSearchResults.style.display = 'none';
          searchResultsList.style.display = 'flex';
        }
      }
    }

    function clearSidebarSearch() {
      if (sidebarSearchInput) {
        sidebarSearchInput.value = "";
        sidebarSearchInput.focus();
      }
      performSidebarSearch();
    }

    sidebarSearchInput?.addEventListener('input', performSidebarSearch);
    sidebarSearchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        clearSidebarSearch();
      }
    });

    sidebarSearchBtn?.addEventListener('click', () => {
      sidebarSearchInput?.focus();
      performSidebarSearch();
    });

    sidebarClearBtn?.addEventListener('click', clearSidebarSearch);
  });
</script>
