---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";

// Placeholder product data for the catalog
const products = [
	{
		id: 1,
		name: "Naturesville - Series 110",
		category: "Masif Parke",
		color: "Açık Meşe",
		price: "$14",
		img: "/images/collection-1.jpg",
	},
	{
		id: 2,
		name: "Walnut Dark Series 400",
		category: "Lamine Parke",
		color: "Koyu Ceviz",
		price: "$21",
		img: "/images/collection-2.jpg",
	},
	{
		id: 3,
		name: "Nordic Ash - Classic",
		category: "Masif Parke",
		color: "Kül Rengi",
		price: "$18",
		img: "/images/collection-1.jpg",
	},
	{
		id: 4,
		name: "Vintage Pine Series",
		category: "Lamine Parke",
		color: "Çam",
		price: "$16",
		img: "/images/collection-2.jpg",
	},
	{
		id: 5,
		name: "Royal Mahogany",
		category: "Vinil",
		color: "Kızıl Kahve",
		price: "$25",
		img: "/images/collection-1.jpg",
	},
	{
		id: 6,
		name: "Rustic Hickory 200",
		category: "Lamine Parke",
		color: "Doğal",
		price: "$19",
		img: "/images/collection-2.jpg",
	},
];
---

<Layout title="Parke Koleksiyonlarımız - Woodcove Flooring">
	<Header />
	<PageHero
		title="Parke Koleksiyonlarımız"
		subtitle="Her tarza ve ihtiyaca uygun birinci sınıf parke çeşitlerimizi keşfedin."
	/>

	<section class="catalog-section">
		<div class="container catalog-container">
			<!-- Sidebar Filters -->
			<aside class="sidebar-filters">
				<div class="filter-group">
					<h3>Kategoriler</h3>
					<ul>
						<li>
							<label
								><input type="checkbox" checked /> Lamine Parke <span
									>(12)</span
								></label>
						</li>
						<li>
							<label
								><input type="checkbox" /> Masif Parke <span
									>(8)</span
								></label>
						</li>
						<li>
							<label
								><input type="checkbox" /> Vinil <span
									>(15)</span
								></label>
						</li>
						<li>
							<label
								><input type="checkbox" /> Aksesuarlar <span
									>(24)</span
								></label>
						</li>
					</ul>
				</div>

				<div class="filter-group">
					<h3>Renkler</h3>
					<div class="color-options">
						<button
							class="color-btn"
							style="background-color: #D2B48C;"
							title="Açık Meşe"></button>
						<button
							class="color-btn active"
							style="background-color: #5C4033;"
							title="Koyu Ceviz"></button>
						<button
							class="color-btn"
							style="background-color: #A9A9A9;"
							title="Gri/Kül"></button>
						<button
							class="color-btn"
							style="background-color: #8B4513;"
							title="Kızıl Kahve"></button>
						<button
							class="color-btn"
							style="background-color: #F5DEB3;"
							title="Açık Çam"></button>
					</div>
				</div>

				<div class="filter-group">
					<h3>Fiyat Aralığı</h3>
					<input
						type="range"
						min="10"
						max="100"
						value="50"
						class="price-slider"
					/>
					<div class="price-labels">
						<span>$10</span>
						<span>$50+</span>
					</div>
				</div>

				<button class="btn-primary reset-btn">Filtreleri Temizle</button
				>
			</aside>

			<!-- Product List Area -->
			<div class="catalog-content">
				<!-- Top Bar: Sort & Count -->
				<div class="catalog-topbar">
					<div class="result-count">
						<strong>6</strong> ürün gösteriliyor
					</div>
					<div class="sort-by">
						<label for="sort">Sırala:</label>
						<select id="sort">
							<option>En Yeniler</option>
							<option>Fiyata Göre Artan</option>
							<option>Fiyata Göre Azalan</option>
							<option>Popülerlik</option>
						</select>
					</div>
				</div>

				<!-- Product Grid -->
				<div class="product-grid">
					{
						products.map((product) => (
							<div class="product-card">
								<div class="product-img-wrapper">
									<img src={product.img} alt={product.name} />
									<span class="product-badge">Yeni</span>
								</div>
								<div class="product-info">
									<span class="product-category">
										{product.category} &bull;{" "}
										{product.color}
									</span>
									<h3>{product.name}</h3>
									<div class="product-footer">
										<span class="product-price">
											{product.price} <small>/ m²</small>
										</span>
										<a
											href="tel:+905302708487"
											class="product-quote-btn"
											title="Teklif Alın"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="14"
												height="14"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
											</svg>
											Teklif Alın
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>

				<!-- Pagination -->
				<div class="pagination">
					<button class="page-btn active">1</button>
					<button class="page-btn">2</button>
					<button class="page-btn">3</button>
					<button class="page-btn next">&rarr;</button>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.catalog-section {
		padding: 80px 0;
		background: #fcfcfc;
	}
	.catalog-container {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	@media (min-width: 1024px) {
		.catalog-container {
			flex-direction: row;
			align-items: flex-start;
		}
	}

	/* Sidebar Filters */
	.sidebar-filters {
		width: 100%;
		background: #fff;
		padding: 30px;
		border-radius: 8px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
	}
	@media (min-width: 1024px) {
		.sidebar-filters {
			width: 280px;
			flex-shrink: 0;
		}
	}
	.filter-group {
		margin-bottom: 30px;
		padding-bottom: 20px;
		border-bottom: 1px solid #eee;
	}
	.filter-group h3 {
		font-size: 1.1rem;
		margin-bottom: 15px;
		color: var(--color-primary);
	}
	.filter-group ul {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.filter-group label {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.95rem;
		color: #555;
		cursor: pointer;
	}
	.filter-group label span {
		margin-left: auto;
		color: #999;
		font-size: 0.85rem;
	}
	.color-options {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.color-btn {
		width: 35px;
		height: 35px;
		border-radius: 50%;
		border: 2px solid #fff;
		box-shadow: 0 0 0 1px #ddd;
		cursor: pointer;
		transition: transform 0.2s;
	}
	.color-btn.active,
	.color-btn:hover {
		box-shadow: 0 0 0 2px var(--color-primary);
		transform: scale(1.1);
	}
	.price-slider {
		width: 100%;
		margin-bottom: 10px;
	}
	.price-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
		color: #666;
		font-weight: 600;
	}
	.reset-btn {
		width: 100%;
		background: #f0f0f0;
		color: #333;
	}
	.reset-btn:hover {
		background: #e0e0e0;
		color: #111;
	}

	/* Catalog Content */
	.catalog-content {
		flex: 1;
		width: 100%;
	}
	.catalog-topbar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		padding: 15px 25px;
		border-radius: 8px;
		margin-bottom: 30px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
	}
	.result-count {
		color: #666;
		font-size: 0.95rem;
	}
	.result-count strong {
		color: var(--color-primary);
	}
	.sort-by {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.95rem;
		color: #555;
	}
	.sort-by select {
		padding: 8px 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
		outline: none;
		font-family: var(--font-secondary);
	}

	/* Product Grid */
	.product-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 30px;
		margin-bottom: 40px;
	}
	@media (min-width: 640px) {
		.product-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1200px) {
		.product-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.product-card {
		background: #fff;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
		transition:
			transform 0.3s,
			box-shadow 0.3s;
		display: flex;
		flex-direction: column;
	}
	.product-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
	}
	.product-img-wrapper {
		position: relative;
		height: 220px;
		overflow: hidden;
	}
	.product-img-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s;
	}
	.product-card:hover .product-img-wrapper img {
		transform: scale(1.05);
	}
	.product-badge {
		position: absolute;
		top: 15px;
		left: 15px;
		background: var(--color-secondary);
		color: #fff;
		font-size: 0.75rem;
		font-weight: bold;
		padding: 4px 10px;
		border-radius: 4px;
		text-transform: uppercase;
	}
	.product-info {
		padding: 20px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.product-category {
		font-size: 0.8rem;
		color: #888;
		margin-bottom: 8px;
		font-weight: 600;
	}
	.product-info h3 {
		font-size: 1.15rem;
		margin-bottom: 15px;
		line-height: 1.4;
		flex: 1;
	}
	.product-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 15px;
		border-top: 1px solid #f0f0f0;
	}
	.product-price {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
	}
	.product-price small {
		font-size: 0.8rem;
		color: #888;
		font-weight: 400;
	}
	.product-quote-btn {
		background: var(--color-primary);
		color: #fff;
		text-decoration: none;
		padding: 6px 14px;
		border-radius: 20px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.85rem;
		font-weight: 500;
		transition: background 0.3s;
	}
	.product-quote-btn:hover {
		background: var(--color-secondary);
	}

	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		gap: 10px;
	}
	.page-btn {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		border: 1px solid #ddd;
		border-radius: 4px;
		cursor: pointer;
		font-weight: 600;
		color: #555;
		transition: all 0.2s;
	}
	.page-btn.active,
	.page-btn:hover {
		background: var(--color-primary);
		color: #fff;
		border-color: var(--color-primary);
	}
</style>
