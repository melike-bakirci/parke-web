---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";

import productsRaw from "../data/products.json";

// Standart (varsayılan) sıralama: Fiyata göre artan
const products = [...productsRaw].sort((a, b) => {
	const priceA = parseFloat(a.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
	const priceB = parseFloat(b.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
	return priceA - priceB;
});
---

<Layout title="Parke Koleksiyonları, Lamine & Masif Çeşitleri | ZenFlor">
	<Header />
	<PageHero
		title="Parke Koleksiyonumuz"
		subtitle="Her tarza ve ihtiyaca uygun birinci sınıf parke çeşitlerimizi keşfedin."
	/>

	<section class="catalog-section" id="catalogSection">
		<div class="container catalog-container">
			<!-- Sidebar Filters -->
			<aside class="sidebar-filters">
				<div class="sidebar-header">
					<div class="sidebar-title-wrap">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="19"
							height="19"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="4" y1="21" x2="4" y2="14"></line>
							<line x1="4" y1="10" x2="4" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12" y2="3"></line>
							<line x1="20" y1="21" x2="20" y2="16"></line>
							<line x1="20" y1="12" x2="20" y2="3"></line>
							<line x1="1" y1="14" x2="7" y2="14"></line>
							<line x1="9" y1="8" x2="15" y2="8"></line>
							<line x1="17" y1="16" x2="23" y2="16"></line>
						</svg>
						<h2>Filtreler</h2>
					</div>
				</div>

				<div class="filter-group">
					<h3>Seriler</h3>
					<ul>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Platinum" />
								<span>Platinum</span>
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Modern Long" />
								<span>Modern Long</span>
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Modern" />
								<span>Modern</span>
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Klasik" />
								<span>Klasik</span>
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Silver" />
								<span>Silver</span>
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" class="category-filter" value="Gloria" />
								<span>Gloria</span>
							</label>
						</li>
					</ul>
				</div>

				<div class="filter-group">
					<h3>Renkler</h3>
					<div class="color-list">
						<label class="color-item">
							<input type="checkbox" class="color-filter" value="Açık" />
							<span class="color-swatch-dot" style="background-color: #E8D3A7;"></span>
							<span class="color-text">Açık</span>
						</label>
						<label class="color-item">
							<input type="checkbox" class="color-filter" value="Orta" />
							<span class="color-swatch-dot" style="background-color: #D2B48C;"></span>
							<span class="color-text">Orta</span>
						</label>
						<label class="color-item">
							<input type="checkbox" class="color-filter" value="Koyu" />
							<span class="color-swatch-dot" style="background-color: #5C4033;"></span>
							<span class="color-text">Koyu</span>
						</label>
					</div>
				</div>

				<div class="filter-group">
					<h3>Fiyat Aralığı</h3>
					<div class="price-inputs-container">
						<div class="price-input-field">
							<label for="minPriceInput">Min (₺)</label>
							<div class="price-input-box">
								<span class="currency-sign">₺</span>
								<input
									type="number"
									id="minPriceInput"
									placeholder="400"
									min="0"
									step="10"
									aria-label="Minimum Fiyat"
								/>
							</div>
						</div>
						<span class="price-range-sep">-</span>
						<div class="price-input-field">
							<label for="maxPriceInput">Max (₺)</label>
							<div class="price-input-box">
								<span class="currency-sign">₺</span>
								<input
									type="number"
									id="maxPriceInput"
									placeholder="900"
									min="0"
									step="10"
									aria-label="Maksimum Fiyat"
								/>
							</div>
						</div>
					</div>
					<button type="button" id="applyPriceBtn" class="btn-apply-price">
						Fiyat Uygula
					</button>
				</div>

				<button type="button" class="btn-primary reset-btn" id="resetFiltersBtn">Filtreleri Temizle</button>
			</aside>

			<!-- Product List Area -->
			<div class="catalog-content">
				<!-- Top Bar: Search, Count & Sort -->
				<div class="catalog-topbar">
					<div class="catalog-search">
						<div class="search-input-wrap">
							<input
								type="text"
								id="productSearchInput"
								placeholder="Parke modellerinde ara..."
								autocomplete="off"
								aria-label="Parke modellerinde ara"
							/>
							<button id="productSearchBtn" class="search-btn" type="button" aria-label="Ara">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="11" cy="11" r="8"></circle>
									<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
								</svg>
								<span>Ara</span>
							</button>
						</div>
					</div>

					<div class="catalog-controls">
						<div class="sort-by">
							<label for="sort">Sırala:</label>
							<select id="sort">
								<option value="price-asc" selected>Fiyata Göre Artan</option>
								<option value="price-desc">Fiyata Göre Azalan</option>
								<option value="name-asc">A'dan Z'ye</option>
								<option value="name-desc">Z'den A'ya</option>
							</select>
						</div>
						<div class="result-count">
							<strong id="productCount">{products.length}</strong> farklı ürün
						</div>
					</div>
				</div>

				<!-- Arama Sonucu Bulunamadı Mesajı -->
				<div id="noResultsMessage" class="no-results" style="display: none;">
					<p>Aradığınız filtreleme kriterine uygun ürün bulunamadı. Lütfen filtrelerinizi kontrol edin veya temizleyin.</p>
				</div>

				<!-- Product Grid -->
				<div class="product-grid" id="productGrid">
					{
						products.map((product, idx) => {
							const numericPrice = parseFloat(product.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
							const isInitiallyVisible = idx < 12;
							return (
								<a 
									href={`/parke/${product.id}`}
									class="product-card" 
									data-name={product.name} 
									data-desc={product.surface}
									data-category={product.series}
									data-color={product.color}
									data-price={numericPrice}
									style={isInitiallyVisible ? "display: flex;" : "display: none;"}
								>
									<div class="product-img-wrapper">
										<img
											src={product.img}
											alt={product.name}
											class="primary-img"
											loading="lazy"
										/>
										{product.images && product.images[1] && (
											<img
												src={product.images[1]}
												alt={`${product.name} - Ortam Görünümü`}
												class="secondary-img"
												loading="lazy"
											/>
										)}
									</div>
									<div class="product-info">
										<h3>{product.name}</h3>
										<p
											class="product-desc"
											title={product.surface}
										>
											{product.surface}
										</p>
										<div class="product-footer">
											<div class="price-box">
												<span class="price-val">
													{product.price}
												</span>
												<span class="price-unit">
													/ m²
												</span>
											</div>
											<span class="btn-review">
												<span>İncele</span>
												<svg
													xmlns="http://www.w3.org/2000/svg"
													width="16"
													height="16"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												>
													<line
														x1="5"
														y1="12"
														x2="19"
														y2="12"
													/>
													<polyline points="12 5 19 12 12 19" />
												</svg>
											</span>
										</div>
									</div>
								</a>
							);
						})
					}
				</div>

				<!-- Pagination -->
				<div class="pagination" id="catalogPagination">
					<button class="page-btn prev-btn" id="prevPageBtn" disabled aria-label="Önceki Sayfa">&larr;</button>
					{
						Array.from({ length: Math.ceil(products.length / 12) }).map((_, i) => (
							<button class={`page-btn page-num-btn ${i === 0 ? "active" : ""}`} data-page={i + 1}>{i + 1}</button>
						))
					}
					<button class="page-btn next-btn" id="nextPageBtn" aria-label="Sonraki Sayfa">&rarr;</button>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<script>
	const sortSelect = document.getElementById("sort") as HTMLSelectElement | null;
	const productGrid = document.getElementById("productGrid");
	const searchInput = document.getElementById("productSearchInput") as HTMLInputElement | null;
	const searchBtn = document.getElementById("productSearchBtn");
	const countDisplay = document.getElementById("productCount");
	const noResultsMsg = document.getElementById("noResultsMessage");
	const paginationContainer = document.getElementById("catalogPagination");
	const prevBtn = document.getElementById("prevPageBtn") as HTMLButtonElement | null;
	const nextBtn = document.getElementById("nextPageBtn") as HTMLButtonElement | null;
	const pageNumBtns = document.querySelectorAll<HTMLButtonElement>(".page-num-btn");
	const catalogSection = document.getElementById("catalogSection");

	const categoryCheckboxes = document.querySelectorAll<HTMLInputElement>(".category-filter");
	const colorCheckboxes = document.querySelectorAll<HTMLInputElement>(".color-filter");
	const minPriceInput = document.getElementById("minPriceInput") as HTMLInputElement | null;
	const maxPriceInput = document.getElementById("maxPriceInput") as HTMLInputElement | null;
	const applyPriceBtn = document.getElementById("applyPriceBtn") as HTMLButtonElement | null;
	const resetFiltersBtn = document.getElementById("resetFiltersBtn") as HTMLButtonElement | null;

	const ITEMS_PER_PAGE = 12;
	let currentPage = 1;
	let appliedMinPrice: number | null = null;
	let appliedMaxPrice: number | null = null;

	function getFilteredAndSortedCards(): HTMLElement[] {
		if (!productGrid) return [];
		const query = (searchInput?.value || "").trim().toLocaleLowerCase("tr");
		const sortValue = sortSelect?.value || "price-asc";

		const selectedCategories = Array.from(categoryCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value.toLocaleLowerCase("tr"));

		const selectedColors = Array.from(colorCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value.toLocaleLowerCase("tr"));

		const cards = Array.from(productGrid.querySelectorAll<HTMLElement>(".product-card"));

		// Filter
		const matchingCards = cards.filter((card) => {
			const name = (card.getAttribute("data-name") || "").toLocaleLowerCase("tr");
			const desc = (card.getAttribute("data-desc") || "").toLocaleLowerCase("tr");
			const category = (card.getAttribute("data-category") || "").toLocaleLowerCase("tr");
			const color = (card.getAttribute("data-color") || "").toLocaleLowerCase("tr");
			const price = parseFloat(card.getAttribute("data-price") || "0");

			// Search text filter
			if (query && !name.includes(query) && !desc.includes(query) && !category.includes(query) && !color.includes(query)) {
				return false;
			}

			// Category filter
			if (selectedCategories.length > 0 && !selectedCategories.includes(category)) {
				return false;
			}

			// Color filter
			if (selectedColors.length > 0 && !selectedColors.includes(color)) {
				return false;
			}

			// Min price filter
			if (appliedMinPrice !== null && price < appliedMinPrice) {
				return false;
			}

			// Max price filter
			if (appliedMaxPrice !== null && price > appliedMaxPrice) {
				return false;
			}

			return true;
		});

		// Sort
		matchingCards.sort((a, b) => {
			const nameA = a.getAttribute("data-name") || "";
			const nameB = b.getAttribute("data-name") || "";
			const priceA = parseFloat(a.getAttribute("data-price") || "0");
			const priceB = parseFloat(b.getAttribute("data-price") || "0");

			switch (sortValue) {
				case "price-asc":
					return priceA - priceB;
				case "price-desc":
					return priceB - priceA;
				case "name-asc":
					return nameA.localeCompare(nameB, "tr");
				case "name-desc":
					return nameB.localeCompare(nameA, "tr");
				default:
					return 0;
			}
		});

		// Reorder in DOM
		matchingCards.forEach((card) => productGrid.appendChild(card));

		return matchingCards;
	}

	function renderCurrentPage(scrollToTop = false) {
		if (!productGrid) return;
		const matchingCards = getFilteredAndSortedCards();
		const allCards = Array.from(productGrid.querySelectorAll<HTMLElement>(".product-card"));
		const totalMatching = matchingCards.length;
		const totalPages = Math.max(1, Math.ceil(totalMatching / ITEMS_PER_PAGE));

		if (currentPage > totalPages) {
			currentPage = 1;
		}

		const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
		const endIndex = startIndex + ITEMS_PER_PAGE;

		// Hide all cards first
		allCards.forEach((card) => {
			card.style.display = "none";
		});

		// Show only current page matching cards
		matchingCards.slice(startIndex, endIndex).forEach((card) => {
			card.style.display = "flex";
		});

		// Update count display
		if (countDisplay) {
			countDisplay.textContent = totalMatching.toString();
		}

		// Update no results message
		if (noResultsMsg) {
			noResultsMsg.style.display = totalMatching === 0 ? "block" : "none";
		}

		// Update pagination UI
		if (paginationContainer) {
			if (totalMatching <= ITEMS_PER_PAGE) {
				pageNumBtns.forEach((btn) => {
					const page = parseInt(btn.getAttribute("data-page") || "1", 10);
					btn.style.display = page === 1 ? "flex" : "none";
					if (page === 1) btn.classList.add("active");
				});
				if (prevBtn) prevBtn.disabled = true;
				if (nextBtn) nextBtn.disabled = true;
			} else {
				pageNumBtns.forEach((btn) => {
					const page = parseInt(btn.getAttribute("data-page") || "1", 10);
					if (page <= totalPages) {
						btn.style.display = "flex";
						if (page === currentPage) {
							btn.classList.add("active");
						} else {
							btn.classList.remove("active");
						}
					} else {
						btn.style.display = "none";
					}
				});
				if (prevBtn) prevBtn.disabled = currentPage === 1;
				if (nextBtn) nextBtn.disabled = currentPage === totalPages;
			}
		}

		if (scrollToTop && catalogSection) {
			const rect = catalogSection.getBoundingClientRect();
			if (rect.top < 0) {
				catalogSection.scrollIntoView({ behavior: "smooth" });
			}
		}
	}

	// Pagination button events
	pageNumBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const page = parseInt(btn.getAttribute("data-page") || "1", 10);
			if (currentPage !== page) {
				currentPage = page;
				renderCurrentPage(true);
			}
		});
	});

	prevBtn?.addEventListener("click", () => {
		if (currentPage > 1) {
			currentPage--;
			renderCurrentPage(true);
		}
	});

	nextBtn?.addEventListener("click", () => {
		const totalMatching = getFilteredAndSortedCards().length;
		const totalPages = Math.max(1, Math.ceil(totalMatching / ITEMS_PER_PAGE));
		if (currentPage < totalPages) {
			currentPage++;
			renderCurrentPage(true);
		}
	});

	// Price Apply Button & Enter Key
	function applyPriceFilter() {
		const minVal = minPriceInput?.value.trim();
		const maxVal = maxPriceInput?.value.trim();
		appliedMinPrice = minVal ? parseFloat(minVal) : null;
		appliedMaxPrice = maxVal ? parseFloat(maxVal) : null;
		currentPage = 1;
		renderCurrentPage(false);
	}

	applyPriceBtn?.addEventListener("click", applyPriceFilter);

	[minPriceInput, maxPriceInput].forEach((input) => {
		input?.addEventListener("keydown", (e) => {
			if (e.key === "Enter") {
				e.preventDefault();
				applyPriceFilter();
			}
		});
	});

	// Category and Color Checkboxes
	categoryCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	colorCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	// Reset / Clear Filters
	function resetFilters() {
		if (searchInput) searchInput.value = "";
		if (minPriceInput) minPriceInput.value = "";
		if (maxPriceInput) maxPriceInput.value = "";
		appliedMinPrice = null;
		appliedMaxPrice = null;
		categoryCheckboxes.forEach((cb) => (cb.checked = false));
		colorCheckboxes.forEach((cb) => (cb.checked = false));
		if (sortSelect) sortSelect.value = "price-asc";
		currentPage = 1;
		renderCurrentPage(false);
	}

	resetFiltersBtn?.addEventListener("click", resetFilters);

	// Filter & Sort events
	searchBtn?.addEventListener("click", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});

	searchInput?.addEventListener("input", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});

	searchInput?.addEventListener("keydown", (e) => {
		if (e.key === "Enter") {
			e.preventDefault();
			currentPage = 1;
			renderCurrentPage(false);
		}
	});

	sortSelect?.addEventListener("change", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});
</script>

<style>
	.catalog-section {
		padding: 80px 0;
		background: #fcfcfc;
	}
	.catalog-container {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	@media (min-width: 1024px) {
		.catalog-container {
			flex-direction: row;
			align-items: flex-start;
		}
	}

	/* Sidebar Filters */
	.sidebar-filters {
		width: 100%;
		background: #fff;
		padding: 26px;
		border-radius: 10px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
		border: 1px solid #edf2f7;
	}
	@media (min-width: 1024px) {
		.sidebar-filters {
			width: 290px;
			flex-shrink: 0;
			position: sticky;
			top: 90px;
		}
	}

	/* Sidebar Header */
	.sidebar-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 18px;
		margin-bottom: 22px;
		border-bottom: 2px solid #f1f5f9;
	}
	.sidebar-title-wrap {
		display: flex;
		align-items: center;
		gap: 9px;
		color: var(--color-primary);
	}
	.sidebar-title-wrap svg {
		color: var(--color-secondary);
	}
	.sidebar-title-wrap h2 {
		font-size: 1.25rem;
		font-weight: 700;
		font-family: var(--font-primary);
		color: var(--color-primary);
		margin: 0;
	}

	/* Filter Groups */
	.filter-group {
		margin-bottom: 24px;
		padding-bottom: 20px;
		border-bottom: 1px solid #f1f5f9;
	}
	.filter-group:last-of-type {
		border-bottom: none;
		margin-bottom: 20px;
		padding-bottom: 0;
	}
	.filter-group h3 {
		font-size: 0.98rem;
		font-weight: 700;
		margin-bottom: 14px;
		color: var(--color-primary);
		font-family: var(--font-primary);
		letter-spacing: 0.2px;
	}
	.filter-group ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.filter-group label {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.92rem;
		color: #475569;
		cursor: pointer;
		transition: color 0.15s ease;
	}
	.filter-group label:hover {
		color: var(--color-primary);
	}
	.filter-group input[type="checkbox"] {
		width: 17px;
		height: 17px;
		accent-color: var(--color-primary);
		cursor: pointer;
		border-radius: 4px;
	}
	.count-badge {
		margin-left: auto;
		color: #94a3b8;
		font-size: 0.82rem;
		font-weight: 500;
	}

	/* Written Color Options */
	.color-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.color-item {
		display: flex;
		align-items: center;
		gap: 10px;
		cursor: pointer;
		padding: 4px 6px;
		border-radius: 6px;
		transition: background-color 0.15s ease;
	}
	.color-item:hover {
		background-color: #f8fafc;
	}
	.color-swatch-dot {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		flex-shrink: 0;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15), inset 0 1px 2px rgba(0, 0, 0, 0.1);
	}
	.color-text {
		font-size: 0.92rem;
		color: #475569;
		font-weight: 500;
	}

	/* Min-Max Price Inputs */
	.price-inputs-container {
		display: flex;
		align-items: center;
