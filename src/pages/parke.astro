---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ProductCard from "../components/ProductCard.astro";

import productsRaw from "../data/products.json";

// Standart (varsayılan) sıralama: Fiyata göre artan
const products = [...productsRaw].sort((a, b) => {
	const priceA =
		parseFloat(a.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
	const priceB =
		parseFloat(b.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0;
	return priceA - priceB;
});

const numericPrices = products.map(
	(p) => parseFloat(p.price.replace(/[^\d,]/g, "").replace(",", ".")) || 0,
);
const minProductPrice = Math.min(...numericPrices);
const maxProductPrice = Math.max(...numericPrices);
---

<Layout
	title="Laminat Parke Modelleri | En Ucuz Fiyatlar"
	description="Her bütçeye uygun parke çeşitleri ZenFlor koleksiyonlarında! Sancaktepe mağazamızdan tüm Türkiye'ye gönderim sağladığımız parkeleri inceleyin."
	keywords="en ucuz parke modelleri, uygun fiyatlı parke, lamine parke, laminat parke, masif parke, sancaktepe parke çeşitleri, sarıgazi parkeci, tüm türkiye parke kargo, ucuz laminat"
	image="/images/platinum/platinum-amasra-mese-2108-1.webp"
>
	<PageHero
		title="Parke Koleksiyonumuz"
		subtitle="Her tarza ve ihtiyaca uygun birinci sınıf parke çeşitlerimizi keşfedin."
	/>

	<section class="catalog-section" id="catalogSection">
		<div class="container catalog-container">
			<!-- Mobile Backdrop -->
			<div
				class="sidebar-backdrop"
				id="sidebarBackdrop"
				aria-hidden="true"
			>
			</div>

			<!-- Sidebar Filters (Desktop Sticky Sidebar / Mobile Off-Canvas Drawer) -->
			<aside
				class="sidebar-filters"
				id="sidebarFilters"
				aria-label="Ürün Filtreleri"
			>
				<div class="sidebar-header">
					<div class="sidebar-title-wrap">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="19"
							height="19"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="4" y1="21" x2="4" y2="14"></line>
							<line x1="4" y1="10" x2="4" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12" y2="3"></line>
							<line x1="20" y1="21" x2="20" y2="16"></line>
							<line x1="20" y1="12" x2="20" y2="3"></line>
							<line x1="1" y1="14" x2="7" y2="14"></line>
							<line x1="9" y1="8" x2="15" y2="8"></line>
							<line x1="17" y1="16" x2="23" y2="16"></line>
						</svg>
						<h2>Filtreler</h2>
					</div>
					<button
						type="button"
						class="sidebar-close-btn"
						id="closeFiltersBtn"
						aria-label="Filtreleri Kapat"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>

				<div class="sidebar-body">
					<div class="filter-group">
						<h3>Seriler</h3>
						<ul>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Platinum"
									/>
									<span>Çamsan Platinum</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Modern Long"
									/>
									<span>Çamsan Modern Long</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Modern"
									/>
									<span>Çamsan Modern</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Klasik"
									/>
									<span>Çamsan Klasik</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Silver"
									/>
									<span>Çamsan Silver</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="category-filter"
										value="Çamsan Gloria"
									/>
									<span>Çamsan Gloria</span>
								</label>
							</li>
						</ul>
					</div>

					<div class="filter-group">
						<h3>Kenar Tipi</h3>
						<ul>
							<li>
								<label>
									<input
										type="checkbox"
										class="edge-filter"
										value="Derzli"
									/>
									<span>Derzli</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="edge-filter"
										value="Derzsiz"
									/>
									<span>Derzsiz</span>
								</label>
							</li>
						</ul>
					</div>

					<div class="filter-group">
						<h3>Kalınlık</h3>
						<ul>
							<li>
								<label>
									<input
										type="checkbox"
										class="thickness-filter"
										value="8 mm"
									/>
									<span>8 mm</span>
								</label>
							</li>
							<li>
								<label>
									<input
										type="checkbox"
										class="thickness-filter"
										value="10 mm"
									/>
									<span>10 mm</span>
								</label>
							</li>
						</ul>
					</div>

					<div class="filter-group">
						<h3>Renkler</h3>
						<div class="color-list">
							<label class="color-item">
								<input
									type="checkbox"
									class="color-filter"
									value="Açık"
								/>
								<span
									class="color-swatch-dot"
									style="background-color: #E8D3A7;"></span>
								<span class="color-text">Açık</span>
							</label>
							<label class="color-item">
								<input
									type="checkbox"
									class="color-filter"
									value="Orta"
								/>
								<span
									class="color-swatch-dot"
									style="background-color: #D2B48C;"></span>
								<span class="color-text">Orta</span>
							</label>
							<label class="color-item">
								<input
									type="checkbox"
									class="color-filter"
									value="Koyu"
								/>
								<span
									class="color-swatch-dot"
									style="background-color: #5C4033;"></span>
								<span class="color-text">Koyu</span>
							</label>
						</div>
					</div>

					<div class="filter-group">
						<h3>Fiyat Aralığı</h3>
