---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";

// Product data for the catalog
const products = [
	{
		id: 1,
		name: "Naturesville Meşe - Seri 110",
		category: "Masif Parke",
		color: "Açık Meşe",
		price: "₺480",
		unit: "/ m²",
		desc: "Doğal açık meşe dokusu ve yüksek yüzey dayanımı ile evinizde ferah ve aydınlık bir atmosfer oluşturur.",
		img: "/images/collection-1.jpg",
		link: "/parke"
	},
	{
		id: 2,
		name: "Walnut Dark Koyu Ceviz - Seri 400",
		category: "Lamine Parke",
		color: "Koyu Ceviz",
		price: "₺560",
		unit: "/ m²",
		desc: "Zengin ceviz tonları ve otantik ahşap damarlarıyla yaşam alanlarınıza asil ve sıcak bir dokunuş katar.",
		img: "/images/collection-2.jpg",
		link: "/parke"
	},
	{
		id: 3,
		name: "Nordic Ash Kül Grisi - Seri 220",
		category: "Masif Parke",
		color: "Kül Rengi",
		price: "₺520",
		unit: "/ m²",
		desc: "Modern İskandinav tarzını yansıtan açık kül tonları, minimal ve modern iç mekanlar için idealdir.",
		img: "/images/about-1.jpg",
		link: "/parke"
	},
	{
		id: 4,
		name: "Vintage Rustic Çam - Seri 310",
		category: "Lamine Parke",
		color: "Çam",
		price: "₺420",
		unit: "/ m²",
		desc: "Doğal budaklı rustik yapısı ve eskitme görünümü ile samimi ve sıcak yaşam alanları oluşturur.",
		img: "/images/about-2.jpg",
		link: "/parke"
	},
	{
		id: 5,
		name: "Herringbone Balıksırtı Meşe",
		category: "Lüks Seri",
		color: "Doğal",
		price: "₺690",
		unit: "/ m²",
		desc: "Klasik balıksırtı dizilimi ve özel kilit sistemiyle salon ve prestijli alanlara şıklık kazandırır.",
		img: "/images/about-3.jpg",
		link: "/parke"
	},
	{
		id: 6,
		name: "Royal Akçaağaç Premium",
		category: "Lamine Parke",
		color: "Kızıl Kahve",
		price: "₺510",
		unit: "/ m²",
		desc: "İpeksi mat cilası ve çizilmelere ekstra dayanıklı yapısıyla yoğun kullanım alanlarına çok uygundur.",
		img: "/images/hero-bg.jpg",
		link: "/parke"
	},
	{
		id: 7,
		name: "Silver Grey Meşe - Seri 500",
		category: "Lamine Parke",
		color: "Gri/Kül",
		price: "₺460",
		unit: "/ m²",
		desc: "Trend gri alt tonları ve mat yüzey dokusu ile çağdaş mimari tasarımlara kusursuz uyum sağlar.",
		img: "/images/collection-1.jpg",
		link: "/parke"
	},
	{
		id: 8,
		name: "Artisan Chevron Doğal Meşe",
		category: "Masif Parke",
		color: "Açık Meşe",
		price: "₺720",
		unit: "/ m²",
		desc: "45 derecelik açılı Fransız chevron deseniyle mekanlara derinlik ve seçkin bir estetik kazandırır.",
		img: "/images/collection-2.jpg",
		link: "/parke"
	},
	{
		id: 9,
		name: "Kapadokya Doğal Kestane",
		category: "Lamine Parke",
		color: "Koyu Ceviz",
		price: "₺490",
		unit: "/ m²",
		desc: "Zengin hare yapısı ve derin renk geçişleriyle doğal ahşabın en sıcak ve canlı tonlarını sunar.",
		img: "/images/about-1.jpg",
		link: "/parke"
	}
];
---

<Layout title="Parke Koleksiyonlarımız - Woodcove Flooring">
	<Header />
	<PageHero
		title="Parke Koleksiyonlarımız"
		subtitle="Her tarza ve ihtiyaca uygun birinci sınıf parke çeşitlerimizi keşfedin."
	/>

	<section class="catalog-section">
		<div class="container catalog-container">
			<!-- Sidebar Filters -->
			<aside class="sidebar-filters">
				<div class="filter-group">
					<h3>Kategoriler</h3>
					<ul>
						<li>
							<label
								><input type="checkbox" checked /> Lamine Parke <span
									>(12)</span
								></label
							>
						</li>
						<li>
							<label
								><input type="checkbox" /> Masif Parke <span
									>(8)</span
								></label
							>
						</li>
						<li>
							<label
								><input type="checkbox" /> Vinil <span
									>(15)</span
								></label
							>
						</li>
						<li>
							<label
								><input type="checkbox" /> Aksesuarlar <span
									>(24)</span
								></label
							>
						</li>
					</ul>
				</div>

				<div class="filter-group">
					<h3>Renkler</h3>
					<div class="color-options">
						<button
							class="color-btn"
							style="background-color: #D2B48C;"
							title="Açık Meşe"></button>
						<button
							class="color-btn active"
							style="background-color: #5C4033;"
							title="Koyu Ceviz"></button>
						<button
							class="color-btn"
							style="background-color: #A9A9A9;"
							title="Gri/Kül"></button>
						<button
							class="color-btn"
							style="background-color: #8B4513;"
							title="Kızıl Kahve"></button>
						<button
							class="color-btn"
							style="background-color: #F5DEB3;"
							title="Açık Çam"></button>
					</div>
				</div>

				<div class="filter-group">
					<h3>Fiyat Aralığı</h3>
					<input
						type="range"
						min="10"
						max="100"
						value="50"
						class="price-slider"
					/>
					<div class="price-labels">
						<span>₺300</span>
						<span>₺800+</span>
					</div>
				</div>

				<button class="btn-primary reset-btn">Filtreleri Temizle</button
				>
			</aside>

			<!-- Product List Area -->
			<div class="catalog-content">
				<!-- Top Bar: Sort & Count -->
				<div class="catalog-topbar">
					<div class="result-count">
						<strong>{products.length}</strong> ürün gösteriliyor
					</div>
					<div class="sort-by">
						<label for="sort">Sırala:</label>
						<select id="sort">
							<option>En Yeniler</option>
							<option>Fiyata Göre Artan</option>
							<option>Fiyata Göre Azalan</option>
							<option>Popülerlik</option>
						</select>
					</div>
				</div>

				<!-- Product Grid -->
				<div class="product-grid">
					{
						products.map((product) => (
							<div class="product-card">
								<div class="product-img-wrapper">
									<img src={product.img} alt={product.name} loading="lazy" />
								</div>
								<div class="product-info">
									<h3>{product.name}</h3>
									<p class="product-desc" title={product.desc}>{product.desc}</p>
									<div class="product-footer">
										<div class="price-box">
											<span class="price-val">{product.price}</span>
											<span class="price-unit">{product.unit}</span>
										</div>
										<a href={product.link} class="btn-review">
											<span>İncele</span>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="16"
												height="16"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<line x1="5" y1="12" x2="19" y2="12"></line>
												<polyline points="12 5 19 12 12 19"></polyline>
											</svg>
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>

				<!-- Pagination -->
				<div class="pagination">
					<button class="page-btn active">1</button>
					<button class="page-btn">2</button>
					<button class="page-btn">3</button>
					<button class="page-btn next">&rarr;</button>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.catalog-section {
		padding: 80px 0;
		background: #fcfcfc;
	}
	.catalog-container {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	@media (min-width: 1024px) {
		.catalog-container {
			flex-direction: row;
			align-items: flex-start;
		}
	}

	/* Sidebar Filters */
	.sidebar-filters {
		width: 100%;
		background: #fff;
		padding: 30px;
		border-radius: 8px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
	}
	@media (min-width: 1024px) {
		.sidebar-filters {
			width: 280px;
			flex-shrink: 0;
		}
	}
	.filter-group {
		margin-bottom: 30px;
		padding-bottom: 20px;
		border-bottom: 1px solid #eee;
	}
	.filter-group h3 {
		font-size: 1.1rem;
		margin-bottom: 15px;
		color: var(--color-primary);
	}
	.filter-group ul {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.filter-group label {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.95rem;
		color: #555;
		cursor: pointer;
	}
	.filter-group label span {
		margin-left: auto;
		color: #999;
		font-size: 0.85rem;
	}
	.color-options {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.color-btn {
		width: 35px;
		height: 35px;
		border-radius: 50%;
		border: 2px solid #fff;
		box-shadow: 0 0 0 1px #ddd;
		cursor: pointer;
		transition: transform 0.2s;
	}
	.color-btn.active,
	.color-btn:hover {
		box-shadow: 0 0 0 2px var(--color-primary);
		transform: scale(1.1);
	}
	.price-slider {
		width: 100%;
		margin-bottom: 10px;
	}
	.price-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
		color: #666;
		font-weight: 600;
	}
	.reset-btn {
		width: 100%;
		background: #f0f0f0;
		color: #333;
	}
	.reset-btn:hover {
		background: #e0e0e0;
		color: #111;
	}

	/* Catalog Content */
	.catalog-content {
		flex: 1;
		width: 100%;
	}
	.catalog-topbar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		padding: 15px 25px;
		border-radius: 8px;
		margin-bottom: 30px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
	}
	.result-count {
		color: #666;
		font-size: 0.95rem;
	}
	.result-count strong {
		color: var(--color-primary);
	}
	.sort-by {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.95rem;
		color: #555;
	}
	.sort-by select {
		padding: 8px 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
		outline: none;
		font-family: var(--font-secondary);
	}

	/* Product Grid */
	.product-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 30px;
		margin-bottom: 40px;
	}
	@media (min-width: 640px) {
		.product-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1200px) {
		.product-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.product-card {
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		border: 1px solid rgba(0, 0, 0, 0.04);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}
	.product-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 30px rgba(18, 52, 71, 0.12);
	}
	.product-img-wrapper {
		position: relative;
		height: 220px;
		overflow: hidden;
		background-color: #eaeef1;
	}
	.product-img-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}
	.product-card:hover .product-img-wrapper img {
		transform: scale(1.06);
	}
	.product-info {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.product-info h3 {
		font-size: 1.15rem;
		font-family: var(--font-primary);
		color: var(--color-primary);
		margin-bottom: 0.6rem;
		line-height: 1.35;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.product-desc {
		color: #64748b;
		font-size: 0.9rem;
		line-height: 1.45;
		margin-bottom: 1.4rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		min-height: 2.9em;
	}
	.product-footer {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		border-top: 1px solid #edf2f7;
		gap: 0.75rem;
	}
	.price-box {
		display: flex;
		align-items: baseline;
		gap: 3px;
	}
	.price-val {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--color-primary);
		font-family: var(--font-primary);
	}
	.price-unit {
		font-size: 0.85rem;
		color: #718096;
		font-weight: 500;
	}
	.btn-review {
		background: transparent;
		color: var(--color-primary);
		padding: 4px 0;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border: none;
		transition: color 0.25s ease;
	}
	.btn-review:hover {
		color: var(--color-secondary);
	}
	.btn-review svg {
		transition: transform 0.25s ease;
	}
	.btn-review:hover svg {
		transform: translateX(4px);
	}

	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		gap: 10px;
	}
	.page-btn {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		border: 1px solid #ddd;
		border-radius: 4px;
		cursor: pointer;
		font-weight: 600;
		color: #555;
		transition: all 0.2s;
	}
	.page-btn.active,
	.page-btn:hover {
		background: var(--color-primary);
		color: #fff;
		border-color: var(--color-primary);
	}
</style>
