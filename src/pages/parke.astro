										max={maxProductPrice}
										step="5"
										aria-label="Minimum Fiyat"
									/>
								</div>
							</div>
							<span class="price-range-sep">-</span>
							<div class="price-input-field">
								<label for="maxPriceInput">Max (₺)</label>
								<div class="price-input-box">
									<span class="currency-sign">₺</span>
									<input
										type="number"
										id="maxPriceInput"
										placeholder={maxProductPrice.toString()}
										min={minProductPrice}
										max={maxProductPrice}
										step="5"
										aria-label="Maksimum Fiyat"
									/>
								</div>
							</div>
						</div>
						<button
							type="button"
							id="applyPriceBtn"
							class="btn-apply-price"
						>
							Fiyat Uygula
						</button>
					</div>
				</div>

				<div class="sidebar-actions">
					<button
						type="button"
						class="btn-sidebar-reset reset-btn"
						id="resetFiltersBtn"
						aria-label="Filtreleri Temizle"
					>
						Temizle
					</button>
					<button
						type="button"
						class="btn-sidebar-apply"
						id="applyFiltersDrawerBtn"
						aria-label="Filtreleri Uygula"
					>
						Filtreleri Uygula (<span id="drawerResultCount"
							>{products.length}</span
						>)
					</button>
				</div>
			</aside>

			<!-- Product List Area -->
			<div class="catalog-content">
				<!-- Top Bar: Search, Mobile Filter Button, Count & Sort -->
				<div class="catalog-topbar">
					<div class="catalog-search">
						<div class="search-input-wrap">
							<input
								type="text"
								id="productSearchInput"
								placeholder="Parke modellerinde ara..."
								autocomplete="off"
								aria-label="Parke modellerinde ara"
							/>
							<button
								id="productSearchBtn"
								class="search-btn"
								type="button"
								aria-label="Ara"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="11" cy="11" r="8"></circle>
									<line x1="21" y1="21" x2="16.65" y2="16.65"
									></line>
								</svg>
								<span>Ara</span>
							</button>
						</div>
					</div>

					<div class="catalog-controls">
						<button
							type="button"
							class="mobile-filter-trigger"
							id="openFiltersBtn"
							aria-expanded="false"
							aria-controls="sidebarFilters"
							aria-label="Filtreleri Aç"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="17"
								height="17"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<line x1="4" y1="21" x2="4" y2="14"></line>
								<line x1="4" y1="10" x2="4" y2="3"></line>
								<line x1="12" y1="21" x2="12" y2="12"></line>
								<line x1="12" y1="8" x2="12" y2="3"></line>
								<line x1="20" y1="21" x2="20" y2="16"></line>
								<line x1="20" y1="12" x2="20" y2="3"></line>
								<line x1="1" y1="14" x2="7" y2="14"></line>
								<line x1="9" y1="8" x2="15" y2="8"></line>
								<line x1="17" y1="16" x2="23" y2="16"></line>
							</svg>
							<span>Filtrele</span>
							<span
								class="active-filter-badge"
								id="activeFilterBadge"
								style="display: none;">0</span
							>
						</button>

						<div class="sort-by">
							<label for="sort">Sırala:</label>
							<select id="sort" aria-label="Ürünleri sırala">
								<option value="price-asc" selected
									>Fiyata Göre Artan</option
								>
								<option value="price-desc"
									>Fiyata Göre Azalan</option
								>
								<option value="name-asc">A'dan Z'ye</option>
								<option value="name-desc">Z'den A'ya</option>
							</select>
						</div>
						<div class="result-count">
							<strong id="productCount">{products.length}</strong> farklı
							ürün
						</div>
					</div>
				</div>

				<!-- Aktif Filtre Etiketleri (Active Filter Chips) -->
				<div
					class="active-chips-bar"
					id="activeChipsBar"
					style="display: none;"
				>
					<span class="active-chips-title">Aktif Filtreler:</span>
					<div class="active-chips-list" id="activeChipsList"></div>
					<button
						type="button"
						class="clear-all-chips-btn"
						id="clearAllChipsBtn">Tümünü Kaldır</button
					>
				</div>

				<!-- Arama Sonucu Bulunamadı Mesajı -->
				<div
					id="noResultsMessage"
					class="no-results"
					style="display: none;"
				>
					<p>
						Aradığınız filtreleme kriterine uygun ürün bulunamadı.
						Lütfen filtrelerinizi kontrol edin veya temizleyin.
					</p>
				</div>

				<!-- Product Grid -->
				<div class="product-grid" id="productGrid">
					{
						products.map((product, idx) => (
							<ProductCard
								product={product}
								isInitiallyVisible={idx < 12}
							/>
						))
					}
				</div>

				<!-- Pagination -->
				<div class="pagination" id="catalogPagination">
					<button
						class="page-btn prev-btn"
						id="prevPageBtn"
						disabled
						aria-label="Önceki Sayfa">&larr;</button
					>
					{
						Array.from({
							length: Math.ceil(products.length / 12),
						}).map((_, i) => (
							<button
								class={`page-btn page-num-btn ${i === 0 ? "active" : ""}`}
								data-page={i + 1}
							>
								{i + 1}
							</button>
						))
					}
					<button
						class="page-btn next-btn"
						id="nextPageBtn"
						aria-label="Sonraki Sayfa">&rarr;</button
					>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const sortSelect = document.getElementById(
		"sort",
	) as HTMLSelectElement | null;
	const productGrid = document.getElementById("productGrid");
	const searchInput = document.getElementById(
		"productSearchInput",
	) as HTMLInputElement | null;
	const searchBtn = document.getElementById("productSearchBtn");
	const countDisplay = document.getElementById("productCount");
	const noResultsMsg = document.getElementById("noResultsMessage");
	const paginationContainer = document.getElementById("catalogPagination");
	const prevBtn = document.getElementById(
		"prevPageBtn",
	) as HTMLButtonElement | null;
	const nextBtn = document.getElementById(
		"nextPageBtn",
	) as HTMLButtonElement | null;
	const pageNumBtns =
		document.querySelectorAll<HTMLButtonElement>(".page-num-btn");
	const catalogSection = document.getElementById("catalogSection");

	// Mobile Drawer Elements
	const sidebarFilters = document.getElementById("sidebarFilters");
	const sidebarBackdrop = document.getElementById("sidebarBackdrop");
	const openFiltersBtn = document.getElementById("openFiltersBtn");
	const closeFiltersBtn = document.getElementById("closeFiltersBtn");
	const applyFiltersDrawerBtn = document.getElementById(
		"applyFiltersDrawerBtn",
	);
	const drawerResultCount = document.getElementById("drawerResultCount");
	const activeFilterBadge = document.getElementById("activeFilterBadge");

	// Filter Chips Elements
	const activeChipsBar = document.getElementById("activeChipsBar");
	const activeChipsList = document.getElementById("activeChipsList");
	const clearAllChipsBtn = document.getElementById("clearAllChipsBtn");

	const categoryCheckboxes =
		document.querySelectorAll<HTMLInputElement>(".category-filter");
	const edgeCheckboxes =
		document.querySelectorAll<HTMLInputElement>(".edge-filter");
	const thicknessCheckboxes =
		document.querySelectorAll<HTMLInputElement>(".thickness-filter");
	const colorCheckboxes =
		document.querySelectorAll<HTMLInputElement>(".color-filter");
	const minPriceInput = document.getElementById(
		"minPriceInput",
	) as HTMLInputElement | null;
	const maxPriceInput = document.getElementById(
		"maxPriceInput",
	) as HTMLInputElement | null;
	const applyPriceBtn = document.getElementById(
		"applyPriceBtn",
	) as HTMLButtonElement | null;
	const resetFiltersBtn = document.getElementById(
		"resetFiltersBtn",
	) as HTMLButtonElement | null;

	const ITEMS_PER_PAGE = 12;
	let currentPage = 1;
	let appliedMinPrice: number | null = null;
	let appliedMaxPrice: number | null = null;

	// Mobile Drawer Open / Close Functions
	function openDrawer() {
		sidebarFilters?.classList.add("open");
		sidebarBackdrop?.classList.add("active");
		openFiltersBtn?.setAttribute("aria-expanded", "true");
		document.body.style.overflow = "hidden";
	}

	function closeDrawer() {
		sidebarFilters?.classList.remove("open");
		sidebarBackdrop?.classList.remove("active");
		openFiltersBtn?.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
	}

	openFiltersBtn?.addEventListener("click", openDrawer);
	closeFiltersBtn?.addEventListener("click", closeDrawer);
	sidebarBackdrop?.addEventListener("click", closeDrawer);
	applyFiltersDrawerBtn?.addEventListener("click", () => {
		closeDrawer();
		if (catalogSection) {
			const rect = catalogSection.getBoundingClientRect();
			if (rect.top < 0) {
				catalogSection.scrollIntoView({ behavior: "smooth" });
			}
		}
	});

	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && sidebarFilters?.classList.contains("open")) {
			closeDrawer();
		}
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth >= 1024) {
			if (sidebarFilters?.classList.contains("open")) {
				closeDrawer();
			}
			document.body.style.overflow = "";
		}
	});

	function normalizeText(str: string): string {
		if (!str) return "";
		return str
			.trim()
			.replace(/İ/g, "i")
			.replace(/I/g, "i")
			.replace(/ı/g, "i")
			.toLocaleLowerCase("tr")
			.replace(/ı/g, "i")
			.replace(/ğ/g, "g")
			.replace(/ü/g, "u")
			.replace(/ş/g, "s")
			.replace(/ö/g, "o")
			.replace(/ç/g, "c");
	}

	function getFilteredAndSortedCards(): HTMLElement[] {
		if (!productGrid) return [];
		const query = normalizeText(searchInput?.value || "");
		const sortValue = sortSelect?.value || "price-asc";

		const selectedCategories = Array.from(categoryCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => normalizeText(cb.value));

		const selectedEdges = Array.from(edgeCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => normalizeText(cb.value));

		const selectedThicknesses = Array.from(thicknessCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => normalizeText(cb.value));

		const selectedColors = Array.from(colorCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => normalizeText(cb.value));

		const cards = Array.from(
			productGrid.querySelectorAll<HTMLElement>(".product-card"),
		);

		// Filter
		const matchingCards = cards.filter((card) => {
			const name = normalizeText(card.getAttribute("data-name") || "");
			const desc = normalizeText(card.getAttribute("data-desc") || "");
			const category = normalizeText(
				card.getAttribute("data-category") || "",
			);
			const edge = normalizeText(card.getAttribute("data-edge") || "");
			const thickness = normalizeText(
				card.getAttribute("data-thickness") || "",
			);
			const color = normalizeText(card.getAttribute("data-color") || "");
			const price = parseFloat(card.getAttribute("data-price") || "0");

			// Search text filter
			if (
				query &&
				!name.includes(query) &&
				!desc.includes(query) &&
				!category.includes(query) &&
				!edge.includes(query) &&
				!thickness.includes(query) &&
				!color.includes(query)
			) {
				return false;
			}

			// Category filter
			if (
				selectedCategories.length > 0 &&
				!selectedCategories.includes(category)
			) {
				return false;
			}

			// Edge filter
			if (selectedEdges.length > 0 && !selectedEdges.includes(edge)) {
				return false;
			}

			// Thickness filter
			if (
				selectedThicknesses.length > 0 &&
				!selectedThicknesses.includes(thickness)
			) {
				return false;
			}

			// Color filter
			if (selectedColors.length > 0 && !selectedColors.includes(color)) {
				return false;
			}

			// Min price filter
			if (appliedMinPrice !== null && price < appliedMinPrice) {
				return false;
			}

			// Max price filter
			if (appliedMaxPrice !== null && price > appliedMaxPrice) {
				return false;
			}

			return true;
		});

		// Sort
		matchingCards.sort((a, b) => {
			const nameA = a.getAttribute("data-name") || "";
			const nameB = b.getAttribute("data-name") || "";
			const priceA = parseFloat(a.getAttribute("data-price") || "0");
			const priceB = parseFloat(b.getAttribute("data-price") || "0");

			switch (sortValue) {
				case "price-asc":
					return priceA - priceB;
				case "price-desc":
					return priceB - priceA;
				case "name-asc":
					return nameA.localeCompare(nameB, "tr");
				case "name-desc":
					return nameB.localeCompare(nameA, "tr");
				default:
					return 0;
			}
		});

		// Reorder in DOM
		matchingCards.forEach((card) => productGrid.appendChild(card));

		return matchingCards;
	}

	function updateFilterStatsAndChips(totalMatching: number) {
		// Update drawer counter
		if (drawerResultCount) {
			drawerResultCount.textContent = totalMatching.toString();
		}

		// Calculate active filter count & create chips
		const activeFilters: { label: string; clear: () => void }[] = [];

		categoryCheckboxes.forEach((cb) => {
			if (cb.checked) {
				activeFilters.push({
					label: cb.value,
					clear: () => {
						cb.checked = false;
						currentPage = 1;
						renderCurrentPage(false);
					},
				});
			}
		});

		edgeCheckboxes.forEach((cb) => {
			if (cb.checked) {
				activeFilters.push({
					label: cb.value,
					clear: () => {
						cb.checked = false;
						currentPage = 1;
						renderCurrentPage(false);
					},
				});
			}
		});

		thicknessCheckboxes.forEach((cb) => {
			if (cb.checked) {
				activeFilters.push({
					label: cb.value,
					clear: () => {
						cb.checked = false;
						currentPage = 1;
						renderCurrentPage(false);
					},
				});
			}
		});

		colorCheckboxes.forEach((cb) => {
			if (cb.checked) {
				activeFilters.push({
					label: `Renk: ${cb.value}`,
					clear: () => {
						cb.checked = false;
						currentPage = 1;
						renderCurrentPage(false);
					},
				});
			}
		});

		if (appliedMinPrice !== null || appliedMaxPrice !== null) {
			const priceText =
				appliedMinPrice !== null && appliedMaxPrice !== null
					? `${appliedMinPrice}₺ - ${appliedMaxPrice}₺`
					: appliedMinPrice !== null
						? `Min ${appliedMinPrice}₺`
						: `Max ${appliedMaxPrice}₺`;

			activeFilters.push({
				label: priceText,
				clear: () => {
					appliedMinPrice = null;
					appliedMaxPrice = null;
					if (minPriceInput) minPriceInput.value = "";
					if (maxPriceInput) maxPriceInput.value = "";
					currentPage = 1;
					renderCurrentPage(false);
				},
			});
		}

		// Update Badge
		if (activeFilterBadge) {
			const count = activeFilters.length;
			if (count > 0) {
				activeFilterBadge.textContent = count.toString();
				activeFilterBadge.style.display = "inline-flex";
			} else {
				activeFilterBadge.style.display = "none";
			}
		}

		// Update Chips Bar
		if (activeChipsBar && activeChipsList) {
			if (activeFilters.length > 0) {
				activeChipsBar.style.display = "flex";
				activeChipsList.innerHTML = "";

				activeFilters.forEach((filter) => {
					const chip = document.createElement("button");
					chip.type = "button";
					chip.className = "filter-chip";
					chip.setAttribute(
						"aria-label",
						`${filter.label} filtresini kaldır`,
					);
					chip.innerHTML = `<span>${filter.label}</span><span class="filter-chip-remove" aria-hidden="true">&times;</span>`;
					chip.addEventListener("click", filter.clear);
					activeChipsList.appendChild(chip);
				});
			} else {
				activeChipsBar.style.display = "none";
				activeChipsList.innerHTML = "";
			}
		}
	}

	clearAllChipsBtn?.addEventListener("click", resetFilters);

	function renderCurrentPage(scrollToTop = false) {
		if (!productGrid) return;
		const matchingCards = getFilteredAndSortedCards();
		const allCards = Array.from(
			productGrid.querySelectorAll<HTMLElement>(".product-card"),
		);
		const totalMatching = matchingCards.length;
		const totalPages = Math.max(
			1,
			Math.ceil(totalMatching / ITEMS_PER_PAGE),
		);

		if (currentPage > totalPages) {
			currentPage = 1;
		}

		const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
		const endIndex = startIndex + ITEMS_PER_PAGE;

		// Hide all cards first
		allCards.forEach((card) => {
			card.style.display = "none";
		});

		// Show only current page matching cards
		matchingCards.slice(startIndex, endIndex).forEach((card) => {
			card.style.display = "flex";
		});

		// Update count display
		if (countDisplay) {
			countDisplay.textContent = totalMatching.toString();
		}

		// Update no results message
		if (noResultsMsg) {
			noResultsMsg.style.display = totalMatching === 0 ? "block" : "none";
		}

		// Update filter badge, drawer counter & chips
		updateFilterStatsAndChips(totalMatching);

		// Update pagination UI
		if (paginationContainer) {
			if (totalMatching <= ITEMS_PER_PAGE) {
				pageNumBtns.forEach((btn) => {
					const page = parseInt(
						btn.getAttribute("data-page") || "1",
						10,
					);
					btn.style.display = page === 1 ? "flex" : "none";
					if (page === 1) btn.classList.add("active");
				});
				if (prevBtn) prevBtn.disabled = true;
				if (nextBtn) nextBtn.disabled = true;
			} else {
				pageNumBtns.forEach((btn) => {
					const page = parseInt(
						btn.getAttribute("data-page") || "1",
						10,
					);
					if (page <= totalPages) {
						btn.style.display = "flex";
						if (page === currentPage) {
							btn.classList.add("active");
						} else {
							btn.classList.remove("active");
						}
					} else {
						btn.style.display = "none";
					}
				});
				if (prevBtn) prevBtn.disabled = currentPage === 1;
				if (nextBtn) nextBtn.disabled = currentPage === totalPages;
			}
		}

		if (scrollToTop && catalogSection) {
			const rect = catalogSection.getBoundingClientRect();
			if (rect.top < 0) {
				catalogSection.scrollIntoView({ behavior: "smooth" });
			}
		}

		updateURL();
	}

	// Pagination button events
	pageNumBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const page = parseInt(btn.getAttribute("data-page") || "1", 10);
			if (currentPage !== page) {
				currentPage = page;
				renderCurrentPage(true);
			}
		});
	});

	prevBtn?.addEventListener("click", () => {
		if (currentPage > 1) {
			currentPage--;
			renderCurrentPage(true);
		}
	});

	nextBtn?.addEventListener("click", () => {
		const totalMatching = getFilteredAndSortedCards().length;
		const totalPages = Math.max(
			1,
			Math.ceil(totalMatching / ITEMS_PER_PAGE),
		);
		if (currentPage < totalPages) {
			currentPage++;
			renderCurrentPage(true);
		}
	});

	// Price Apply Button & Enter Key
	function applyPriceFilter() {
		const minVal = minPriceInput?.value.trim();
		const maxVal = maxPriceInput?.value.trim();
		appliedMinPrice = minVal ? parseFloat(minVal) : null;
		appliedMaxPrice = maxVal ? parseFloat(maxVal) : null;
		currentPage = 1;
		renderCurrentPage(false);
	}

	applyPriceBtn?.addEventListener("click", applyPriceFilter);

	[minPriceInput, maxPriceInput].forEach((input) => {
		input?.addEventListener("keydown", (e) => {
			if (e.key === "Enter") {
				e.preventDefault();
				applyPriceFilter();
			}
		});
	});

	// Checkbox Filters
	categoryCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	edgeCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	thicknessCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	colorCheckboxes.forEach((cb) => {
		cb.addEventListener("change", () => {
			currentPage = 1;
			renderCurrentPage(false);
		});
	});

	// Reset / Clear Filters
	function resetFilters() {
		if (searchInput) searchInput.value = "";
		if (minPriceInput) minPriceInput.value = "";
		if (maxPriceInput) maxPriceInput.value = "";
		appliedMinPrice = null;
		appliedMaxPrice = null;
		categoryCheckboxes.forEach((cb) => (cb.checked = false));
		edgeCheckboxes.forEach((cb) => (cb.checked = false));
		thicknessCheckboxes.forEach((cb) => (cb.checked = false));
		colorCheckboxes.forEach((cb) => (cb.checked = false));
		if (sortSelect) sortSelect.value = "price-asc";
		currentPage = 1;
		renderCurrentPage(false);
	}

	resetFiltersBtn?.addEventListener("click", resetFilters);

	// Filter & Sort events
	searchBtn?.addEventListener("click", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});

	searchInput?.addEventListener("input", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});

	searchInput?.addEventListener("keydown", (e) => {
		if (e.key === "Enter") {
			e.preventDefault();
			currentPage = 1;
			renderCurrentPage(false);
		}
	});

	sortSelect?.addEventListener("change", () => {
		currentPage = 1;
		renderCurrentPage(false);
	});

	function updateURL() {
		const url = new URL(window.location.href);

		if (searchInput && searchInput.value)
			url.searchParams.set("q", searchInput.value);
		else url.searchParams.delete("q");

		if (sortSelect && sortSelect.value !== "price-asc")
			url.searchParams.set("sort", sortSelect.value);
		else url.searchParams.delete("sort");

		const selectedCategories = Array.from(categoryCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value);
		if (selectedCategories.length)
			url.searchParams.set("category", selectedCategories.join(","));
		else url.searchParams.delete("category");

		const selectedEdges = Array.from(edgeCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value);
		if (selectedEdges.length)
			url.searchParams.set("edge", selectedEdges.join(","));
		else url.searchParams.delete("edge");

		const selectedThicknesses = Array.from(thicknessCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value);
		if (selectedThicknesses.length)
			url.searchParams.set("thickness", selectedThicknesses.join(","));
		else url.searchParams.delete("thickness");

		const selectedColors = Array.from(colorCheckboxes)
			.filter((cb) => cb.checked)
			.map((cb) => cb.value);
		if (selectedColors.length)
			url.searchParams.set("color", selectedColors.join(","));
		else url.searchParams.delete("color");

		if (appliedMinPrice !== null)
			url.searchParams.set("min", appliedMinPrice.toString());
		else url.searchParams.delete("min");

		if (appliedMaxPrice !== null)
			url.searchParams.set("max", appliedMaxPrice.toString());
		else url.searchParams.delete("max");

		if (currentPage > 1)
			url.searchParams.set("page", currentPage.toString());
		else url.searchParams.delete("page");

		window.history.replaceState({}, "", url);
	}

	function initFromURL() {
		const params = new URLSearchParams(window.location.search);
		let hasParams = false;

		if (params.has("q")) {
			if (searchInput) searchInput.value = params.get("q") || "";
			hasParams = true;
		}
		if (params.has("sort")) {
			if (sortSelect)
				sortSelect.value = params.get("sort") || "price-asc";
			hasParams = true;
		}

		if (params.has("category")) {
			const cats = params.get("category")?.split(",") || [];
			categoryCheckboxes.forEach((cb) => {
				cb.checked = cats.includes(cb.value);
			});
			hasParams = true;
		}

		if (params.has("edge")) {
			const edges = params.get("edge")?.split(",") || [];
			edgeCheckboxes.forEach((cb) => {
				cb.checked = edges.includes(cb.value);
			});
			hasParams = true;
		}

		if (params.has("thickness")) {
			const thick = params.get("thickness")?.split(",") || [];
			thicknessCheckboxes.forEach((cb) => {
				cb.checked = thick.includes(cb.value);
			});
			hasParams = true;
		}

		if (params.has("color")) {
			const colors = params.get("color")?.split(",") || [];
			colorCheckboxes.forEach((cb) => {
				cb.checked = colors.includes(cb.value);
			});
			hasParams = true;
		}

		if (params.has("min")) {
			appliedMinPrice = parseFloat(params.get("min") || "0");
			if (minPriceInput && appliedMinPrice)
				minPriceInput.value = appliedMinPrice.toString();
			hasParams = true;
		}
		if (params.has("max")) {
			appliedMaxPrice = parseFloat(params.get("max") || "0");
			if (maxPriceInput && appliedMaxPrice)
				maxPriceInput.value = appliedMaxPrice.toString();
			hasParams = true;
		}

		if (params.has("page")) {
			currentPage = parseInt(params.get("page") || "1", 10);
			hasParams = true;
		}

		if (hasParams) {
			renderCurrentPage(false);
		} else {
			// Initialize chips & counts initially
			updateFilterStatsAndChips(
				productGrid?.querySelectorAll(".product-card").length || 0,
			);
		}
	}

	// Sayfa yüklendiğinde URL'den filtreleri uygula
	initFromURL();
</script>

