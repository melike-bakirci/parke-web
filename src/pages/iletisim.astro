---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { siteInfo } from "../data/siteInfo";
---

<Layout title="İletişim, Ücretsiz Keşif & Fiyat Teklifi | ZenFlor">
	<PageHero
		title="Bize Ulaşın"
		subtitle="Aklınızdaki projeyi konuşmak için sabırsızlanıyoruz! Bir mesaj atmaya ne dersiniz?

"
	/>

	<section class="contact-page-section">
		<div class="container contact-page-container">
			<!-- Contact Info Cards -->
			<div class="contact-info-cards">
				<a
					href={siteInfo.contact.address.mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="info-card"
				>
					<div class="icon-circle">
						<Icon name="location" size={24} />
					</div>
					<h3>Adresimiz</h3>
					<p>
						{siteInfo.contact.address.street},<br />{siteInfo.contact.address.district} / {siteInfo.contact.address.city}
					</p>
				</a>

				<a
					href={siteInfo.contact.phone.tel}
					class="info-card"
				>
					<div class="icon-circle">
						<Icon name="phone" size={24} />
					</div>
					<h3>Telefonumuz</h3>
					<p>{siteInfo.contact.phone.formatted}</p>
				</a>

				<a
					href={siteInfo.contact.email.mailto}
					class="info-card"
				>
					<div class="icon-circle">
						<Icon name="email" size={24} />
					</div>
					<h3>E-postamız</h3>
					<p>
						{siteInfo.contact.email.address}
					</p>
				</a>

				<div class="info-card static-card">
					<div class="icon-circle">
						<Icon name="clock" size={24} />
					</div>
					<h3>Çalışma Saatlerimiz</h3>
					<p>
						{siteInfo.contact.workingHours.weekdays}<br /><span class="text-muted"
							>{siteInfo.contact.workingHours.weekend}</span
						>
					</p>
				</div>
			</div>

			<!-- Horizontal Social Media Bar -->
			<div class="contact-social-bar">
				<div class="social-bar-heading">
					<h3>Bizi Takip Edin</h3>
				</div>
				<div class="social-bar-icons">
					<a
						href={siteInfo.social.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Instagram"
						title="Instagram"
					>
						<Icon name="instagram" size={20} />
					</a>
					<a
						href={siteInfo.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="LinkedIn"
						title="LinkedIn"
					>
						<Icon name="linkedin" size={20} />
					</a>
					<a
						href={siteInfo.social.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Facebook"
						title="Facebook"
					>
						<Icon name="facebook" size={20} />
					</a>
					<a
						href={siteInfo.social.youtube}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="YouTube"
						title="YouTube"
					>
						<Icon name="youtube" size={20} />
					</a>
					<a
						href={siteInfo.social.tiktok}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="TikTok"
						title="TikTok"
					>
						<Icon name="tiktok" size={20} />
					</a>
					<a
						href={siteInfo.social.sahibinden}
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Sahibinden"
						title="Sahibinden"
					>
						<Icon name="sahibinden" size={20} />
					</a>
				</div>
			</div>

			<!-- Map & Form Section -->
			<div class="map-form-wrapper">
				<!-- Google Map Iframe -->
				<div class="map-container">
					<iframe
						src="https://maps.google.com/maps?q=Leman+Sk.+No:4,+Sancaktepe+İstanbul&t=&z=15&ie=UTF8&iwloc=&output=embed"
						width="100%"
						height="100%"
						style="border:0; min-height: 450px; display: block;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title="Ofis Konumu"
					>
					</iframe>
				</div>

				<!-- Contact Form -->
				<div class="form-container">
					<h2>Bize Ulaşın</h2>

					<form class="page-contact-form" id="contactForm">
						<div
							id="formSuccessMessage"
							class="form-success-alert"
							role="alert"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
								></path><polyline points="22 4 12 14.01 9 11.01"
								></polyline></svg
							>
							<div>
								<strong>Mesajınız başarıyla iletildi!</strong>
								<p>
									En kısa süre içerisinde sizinle iletişime
									geçeceğiz.
								</p>
							</div>
						</div>

						<div class="form-row">
							<div class="input-group">
								<label for="entry_2005620554"
									>Adınız <span class="required">*</span
									></label
								>
								<input
									type="text"
									id="entry_2005620554"
									name="entry.2005620554"
									required
									placeholder="Size nasıl hitap edelim?"
									autocomplete="name"
								/>
							</div>
							<div class="input-group">
								<label for="entry_1166974658"
									>Telefon Numaranız <span class="required"
										>*</span
									></label
								>
								<input
									type="tel"
									id="entry_1166974658"
									name="entry.1166974658"
									required
									placeholder="Size ulaşabileceğimiz telefon"
									autocomplete="tel"
								/>
							</div>
						</div>

						<div class="input-group">
							<label for="entry_839337160"
								>Mesajınız <span class="required">*</span
								></label
							>
							<textarea
								id="entry_839337160"
								name="entry.839337160"
								required
								placeholder="Aklınızdan geçenleri bizimle paylaşın..."
								rows="6"></textarea>
						</div>

						<button type="submit" class="btn-primary" id="submitBtn"
							>Mesajı Gönder</button
						>
					</form>
				</div>
			</div>
		</div>
	</section>

	<script>
		// Google Forms formResponse URL'i
		const GOOGLE_FORM_ACTION_URL = "https://docs.google.com/forms/d/e/1FAIpQLSczeA1IJbeRlC25dY_Mdk83-UWVmHIqcF4aXux-h28dwogWAQ/formResponse";

		const contactForm = document.getElementById(
			"contactForm",
		) as HTMLFormElement | null;
		const successAlert = document.getElementById("formSuccessMessage");
		const submitBtn = document.getElementById(
			"submitBtn",
		) as HTMLButtonElement | null;

		contactForm?.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.innerHTML = `
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-spinner">
						<path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
					</svg>
					Gönderiliyor...
				`;
			}

			try {
				const formData = new FormData(contactForm);

				// Google Forms endpoint'ine no-cors modunda POST isteği gönderimi
				if (GOOGLE_FORM_ACTION_URL && !GOOGLE_FORM_ACTION_URL.includes("FORM_ID_BURAYA")) {
					await fetch(GOOGLE_FORM_ACTION_URL, {
						method: "POST",
						mode: "no-cors",
						body: formData,
					});
				} else {
					// URL henüz girilmediyse kısa bir gecikmeyle simüle et
					await new Promise((resolve) => setTimeout(resolve, 600));
				}

				contactForm.reset();

				if (successAlert) {
					successAlert.classList.add("show");
					successAlert.scrollIntoView({
						behavior: "smooth",
						block: "nearest",
					});

					setTimeout(() => {
						successAlert.classList.remove("show");
					}, 7000);
				}
			} catch (error) {
				console.error("Form gönderim hatası:", error);
				alert("Mesajınız gönderilirken bir hata oluştu. Lütfen doğrudan telefon veya WhatsApp üzerinden bize ulaşın.");
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = "Mesajı Gönder";
				}
			}
		});
	</script>

</Layout>

<style>
	.contact-page-section {
		padding: 80px 0;
		background: #f4f8fb;
	}
	.contact-page-container {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	/* Info Cards */
	.contact-info-cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
	}
	@media (min-width: 640px) {
		.contact-info-cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.contact-info-cards {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.text-muted {
		color: #888;
		font-size: 0.88rem;
		display: inline-block;
		margin-top: 2px;
	}
	.info-card {
		background: #fff;
		padding: 40px 30px;
		border-radius: 8px;
		text-align: center;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		color: inherit;
	}
	a.info-card {
		cursor: pointer;
	}
	.info-card.static-card {
		cursor: default;
	}
	.info-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 25px rgba(18, 52, 71, 0.09);
	}
	.icon-circle {
		width: 70px;
		height: 70px;
		background: rgba(18, 52, 71, 0.05);
		color: var(--color-primary);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 20px auto;
		transition: background-color 0.3s ease, color 0.3s ease;
	}
	.info-card:hover .icon-circle {
		background: var(--color-primary);
		color: #fff;
	}
	.info-card h3 {
		font-size: 1.3rem;
		margin-bottom: 15px;
		color: var(--color-primary);
	}
	.info-card p {
		color: #666;
		line-height: 1.6;
		font-size: 1rem;
		margin: 0;
	}

	/* Map & Form Wrapper */
	.map-form-wrapper {
		display: flex;
		flex-direction: column;
		background: #fff;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}
	@media (min-width: 1024px) {
		.map-form-wrapper {
			flex-direction: row;
		}
	}
	.map-container {
		flex: 1;
		min-height: 400px;
		background: #eaeaea;
	}
	.map-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: #999;
		gap: 15px;
		background: #e5e9ec;
	}
	.form-container {
		flex: 1;
		padding: 50px;
	}
	@media (max-width: 768px) {
		.form-container {
			padding: 30px 20px;
		}
	}
	.form-container h2 {
		font-size: 2rem;
		margin-bottom: 25px;
		color: var(--color-primary);
	}
	.form-container p {
		color: #666;
		margin-bottom: 30px;
		line-height: 1.6;
	}

	/* Form Elements */
	.page-contact-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.form-row {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	@media (min-width: 640px) {
		.form-row {
			flex-direction: row;
		}
	}
	.input-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}
	.input-group label {
		font-size: 0.9rem;
		font-weight: 600;
		color: #555;
	}
	.required {
		color: #e53e3e;
		font-weight: bold;
		margin-left: 2px;
	}
	.input-group input,
	.input-group select,
	.input-group textarea {
		padding: 12px 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
		outline: none;
		font-family: var(--font-secondary);
		transition: border-color 0.3s;
		background: #fcfcfc;
	}
	.input-group input:focus,
	.input-group select:focus,
	.input-group textarea:focus {
		border-color: var(--color-primary);
		background: #fff;
	}
	.btn-primary {
		align-self: flex-start;
		padding: 15px 40px;
		margin-top: 10px;
	}

	/* Horizontal Social Media Bar */
	.contact-social-bar {
		background: #fff;
		border-radius: 8px;
		padding: 24px 36px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
	}
	@media (min-width: 900px) {
		.contact-social-bar {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
	.social-bar-heading h3 {
		font-size: 1.2rem;
		color: var(--color-primary);
	}
	.social-bar-icons {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}
	.social-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		color: var(--color-primary);
		text-decoration: none;
		transition: all 0.25s ease;
	}
	.social-icon-btn:hover {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
		transform: translateY(-3px);
		box-shadow: 0 6px 16px rgba(18, 52, 71, 0.15);
	}

	/* Form Success Alert */
	.form-success-alert {
		display: none;
		align-items: flex-start;
		gap: 12px;
		background: #ecfdf5;
		border: 1px solid #a7f3d0;
		color: #065f46;
		padding: 16px 20px;
		border-radius: 6px;
		margin-bottom: 20px;
		animation: fadeIn 0.3s ease;
	}
	.form-success-alert.show {
		display: flex;
	}
	.form-success-alert svg {
		flex-shrink: 0;
		color: #059669;
		margin-top: 2px;
	}
	.form-success-alert strong {
		display: block;
		font-size: 0.95rem;
		margin-bottom: 2px;
		color: #047857;
	}
	.form-success-alert p {
		margin: 0;
		font-size: 0.88rem;
		color: #065f46;
	}

	/* Button Spinner */
	.btn-spinner {
		animation: spin 0.8s linear infinite;
		margin-right: 8px;
	}
	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
