---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="İletişim, Ücretsiz Keşif & Fiyat Teklifi | ZenFlor">
	<Header />
	<PageHero
		title="Bize Ulaşın"
		subtitle="Aklınızdaki projeyi konuşmak için sabırsızlanıyoruz! Bir mesaj atmaya ne dersiniz?

"
	/>

	<section class="contact-page-section">
		<div class="container contact-page-container">
			<!-- Contact Info Cards -->
			<div class="contact-info-cards">
				<a
					href="https://maps.app.goo.gl/cyQwTaXrGfFNJmyTA"
					target="_blank"
					rel="noopener noreferrer"
					class="info-card"
				>
					<div class="icon-circle">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
							></path><circle cx="12" cy="10" r="3"></circle></svg
						>
					</div>
					<h3>Adresimiz</h3>
					<p>
						Leman Sk. No:4,<br />Sancaktepe / İstanbul
					</p>
				</a>

				<a
					href="tel:+905302708487"
					class="info-card"
				>
					<div class="icon-circle">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
							></path></svg
						>
					</div>
					<h3>Telefonumuz</h3>
					<p>+90 (530) 270 84 87</p>
				</a>

				<a
					href="mailto:zenflormarket@gmail.com"
					class="info-card"
				>
					<div class="icon-circle">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
							></path><polyline points="22,6 12,13 2,6"
							></polyline></svg
						>
					</div>
					<h3>E-postamız</h3>
					<p>
						zenflormarket@gmail.com
					</p>
				</a>

				<div class="info-card static-card">
					<div class="icon-circle">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><circle cx="12" cy="12" r="10"></circle><polyline
								points="12 6 12 12 16 14"></polyline></svg
						>
					</div>
					<h3>Çalışma Saatlerimiz</h3>
					<p>
						Pzt - Cmt: 09:00 – 19:00<br /><span class="text-muted"
							>Pazar: Kapalı</span
						>
					</p>
				</div>
			</div>

			<!-- Horizontal Social Media Bar -->
			<div class="contact-social-bar">
				<div class="social-bar-heading">
					<h3>Bizi Takip Edin</h3>
				</div>
				<div class="social-bar-icons">
					<a
						href="https://www.instagram.com/zenflormarket/"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Instagram"
						title="Instagram"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="2"
								width="20"
								height="20"
								rx="5"
								ry="5"></rect><path
								d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
							></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
							></line></svg
						>
					</a>
					<a
						href="https://www.linkedin.com/company/zenflor"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="LinkedIn"
						title="LinkedIn"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
							></path><rect x="2" y="9" width="4" height="12"
							></rect><circle cx="4" cy="4" r="2"></circle></svg
						>
					</a>
					<a
						href="https://facebook.com/people/Zenflor/61592694338862/"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Facebook"
						title="Facebook"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
							></path></svg
						>
					</a>
					<a
						href="https://www.youtube.com/@zenflormarket"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="YouTube"
						title="YouTube"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
							></path><polygon
								points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
								fill="currentColor"></polygon></svg
						>
					</a>
					<a
						href="https://www.tiktok.com/@zenflormarket"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="TikTok"
						title="TikTok"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="currentColor"
							><path
								d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.891 2.887 2.896 2.896 0 0 1-2.891-2.887 2.896 2.896 0 0 1 2.891-2.887c.277 0 .543.04.8.113V9.01a6.347 6.347 0 0 0-.8-.052c-3.535 0-6.4 2.865-6.4 6.4s2.865 6.4 6.4 6.4 6.4-2.865 6.4-6.4V8.307a8.214 8.214 0 0 0 4.806 1.523v-3.144h-.001z"
							></path></svg
						>
					</a>
					<a
						href="https://zenflor.sahibinden.com/"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon-btn"
						aria-label="Sahibinden"
						title="Sahibinden"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="currentColor"
							><path
								d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-4.2 6.2c-.4-.4-1.1-.7-2-.7-.9 0-1.6.3-1.6.9 0 .6.5.7 1.5 1 1.7.5 3.3 1.1 3.3 3 0 1.9-1.6 3.1-3.8 3.1-1.7 0-2.9-.6-3.7-1.4l1.3-1.5c.6.6 1.4 1 2.3 1 1 0 1.7-.4 1.7-1 0-.6-.5-.8-1.5-1.1-1.8-.5-3.3-1.1-3.3-2.9 0-1.8 1.5-3 3.5-3 1.4 0 2.5.4 3.3 1.1l-1.3 1.6z"
							></path></svg
						>
					</a>
				</div>
			</div>

			<!-- Map & Form Section -->
			<div class="map-form-wrapper">
				<!-- Google Map Iframe -->
				<div class="map-container">
					<iframe
						src="https://maps.google.com/maps?q=Leman+Sk.+No:4,+Sancaktepe+İstanbul&t=&z=15&ie=UTF8&iwloc=&output=embed"
						width="100%"
						height="100%"
						style="border:0; min-height: 450px; display: block;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title="Ofis Konumu"
					>
					</iframe>
				</div>

				<!-- Contact Form -->
				<div class="form-container">
					<h2>Bize Ulaşın</h2>

					<form class="page-contact-form" id="contactForm">
						<div
							id="formSuccessMessage"
							class="form-success-alert"
							role="alert"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
								></path><polyline points="22 4 12 14.01 9 11.01"
								></polyline></svg
							>
							<div>
								<strong>Mesajınız başarıyla iletildi!</strong>
								<p>
									En kısa süre içerisinde sizinle iletişime
									geçeceğiz.
								</p>
							</div>
						</div>

						<div class="form-row">
							<div class="input-group">
								<label for="entry_2005620554"
									>Adınız <span class="required">*</span
									></label
								>
								<input
									type="text"
									id="entry_2005620554"
									name="entry.2005620554"
									required
									placeholder="Size nasıl hitap edelim?"
									autocomplete="name"
								/>
							</div>
							<div class="input-group">
								<label for="entry_1166974658"
									>Telefon Numaranız <span class="required"
										>*</span
									></label
								>
								<input
									type="tel"
									id="entry_1166974658"
									name="entry.1166974658"
									required
									placeholder="Size ulaşabileceğimiz telefon"
									autocomplete="tel"
								/>
							</div>
						</div>

						<div class="input-group">
							<label for="entry_839337160"
								>Mesajınız <span class="required">*</span
								></label
							>
							<textarea
								id="entry_839337160"
								name="entry.839337160"
								required
								placeholder="Aklınızdan geçenleri bizimle paylaşın..."
								rows="6"></textarea>
						</div>

						<button type="submit" class="btn-primary" id="submitBtn"
							>Mesajı Gönder</button
						>
					</form>
				</div>
			</div>
		</div>
	</section>

	<script>
		// Google Forms formResponse URL'i
		const GOOGLE_FORM_ACTION_URL = "https://docs.google.com/forms/d/e/1FAIpQLSczeA1IJbeRlC25dY_Mdk83-UWVmHIqcF4aXux-h28dwogWAQ/formResponse";

		const contactForm = document.getElementById(
			"contactForm",
		) as HTMLFormElement | null;
		const successAlert = document.getElementById("formSuccessMessage");
		const submitBtn = document.getElementById(
			"submitBtn",
		) as HTMLButtonElement | null;

		contactForm?.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.innerHTML = `
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-spinner">
						<path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
					</svg>
					Gönderiliyor...
				`;
			}

			try {
				const formData = new FormData(contactForm);

				// Google Forms endpoint'ine no-cors modunda POST isteği gönderimi
				if (GOOGLE_FORM_ACTION_URL && !GOOGLE_FORM_ACTION_URL.includes("FORM_ID_BURAYA")) {
					await fetch(GOOGLE_FORM_ACTION_URL, {
						method: "POST",
						mode: "no-cors",
						body: formData,
					});
				} else {
					// URL henüz girilmediyse kısa bir gecikmeyle simüle et
					await new Promise((resolve) => setTimeout(resolve, 600));
				}

				contactForm.reset();

				if (successAlert) {
					successAlert.classList.add("show");
					successAlert.scrollIntoView({
						behavior: "smooth",
						block: "nearest",
					});

					setTimeout(() => {
						successAlert.classList.remove("show");
					}, 7000);
				}
			} catch (error) {
				console.error("Form gönderim hatası:", error);
				alert("Mesajınız gönderilirken bir hata oluştu. Lütfen doğrudan telefon veya WhatsApp üzerinden bize ulaşın.");
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = "Mesajı Gönder";
				}
			}
		});
	</script>

	<Footer />
</Layout>

<style>
	.contact-page-section {
		padding: 80px 0;
		background: #f4f8fb;
	}
	.contact-page-container {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	/* Info Cards */
	.contact-info-cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
	}
	@media (min-width: 640px) {
		.contact-info-cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.contact-info-cards {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.text-muted {
		color: #888;
		font-size: 0.88rem;
		display: inline-block;
		margin-top: 2px;
	}
	.info-card {
		background: #fff;
		padding: 40px 30px;
		border-radius: 8px;
		text-align: center;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		color: inherit;
	}
	a.info-card {
		cursor: pointer;
	}
	.info-card.static-card {
		cursor: default;
	}
	.info-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 25px rgba(18, 52, 71, 0.09);
	}
	.icon-circle {
		width: 70px;
		height: 70px;
		background: rgba(18, 52, 71, 0.05);
		color: var(--color-primary);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 20px auto;
		transition: background-color 0.3s ease, color 0.3s ease;
	}
	.info-card:hover .icon-circle {
		background: var(--color-primary);
		color: #fff;
	}
	.info-card h3 {
		font-size: 1.3rem;
		margin-bottom: 15px;
		color: var(--color-primary);
	}
	.info-card p {
		color: #666;
		line-height: 1.6;
		font-size: 1rem;
		margin: 0;
	}

	/* Map & Form Wrapper */
	.map-form-wrapper {
		display: flex;
		flex-direction: column;
		background: #fff;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}
	@media (min-width: 1024px) {
		.map-form-wrapper {
			flex-direction: row;
		}
	}
	.map-container {
		flex: 1;
		min-height: 400px;
		background: #eaeaea;
	}
	.map-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: #999;
		gap: 15px;
		background: #e5e9ec;
	}
	.form-container {
		flex: 1;
		padding: 50px;
	}
	@media (max-width: 768px) {
		.form-container {
			padding: 30px 20px;
		}
	}
	.form-container h2 {
		font-size: 2rem;
		margin-bottom: 25px;
		color: var(--color-primary);
	}
	.form-container p {
		color: #666;
		margin-bottom: 30px;
		line-height: 1.6;
	}

	/* Form Elements */
	.page-contact-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.form-row {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	@media (min-width: 640px) {
		.form-row {
			flex-direction: row;
		}
	}
	.input-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}
	.input-group label {
		font-size: 0.9rem;
		font-weight: 600;
		color: #555;
	}
	.required {
		color: #e53e3e;
		font-weight: bold;
		margin-left: 2px;
	}
	.input-group input,
	.input-group select,
	.input-group textarea {
		padding: 12px 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
		outline: none;
		font-family: var(--font-secondary);
		transition: border-color 0.3s;
		background: #fcfcfc;
	}
	.input-group input:focus,
	.input-group select:focus,
	.input-group textarea:focus {
		border-color: var(--color-primary);
		background: #fff;
	}
	.btn-primary {
		align-self: flex-start;
		padding: 15px 40px;
		margin-top: 10px;
	}

	/* Horizontal Social Media Bar */
	.contact-social-bar {
		background: #fff;
		border-radius: 8px;
		padding: 24px 36px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
	}
	@media (min-width: 900px) {
		.contact-social-bar {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
	.social-bar-heading h3 {
		font-size: 1.2rem;
		color: var(--color-primary);
	}
	.social-bar-icons {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}
	.social-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		color: var(--color-primary);
		text-decoration: none;
		transition: all 0.25s ease;
	}
	.social-icon-btn:hover {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
		transform: translateY(-3px);
		box-shadow: 0 6px 16px rgba(18, 52, 71, 0.15);
	}

	/* Form Success Alert */
	.form-success-alert {
		display: none;
		align-items: flex-start;
		gap: 12px;
		background: #ecfdf5;
		border: 1px solid #a7f3d0;
		color: #065f46;
		padding: 16px 20px;
		border-radius: 6px;
		margin-bottom: 20px;
		animation: fadeIn 0.3s ease;
	}
	.form-success-alert.show {
		display: flex;
	}
	.form-success-alert svg {
		flex-shrink: 0;
		color: #059669;
