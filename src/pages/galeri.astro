---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { galleryImages } from "../data/gallery";
---

<Layout
	title="Uygulama Galerisi | Kaliteli ve Uygun Parke Projeleri"
	description="Türkiye genelinde başarıyla tamamladığımız parke döşeme ve zemin kaplama uygulama fotoğraflarını inceleyin."
	keywords="parke galerisi, parke uygulama galerisi, sancaktepe parke uygulamaları, sarıgazi zemin kaplama, istanbul parke projeleri, laminat parke fotoğrafları"
	image="/images/uygulama-galerisi/uygulama-galerisi-1.webp"
>
	<PageHero
		title="Uygulama Galerisi"
		subtitle="Ev, ofis ve ticari projelerde başarıyla tamamladığımız parke zemin uygulamalarımız."
	/>

	<!-- UYGULAMA GALERİSİ GÖRSELLERİ -->
	<section class="gallery-section">
		<div class="container">
			<!-- Galeri Grid (3 Sütunlu Dengeli Izgara) -->
			<div class="gallery-grid">
				{
					galleryImages.map((item) => (
						<div class="gallery-card" data-img={item.img}>
							<img
								src={item.img}
								alt={item.alt}
								width="800"
								height="600"
								loading="lazy"
								decoding="async"
							/>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Lightbox Modal -->
	<div
		class="lightbox-modal"
		id="lightboxModal"
		role="dialog"
		aria-modal="true"
		aria-label="Görsel Büyütme Modalı"
	>
		<div class="lightbox-backdrop" id="lightboxBackdrop"></div>
		<div class="lightbox-container">
			<button
				class="lightbox-close"
				id="lightboxClose"
				aria-label="Kapat"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="22"
					height="22"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			<div class="lightbox-content">
				<img id="lightboxImage" src="" alt="Proje Görseli" />
			</div>
		</div>
	</div>
</Layout>

<script>
	// Lightbox Modal İşlevleri
	const modal = document.getElementById("lightboxModal");
	const modalImg = document.getElementById(
		"lightboxImage",
	) as HTMLImageElement;
	const closeBtn = document.getElementById("lightboxClose");
	const backdrop = document.getElementById("lightboxBackdrop");
	const galleryCards =
		document.querySelectorAll<HTMLElement>(".gallery-card");

	galleryCards.forEach((card) => {
		card.addEventListener("click", () => {
			const imgUrl = card.getAttribute("data-img") || "";
			const imgElement = card.querySelector("img");
			const altText = imgElement
				? imgElement.getAttribute("alt")
				: "Proje Görseli";

			if (modalImg && modal) {
				modalImg.src = imgUrl;
				modalImg.alt = altText || "Proje Görseli";
				modal.classList.add("active");
				document.body.style.overflow = "hidden";
			}
		});
	});

	const closeModal = () => {
		if (modal) {
			modal.classList.remove("active");
			document.body.style.overflow = "";
		}
	};

	closeBtn?.addEventListener("click", closeModal);
	backdrop?.addEventListener("click", closeModal);

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && modal?.classList.contains("active")) {
			closeModal();
		}
	});
</script>

<style>
	/* =========================================
	   GALLERY SECTION
	   ========================================= */
	.gallery-section {
		padding: 55px 0 85px 0;
		background: #ffffff;
	}

	/* =========================================
	   GALLERY GRID — Responsive Breakpoints
	   Desktop:  4 sütun (≥1200px)
	   Tablet-L: 3 sütun (≥768px)
	   Tablet-P: 2 sütun (≥480px)
	   Mobile:   2 sütun (≥360px) / 1 sütun (<360px)
	   ========================================= */
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	@media (max-width: 1199px) {
		.gallery-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 18px;
		}
	}

	@media (max-width: 767px) {
		.gallery-section {
			padding: 30px 0 55px 0;
		}
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}
	}

	@media (max-width: 359px) {
		.gallery-grid {
			grid-template-columns: 1fr;
			gap: 10px;
		}
	}

	/* =========================================
	   GALLERY CARD
	   ========================================= */
	.gallery-card {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		background: #edf2f7;
		border: 1px solid #e8edf2;
		cursor: pointer;
		aspect-ratio: 4/3;
		box-shadow: var(--shadow-sm);
		transition:
			transform 0.35s ease,
			box-shadow 0.35s ease,
			border-color 0.35s ease;
		-webkit-tap-highlight-color: transparent;
	}

	.gallery-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--color-secondary);
	}

	/* Mobilde kart hover kaldır (dokunma için) */
	@media (hover: none) {
		.gallery-card:hover {
			transform: none;
			box-shadow: var(--shadow-sm);
			border-color: #e8edf2;
		}
	}

	.gallery-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
		pointer-events: none;
	}

	.gallery-card:hover img {
		transform: scale(1.06);
	}

	@media (hover: none) {
		.gallery-card:hover img {
			transform: none;
		}
	}

	/* =========================================
	   LIGHTBOX MODAL
	   ========================================= */
	.lightbox-modal {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 16px;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.25s ease,
			visibility 0.25s ease;
	}

	.lightbox-modal.active {
		opacity: 1;
		visibility: visible;
	}

	.lightbox-backdrop {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(15, 25, 34, 0.92);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.lightbox-container {
		position: relative;
		z-index: 1;
		max-width: min(92vw, 960px);
		max-height: 92vh;
		width: fit-content;
		background: #ffffff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
	}

	.lightbox-close {
		position: absolute;
		top: 10px;
		right: 10px;
		background: rgba(0, 0, 0, 0.65);
		color: #ffffff;
		border: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 2;
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}

	.lightbox-close:hover {
		background: rgba(0, 0, 0, 0.95);
		transform: scale(1.08);
	}

	.lightbox-content {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox-content img {
		max-width: 100%;
		max-height: 88vh;
		width: auto;
		height: auto;
		object-fit: contain;
		display: block;
		margin: 0 auto;
	}

	/* =========================================
	   MOBİL LIGHTBOX OPTİMİZASYONU
	   ========================================= */
	@media (max-width: 767px) {
		.lightbox-modal {
			padding: 10px;
			align-items: center;
		}
		.lightbox-container {
			max-width: 100%;
			max-height: 88vh;
			border-radius: 10px;
		}
		.lightbox-content img {
			max-height: 80vh;
		}
		.lightbox-close {
			width: 44px;
			height: 44px;
			top: 8px;
			right: 8px;
		}
	}
</style>
