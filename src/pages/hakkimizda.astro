---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Biz Kimiz? - ZenFlor Parke Çözümleri">
	<Header />
	<PageHero title="Biz Kimiz?" subtitle="Bizi daha yakından tanıyın. Kalite ve estetiği zeminlerinizle buluşturuyoruz." />
	
	<!-- Vision & Mission Section -->
	<section class="vision-section">
		<div class="container vision-container">
			<div class="vision-text">
				<span class="subtitle">VİZYONUMUZ & MİSYONUMUZ</span>
				<h2>Yaşam Alanlarınızı Doğanın Sıcaklığıyla Buluşturuyoruz</h2>
				<p>ZenFlor olarak en kaliteli ahşap ve parke malzemelerini işleyerek, modern ve dayanıklı zemin çözümleri sunuyoruz. Amacımız sadece zemin kaplamak değil, aynı zamanda estetik, dayanıklılık ve sürdürülebilirliği bir araya getirerek zamana meydan okuyan mekanlar yaratmaktır.</p>
				<p>Sürdürülebilir orman yönetimini destekliyor, çevreye duyarlı üretim süreçleriyle geleceğe değer katıyoruz.</p>
			</div>
			<div class="vision-image">
				<img src="/images/about-3.jpg" alt="ZenFlor Vizyon" />
				<div class="experience-badge">
					<strong>20+</strong>
					<span>Yıllık<br/>Tecrübe</span>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.subtitle {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-secondary);
		letter-spacing: 2px;
		text-transform: uppercase;
		display: block;
		margin-bottom: 1rem;
	}
	
	/* Vision Section */
	.vision-section {
		padding: 100px 0;
		background: #fff;
	}
	.vision-container {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}
	@media (min-width: 1024px) {
		.vision-container {
			flex-direction: row;
			align-items: center;
		}
	}
	.vision-text {
		flex: 1;
	}
	.vision-text h2 {
		font-size: 2.5rem;
		line-height: 1.2;
		margin-bottom: 2rem;
	}
	.vision-text p {
		color: #666;
		font-size: 1.05rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}
	.vision-image {
		flex: 1;
		position: relative;
	}
	.vision-image img {
		width: 100%;
		border-radius: 8px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.1);
	}
	.experience-badge {
		position: absolute;
		bottom: -30px;
		left: -30px;
		background: var(--color-primary);
		color: #fff;
		padding: 30px;
		border-radius: 50%;
		width: 140px;
		height: 140px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		box-shadow: 0 10px 20px rgba(18, 52, 71, 0.3);
	}
	.experience-badge strong {
		font-size: 2.5rem;
		font-family: var(--font-primary);
		line-height: 1;
	}
	.experience-badge span {
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		margin-top: 5px;
	}
</style>
