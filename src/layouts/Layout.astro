---
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="ZenFlor Parke - Yaşam alanlarınıza değer katan modern, estetik ve dayanıklı lamine, laminat ve masif parke zemin çözümleri." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<FloatingContact />
		<ScrollToTop />
	</body>
</html>
