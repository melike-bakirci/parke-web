---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
	title: string;
	description?: string;
	showHeader?: boolean;
	showFooter?: boolean;
	showCta?: boolean;
	ctaTitle?: string;
	ctaDescription?: string;
	ctaWhatsappMsg?: string;
	ctaPhoneText?: string;
}

const {
	title,
	description = "ZenFlor Parke - Yaşam alanlarınıza değer katan modern, estetik ve dayanıklı lamine, laminat ve masif parke zemin çözümleri.",
	showHeader = true,
	showFooter = true,
	showCta = true,
	ctaTitle,
	ctaDescription,
	ctaWhatsappMsg,
	ctaPhoneText,
} = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		{showHeader && <Header />}
		<slot />
		{
			showFooter && (
				<Footer
					showCta={showCta}
					ctaTitle={ctaTitle}
					ctaDescription={ctaDescription}
					ctaWhatsappMsg={ctaWhatsappMsg}
					ctaPhoneText={ctaPhoneText}
				/>
			)
		}
		<FloatingContact />
		<ScrollToTop />
	</body>
</html>
