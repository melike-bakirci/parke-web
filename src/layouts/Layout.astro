---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { siteInfo } from '../data/siteInfo';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonicalURL?: string;
	type?: string;
	robots?: string;
	showHeader?: boolean;
	showFooter?: boolean;
	showCta?: boolean;
	ctaTitle?: string;
	ctaDescription?: string;
	ctaWhatsappMsg?: string;
	ctaPhoneText?: string;
	schema?: any;
}

const {
	title,
	description = siteInfo.description,
	keywords = siteInfo.defaultKeywords,
	image = "/images/hero-bg.webp", // Default OG image
	canonicalURL = new URL(Astro.url.pathname, siteInfo.url).href,
	type = "website",
	robots = "index, follow",
	showHeader = true,
	showFooter = true,
	showCta = true,
	ctaTitle,
	ctaDescription,
	ctaWhatsappMsg,
	ctaPhoneText,
} = Astro.props;

const pageTitle = title.includes(siteInfo.name)
	? title
	: `${title} | ${siteInfo.name}`;

const schemaData = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"name": siteInfo.name,
	"image": new URL("/images/hero-bg.webp", siteInfo.url).href,
	"@id": siteInfo.url,
	"url": siteInfo.url,
	"telephone": siteInfo.contact.phone.raw,
	"priceRange": "₺₺",
	"hasMap": siteInfo.contact.address.mapsUrl,
	"sameAs": [
		siteInfo.contact.address.mapsUrl,
		siteInfo.social.instagram,
		siteInfo.social.facebook,
		siteInfo.social.linkedin,
		siteInfo.social.youtube,
		siteInfo.social.tiktok,
		siteInfo.social.sahibinden
	],
	"address": {
		"@type": "PostalAddress",
		"streetAddress": siteInfo.contact.address.street,
		"addressLocality": siteInfo.contact.address.district,
		"addressRegion": siteInfo.contact.address.city,
		"addressCountry": "TR"
	},
	"openingHoursSpecification": {
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday"
		],
		"opens": "09:00",
		"closes": "19:00"
	}
};

const finalSchema = Astro.props.schema || schemaData;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" href="/zenparke-logo.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#8C6A53" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content={robots} />
		
		<!-- Google Search Console -->
		<meta name="google-site-verification" content="NPsb6XH8U2d9DXOVUxDBaOw7Ll5zujq5KW0-yH8u3Kw" />

		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, siteInfo.url).href} />
		<meta property="og:image:secure_url" content={new URL(image, siteInfo.url).href} />
		<meta property="og:image:alt" content={pageTitle} />
		<meta property="og:site_name" content={siteInfo.name} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, siteInfo.url).href} />
		<meta name="twitter:image:alt" content={pageTitle} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
		
		<!-- JSON-LD Structured Data (Google İşletmeler & Yerel SEO) -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

		<!-- Microsoft Clarity (Isı Haritası & Davranış Analizi) -->
		{siteInfo.analytics.microsoftClarityId && (
			<script is:inline define:vars={{ clarityId: siteInfo.analytics.microsoftClarityId }}>
				(function(c,l,a,r,i,t,y){
					c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
					t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
					y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
				})(window, document, "clarity", "script", clarityId);
			</script>
		)}
	</head>
	<body>
		{showHeader && <Header />}
		<slot />
		{
			showFooter && (
				<Footer
					showCta={showCta}
					ctaTitle={ctaTitle}
					ctaDescription={ctaDescription}
					ctaWhatsappMsg={ctaWhatsappMsg}
					ctaPhoneText={ctaPhoneText}
				/>
			)
		}
		<ScrollToTop />
	</body>
</html>
